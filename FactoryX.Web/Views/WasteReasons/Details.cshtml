@model FactoryX.Application.DTOs.WasteReasonDto

@{
    ViewData["Title"] = "تفاصيل سبب الهالك - " + Model.Code;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-right"></i>
            </a>
            <div>
                <h2 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-tag me-2"></i> سبب الهالك: @Model.Code
                </h2>
                <small class="text-muted">@Model.Reason</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i> تعديل
            </a>
            <a asp-controller="Waste" asp-action="Index" asp-route-reasonId="@Model.Id" class="btn btn-primary">
                <i class="bi bi-list-check me-1"></i> عرض سجلات الهالك المرتبطة (@Model.WastesCount)
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">البيانات الأساسية</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small d-block">كود السبب</label>
                            <span class="badge bg-light text-primary border font-monospace fs-6">@Model.Code</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small d-block">الحالة</label>
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">نشط ومتاح للاختيار</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">معطل</span>
                            }
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">عنوان / اسم السبب</label>
                            <div class="fs-5 fw-bold text-dark">@Model.Reason</div>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">الوصف التفصيلي</label>
                            <div class="p-3 bg-light rounded-3 text-secondary">
                                @(string.IsNullOrEmpty(Model.Description) ? "لا يوجد وصف إضافي مسجل." : Model.Description)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">إحصائيات الاستخدام</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                            <i class="bi bi-journal-x fs-4"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold text-dark">@Model.WastesCount</div>
                            <small class="text-muted">سجل هالك مرتبط بهذا السبب</small>
                        </div>
                    </div>

                    <div class="border-top pt-3 text-muted small">
                        <div class="d-flex justify-content-between mb-1">
                            <span>تاريخ الإنشاء:</span>
                            <span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>آخر تحديث:</span>
                            <span>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
