@model FactoryX.Application.DTOs.JournalEntryDto
@{
    Layout = null;
    ViewData["Title"] = $"سند قيد محاسبي - {Model.JournalNumber}";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #fff;
            color: #222;
            padding: 20px;
        }
        .font-monospace {
            font-family: 'JetBrains Mono', monospace !important;
        }
        .voucher-header {
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .signature-box {
            border-top: 1px dashed #666;
            margin-top: 60px;
            padding-top: 10px;
            text-align: center;
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
            }
            .card {
                border: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="container my-3">
        <div class="no-print text-end mb-4">
            <button onclick="window.print()" class="btn btn-primary px-4">
                <i class="bi bi-printer"></i> طباعة السند (Print)
            </button>
            <button onclick="window.close()" class="btn btn-secondary ms-2">إغلاق</button>
        </div>

        <div class="voucher-header">
            <div class="row align-items-center">
                <div class="col-8">
                    <h3 class="fw-bold mb-1">مصنع حلويات المولد النبوي الشريف</h3>
                    <h5 class="text-muted mb-0">سند قيد يومية عامة (Journal Voucher)</h5>
                </div>
                <div class="col-4 text-end">
                    <h4 class="font-monospace fw-bold text-primary mb-1">@Model.JournalNumber</h4>
                    <div class="small text-muted">التاريخ: @Model.EntryDate.ToString("yyyy/MM/dd")</div>
                    <div class="small text-muted">الفترة: @Model.PeriodName</div>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-8">
                <strong>البيان / الشرح:</strong> @Model.Description
            </div>
            <div class="col-4 text-end">
                <strong>مصدر القيد:</strong> @Model.ReferenceTypeName
                @if (!string.IsNullOrEmpty(Model.ReferenceDocumentNumber))
                {
                    <span class="font-monospace">(@Model.ReferenceDocumentNumber)</span>
                }
            </div>
        </div>

        <table class="table table-bordered border-dark align-middle mb-4">
            <thead class="table-light border-dark">
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 15%;">رمز الحساب</th>
                    <th style="width: 30%;">اسم الحساب المالي</th>
                    <th style="width: 26%;">البيان التفصيلي</th>
                    <th style="width: 12%;" class="text-end">مدين (Debit)</th>
                    <th style="width: 12%;" class="text-end">دائن (Credit)</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="text-center">@i</td>
                        <td class="font-monospace fw-bold">@line.AccountCode</td>
                        <td>
                            <div class="fw-bold">@line.AccountNameAr</div>
                            <div class="small text-muted">@line.AccountName</div>
                        </td>
                        <td>
                            @(line.Description ?? Model.Description)
                            @if (!string.IsNullOrEmpty(line.CustomerName)) { <div class="small">العميل: @line.CustomerName</div> }
                            @if (!string.IsNullOrEmpty(line.SupplierName)) { <div class="small">المورد: @line.SupplierName</div> }
                        </td>
                        <td class="text-end font-monospace fw-bold">
                            @(line.Debit > 0 ? line.Debit.ToString("N2") : "-")
                        </td>
                        <td class="text-end font-monospace fw-bold">
                            @(line.Credit > 0 ? line.Credit.ToString("N2") : "-")
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
            <tfoot class="border-dark fw-bold font-monospace table-light">
                <tr>
                    <td colspan="4" class="text-end">الإجمالي العام (EGP):</td>
                    <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                    <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>

        <div class="row mt-5">
            <div class="col-4">
                <div class="signature-box">
                    <strong>إعداد المحاسب</strong>
                    <div class="small text-muted">@(Model.CreatedByName ?? "المسؤول")</div>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>المراجعة والتدقيق</strong>
                    <div class="small text-muted">رئيس الحسابات</div>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>الاعتماد والترحيل</strong>
                    <div class="small text-muted">@(Model.PostedByName ?? "المدير المالي")</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
