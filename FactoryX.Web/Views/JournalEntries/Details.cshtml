@model FactoryX.Application.DTOs.JournalEntryDto
@{
    ViewData["Title"] = $"تفاصيل القيد المحاسبي: {Model.JournalNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">قيد اليومية: <span class="font-monospace text-primary">@Model.JournalNumber</span></h2>
            @if (Model.Status == FactoryX.Domain.Entities.JournalEntryStatus.Posted)
            {
                <span class="badge bg-success-subtle text-success fs-6">مرحل (Posted)</span>
            }
            else if (Model.Status == FactoryX.Domain.Entities.JournalEntryStatus.Reversed)
            {
                <span class="badge bg-danger-subtle text-danger fs-6">معكوس (Reversed)</span>
            }
        </div>
        <p class="text-muted mb-0">الفترة المالية: <strong>@Model.PeriodName</strong> | التاريخ: <strong>@Model.EntryDate.ToString("yyyy-MM-dd")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>العودة لليومية
        </a>
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>طباعة سند القيد
        </a>
        @if (Model.Status == FactoryX.Domain.Entities.JournalEntryStatus.Posted)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reverseModal">
                <i class="bi bi-arrow-counterclockwise me-1"></i>عكس القيد (Reversal)
            </button>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Status == FactoryX.Domain.Entities.JournalEntryStatus.Reversed)
{
    <div class="alert alert-warning mb-4">
        <div class="fw-bold"><i class="bi bi-exclamation-circle-fill me-2"></i>تم إلغاء وعكس هذا القيد بقيد تسوية عكسي:</div>
        <div class="mt-1">السبب: <em>@Model.ReversalReason</em></div>
    </div>
}

@if (Model.ReversalOfJournalEntryId.HasValue)
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle-fill me-2"></i>
        هذا القيد هو قيد عكسي للقيد رقم: 
        <a asp-action="Details" asp-route-id="@Model.ReversalOfJournalEntryId.Value" class="fw-bold text-decoration-none">
            @Model.ReversalOfJournalNumber
        </a>
        - السبب: @Model.ReversalReason
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>بيانات القيد</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">البيان والشرح</label>
                        <span class="fw-semibold">@Model.Description</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">مصدر القيد</label>
                        <span class="badge bg-secondary-subtle text-dark border">@Model.ReferenceTypeName</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">رقم المستند المرجعي</label>
                        <span class="font-monospace">@(Model.ReferenceDocumentNumber ?? "-")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">المستخدم المنشئ / المرحل</label>
                        <span>@(Model.PostedByName ?? Model.CreatedByName ?? "المسؤول") (@(Model.PostedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-"))</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-header bg-transparent py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calculator text-primary me-2"></i>ملخص التوازن المالي</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">إجمالي المدين:</span>
                    <span class="font-monospace fw-bold text-success fs-5">@Model.TotalDebit.ToString("N2") EGP</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">إجمالي الدائن:</span>
                    <span class="font-monospace fw-bold text-danger fs-5">@Model.TotalCredit.ToString("N2") EGP</span>
                </div>
                <div class="d-flex justify-content-between pt-2 border-top">
                    <span class="fw-bold">حالة القيد:</span>
                    <span class="badge bg-success">متوازن (Balanced)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lines Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold"><i class="bi bi-list-check text-primary me-2"></i>بنود وأطراف القيد المحاسبي</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>رمز الحساب</th>
                        <th>اسم الحساب</th>
                        <th>بيان البند</th>
                        <th>الارتباط الفرعي</th>
                        <th class="text-end">مدين (Debit)</th>
                        <th class="text-end pe-3">دائن (Credit)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td class="ps-3 text-muted">@idx</td>
                            <td class="font-monospace fw-bold">@line.AccountCode</td>
                            <td>
                                <a asp-controller="GeneralLedger" asp-action="Index" asp-route-AccountId="@line.AccountId" class="text-decoration-none fw-semibold">
                                    @line.AccountNameAr
                                </a>
                                <div class="text-muted small">@line.AccountName</div>
                            </td>
                            <td>@(line.Description ?? Model.Description)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(line.CustomerName))
                                {
                                    <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-person me-1"></i>@line.CustomerName</span>
                                }
                                @if (!string.IsNullOrEmpty(line.SupplierName))
                                {
                                    <span class="badge bg-warning-subtle text-dark border"><i class="bi bi-truck me-1"></i>@line.SupplierName</span>
                                }
                                @if (!string.IsNullOrEmpty(line.ProductName))
                                {
                                    <span class="badge bg-info-subtle text-dark border"><i class="bi bi-box-seam me-1"></i>@line.ProductName</span>
                                }
                                @if (!string.IsNullOrEmpty(line.MaterialName))
                                {
                                    <span class="badge bg-secondary-subtle text-dark border"><i class="bi bi-egg me-1"></i>@line.MaterialName</span>
                                }
                            </td>
                            <td class="text-end font-monospace fw-bold @(line.Debit > 0 ? "text-success" : "text-muted")">
                                @(line.Debit > 0 ? line.Debit.ToString("N2") : "-")
                            </td>
                            <td class="text-end font-monospace fw-bold pe-3 @(line.Credit > 0 ? "text-danger" : "text-muted")">
                                @(line.Credit > 0 ? line.Credit.ToString("N2") : "-")
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
                <tfoot class="table-light fw-bold font-monospace">
                    <tr>
                        <td colspan="5" class="text-end ps-3">الإجمالي العام:</td>
                        <td class="text-end text-success fs-6">@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end text-danger fs-6 pe-3">@Model.TotalCredit.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- Reversal Modal -->
<div class="modal fade" id="reverseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reverse" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="JournalEntryId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-arrow-counterclockwise me-2"></i>عكس وإلغاء القيد: @Model.JournalNumber</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <p>هل أنت متأكد من رغبتك في عكس هذا القيد؟</p>
                    <div class="alert alert-warning small">
                        سيقوم النظام بإنشاء قيد يومية جديد يعكس أطراف المدين والدائن ويغير حالة هذا القيد إلى (معكوس).
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">سبب عكس القيد <span class="text-danger">*</span></label>
                        <input type="text" name="Reason" class="form-control" placeholder="مثال: تصحيح خطأ في التوجيه أو إلغاء تسوية" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger">تأكيد عكس القيد</button>
                </div>
            </form>
        </div>
    </div>
</div>
