@model FactoryX.Application.DTOs.JournalEntryCreateDto
@{
    ViewData["Title"] = "إنشاء قيد محاسبي يدوي جديد";
    var accounts = ViewBag.Accounts as IEnumerable<FactoryX.Application.DTOs.AccountDto> ?? new List<FactoryX.Application.DTOs.AccountDto>();
    var customers = ViewBag.Customers as IEnumerable<FactoryX.Application.DTOs.CustomerDto> ?? new List<FactoryX.Application.DTOs.CustomerDto>();
    var suppliers = ViewBag.Suppliers as IEnumerable<FactoryX.Application.DTOs.SupplierDto> ?? new List<FactoryX.Application.DTOs.SupplierDto>();
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle-fill text-primary me-2"></i>إنشاء قيد محاسبي يدوي جديد (Manual Journal Entry)</h5>
                        <small class="text-muted">نظام القيد المزدوج: يجب أن يتطابق إجمالي المدين مع إجمالي الدائن تماماً</small>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-right me-1"></i>العودة لليومية
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="journalForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Header Information -->
                    <div class="row g-3 mb-4 p-3 bg-light rounded-3">
                        <div class="col-md-4">
                            <label asp-for="EntryDate" class="form-label fw-bold">تاريخ القيد <span class="text-danger">*</span></label>
                            <input asp-for="EntryDate" type="date" class="form-control" required />
                            <span asp-validation-for="EntryDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ReferenceDocumentNumber" class="form-label fw-bold">رقم المستند المرجعي (إن وجد)</label>
                            <input asp-for="ReferenceDocumentNumber" class="form-control font-monospace" placeholder="مثال: تسوية-2026/09" />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-bold">البيان / شرح القيد <span class="text-danger">*</span></label>
                            <input asp-for="Description" class="form-control" placeholder="شرح تفصيلي لسبب وطبيعة القيد المحاسبي" required />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Lines Table -->
                    <h6 class="fw-bold mb-3"><i class="bi bi-list-columns-reverse text-secondary me-2"></i>أطراف وبنود القيد المحاسبي</h6>
                    
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered align-middle" id="linesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 32%;">الحساب المالي <span class="text-danger">*</span></th>
                                    <th style="width: 14%;" class="text-center">مدين (Debit)</th>
                                    <th style="width: 14%;" class="text-center">دائن (Credit)</th>
                                    <th style="width: 20%;">بيان البند</th>
                                    <th style="width: 15%;">العميل / المورد</th>
                                    <th style="width: 5%;" class="text-center">حذف</th>
                                </tr>
                            </thead>
                            <tbody id="linesContainer">
                                @for (int i = 0; i < Model.Lines.Count; i++)
                                {
                                    <tr class="line-row">
                                        <td>
                                            <select name="Lines[@i].AccountId" class="form-select select-account" required>
                                                <option value="">-- اختر الحساب --</option>
                                                @foreach (var acc in accounts)
                                                {
                                                    <option value="@acc.Id" selected="@(acc.Id == Model.Lines[i].AccountId)">
                                                        @acc.AccountCode - @acc.AccountNameAr (@acc.AccountTypeName)
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" min="0" name="Lines[@i].Debit" value="@Model.Lines[i].Debit" class="form-control font-monospace text-end input-debit" oninput="onDebitChange(this)" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" min="0" name="Lines[@i].Credit" value="@Model.Lines[i].Credit" class="form-control font-monospace text-end input-credit" oninput="onCreditChange(this)" />
                                        </td>
                                        <td>
                                            <input type="text" name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" placeholder="شرح البند" />
                                        </td>
                                        <td>
                                            <select name="Lines[@i].CustomerId" class="form-select form-select-sm mb-1">
                                                <option value="">-- عميل --</option>
                                                @foreach (var c in customers)
                                                {
                                                    <option value="@c.Id" selected="@(c.Id == Model.Lines[i].CustomerId)">@c.Code - @c.Name</option>
                                                }
                                            </select>
                                            <select name="Lines[@i].SupplierId" class="form-select form-select-sm">
                                                <option value="">-- مورد --</option>
                                                @foreach (var s in suppliers)
                                                {
                                                    <option value="@s.Id" selected="@(s.Id == Model.Lines[i].SupplierId)">@s.Code - @s.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold font-monospace">
                                <tr>
                                    <td class="text-end">الإجمالي:</td>
                                    <td class="text-end text-success" id="lblTotalDebit">0.00</td>
                                    <td class="text-end text-danger" id="lblTotalCredit">0.00</td>
                                    <td colspan="3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span>الفرق (Balance Diff): <span id="lblDiff" class="text-danger">0.00</span></span>
                                            <span id="badgeBalance" class="badge bg-danger">غير متوازن</span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="addRow()">
                            <i class="bi bi-plus-lg me-1"></i>إضافة طرف / سطر جديد
                        </button>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">إلغاء</a>
                        <button type="submit" id="btnSubmit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i>ترحيل القيد المحاسبي</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const accountsOptions = `@foreach (var acc in accounts) { <option value="@acc.Id">@acc.AccountCode - @acc.AccountNameAr (@acc.AccountTypeName)</option> }`;
    const customersOptions = `@foreach (var c in customers) { <option value="@c.Id">@c.Code - @c.Name</option> }`;
    const suppliersOptions = `@foreach (var s in suppliers) { <option value="@s.Id">@s.Code - @s.Name</option> }`;

    function onDebitChange(input) {
        var row = input.closest('tr');
        var creditInput = row.querySelector('.input-credit');
        if (parseFloat(input.value) > 0) {
            creditInput.value = 0;
        }
        calculateTotals();
    }

    function onCreditChange(input) {
        var row = input.closest('tr');
        var debitInput = row.querySelector('.input-debit');
        if (parseFloat(input.value) > 0) {
            debitInput.value = 0;
        }
        calculateTotals();
    }

    function calculateTotals() {
        var totalDebit = 0;
        var totalCredit = 0;

        document.querySelectorAll('.line-row').forEach(row => {
            var d = parseFloat(row.querySelector('.input-debit')?.value || 0);
            var c = parseFloat(row.querySelector('.input-credit')?.value || 0);
            if (!isNaN(d)) totalDebit += d;
            if (!isNaN(c)) totalCredit += c;
        });

        document.getElementById('lblTotalDebit').innerText = totalDebit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('lblTotalCredit').innerText = totalCredit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        var diff = Math.abs(totalDebit - totalCredit);
        document.getElementById('lblDiff').innerText = diff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        var badge = document.getElementById('badgeBalance');
        var btn = document.getElementById('btnSubmit');

        if (totalDebit > 0 && diff < 0.01) {
            badge.className = 'badge bg-success';
            badge.innerText = 'القيد متوازن';
            btn.disabled = false;
        } else {
            badge.className = 'badge bg-danger';
            badge.innerText = 'القيد غير متوازن';
        }
    }

    function addRow() {
        var container = document.getElementById('linesContainer');
        var idx = container.querySelectorAll('.line-row').length;

        var tr = document.createElement('tr');
        tr.className = 'line-row';
        tr.innerHTML = `
            <td>
                <select name="Lines[\${idx}].AccountId" class="form-select select-account" required>
                    <option value="">-- اختر الحساب --</option>
                    \${accountsOptions}
                </select>
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="Lines[\${idx}].Debit" value="0" class="form-control font-monospace text-end input-debit" oninput="onDebitChange(this)" />
            </td>
            <td>
                <input type="number" step="0.01" min="0" name="Lines[\${idx}].Credit" value="0" class="form-control font-monospace text-end input-credit" oninput="onCreditChange(this)" />
            </td>
            <td>
                <input type="text" name="Lines[\${idx}].Description" class="form-control" placeholder="شرح البند" />
            </td>
            <td>
                <select name="Lines[\${idx}].CustomerId" class="form-select form-select-sm mb-1">
                    <option value="">-- عميل --</option>
                    \${customersOptions}
                </select>
                <select name="Lines[\${idx}].SupplierId" class="form-select form-select-sm">
                    <option value="">-- مورد --</option>
                    \${suppliersOptions}
                </select>
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        container.appendChild(tr);
        calculateTotals();
    }

    function removeRow(btn) {
        var rows = document.querySelectorAll('.line-row');
        if (rows.length <= 2) {
            alert('يجب الإبقاء على سطرين على الأقل للقيد.');
            return;
        }
        btn.closest('tr').remove();
        reindexRows();
        calculateTotals();
    }

    function reindexRows() {
        document.querySelectorAll('.line-row').forEach((row, idx) => {
            row.querySelectorAll('[name]').forEach(input => {
                var name = input.getAttribute('name');
                input.setAttribute('name', name.replace(/Lines\[\d+\]/, `Lines[\${idx}]`));
            });
        });
    }

    document.addEventListener('DOMContentLoaded', calculateTotals);
</script>
