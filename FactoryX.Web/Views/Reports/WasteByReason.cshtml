@model FactoryX.Application.DTOs.WasteReasonReportDto
@{
    ViewData["Title"] = "تقرير أسباب وتصنيفات الهالك في المصنع";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill text-danger me-2"></i>تقرير أسباب الهالك (Waste by Reason)</h2>
        <p class="text-muted mb-0">تحليل الأسباب الجذرية للهالك والتوالف وعدد مرات التكرار والخسارة المادية لكل سبب</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">سبب الهالك</th>
                        <th class="text-center">عدد الإذونات</th>
                        <th class="text-end">إجمالي الكمية</th>
                        <th class="text-end pe-3">إجمالي التكلفة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.WasteReasons.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">لا يوجد هالك مسجل</td>
                        </tr>
                    }
                    @foreach (var r in Model.WasteReasons)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@r.ReasonDescription</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@r.Count</span></td>
                            <td class="text-end font-monospace">@r.Quantity.ToString("N2") KG</td>
                            <td class="text-end font-monospace pe-3 fw-bold text-danger">@r.Cost.ToString("N2") EGP</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
