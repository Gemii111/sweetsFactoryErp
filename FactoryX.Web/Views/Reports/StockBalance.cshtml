@model FactoryX.Application.DTOs.StockBalanceReportDto
@{
    ViewData["Title"] = "تقرير أرصدة المستودعات والمواقع";
    ViewData["ShowWarehouseFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-boxes text-success me-2"></i>تقرير أرصدة المستودعات والمواقع (Stock Balance)</h2>
        <p class="text-muted mb-0">عرض تفصيلي لأرصدة الخامات والإنتاج التام والمتاح والمحجوز وحالات المخزون</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">المستودع</th>
                        <th>الموقع</th>
                        <th>النوع</th>
                        <th>كود الصنف</th>
                        <th>اسم الصنف</th>
                        <th>رقم التشغيلة</th>
                        <th class="text-end">الرصيد الفعلي</th>
                        <th class="text-end">المحجوز</th>
                        <th class="text-end">المتاح للصرف</th>
                        <th class="text-center pe-3">حالة الرصيد</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Stocks.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">لا توجد أرصدة مخزنية مسجلة</td>
                        </tr>
                    }
                    @foreach (var s in Model.Stocks)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@s.WarehouseName</td>
                            <td class="font-monospace text-muted">@(s.LocationCode ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@s.ItemType</span></td>
                            <td class="font-monospace fw-bold">@s.ItemCode</td>
                            <td>@s.ItemName</td>
                            <td class="font-monospace">@(s.BatchNumber ?? "-")</td>
                            <td class="text-end font-monospace fw-bold">@s.Quantity.ToString("N2") @s.Unit</td>
                            <td class="text-end font-monospace text-muted">@s.ReservedQuantity.ToString("N2")</td>
                            <td class="text-end font-monospace text-success fw-bold">@s.AvailableQuantity.ToString("N2")</td>
                            <td class="text-center pe-3">
                                @if (s.StockStatus == "OUT_OF_STOCK")
                                {
                                    <span class="badge bg-danger">نفد المخزون</span>
                                }
                                else if (s.StockStatus == "LOW_STOCK")
                                {
                                    <span class="badge bg-warning text-dark">منخفض (تحت حد الطلب)</span>
                                }
                                else if (s.StockStatus == "OVER_STOCK")
                                {
                                    <span class="badge bg-info text-dark">فائض</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">طبيعي (Normal)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
