@model FactoryX.Application.DTOs.ProductionBatchReportDto
@{
    ViewData["Title"] = "تقرير تشغيلات وخلطات الإنتاج";
    ViewData["ShowProductFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-diagram-2 text-primary me-2"></i>تقرير تشغيلات وخلطات الإنتاج (Production Batches)</h2>
        <p class="text-muted mb-0">سجل التشغيلات الفعلية، أوقات البدء والانتهاء، والمخرجات الفعلية لكل دفعة</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">رقم التشغيلة (Batch #)</th>
                        <th>أمر الشغل التابع</th>
                        <th>المنتج</th>
                        <th>وقت البدء</th>
                        <th>وقت الانتهاء</th>
                        <th class="text-end">الكمية المخططة</th>
                        <th class="text-end">الناتج الفعلي</th>
                        <th class="text-center pe-3">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Batches.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">لا توجد تشغيلات إنتاج مسجلة</td>
                        </tr>
                    }
                    @foreach (var b in Model.Batches)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold">
                                <a asp-controller="ProductionBatches" asp-action="Details" asp-route-id="@b.BatchId" class="text-decoration-none">
                                    @b.BatchNumber
                                </a>
                            </td>
                            <td class="font-monospace">@b.WorkOrderNumber</td>
                            <td class="fw-semibold">@b.ProductName</td>
                            <td>@(b.StartDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>@(b.EndDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td class="text-end font-monospace">@b.PlannedQuantity.ToString("N2") KG</td>
                            <td class="text-end font-monospace text-success fw-bold">@b.ActualQuantity.ToString("N2") KG</td>
                            <td class="text-center pe-3"><span class="badge bg-light text-dark border">@b.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
