@model FactoryX.Application.DTOs.ExpiryReportDto
@{
    ViewData["Title"] = "تقرير صلاحيات وتشغيلات المخزون";
    ViewData["ShowWarehouseFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-event text-danger me-2"></i>تقرير صلاحيات وتشغيلات المخزون (Expiry & Lots)</h2>
        <p class="text-muted mb-0">متابعة تواريخ انتهاء صلاحية تشغيلات المواد الخام ومواد التعبئة والإنتاج التام</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">نوع الصنف</th>
                        <th>كود الصنف</th>
                        <th>اسم الصنف</th>
                        <th>رقم التشغيلة / اللوت</th>
                        <th>المستودع</th>
                        <th class="text-end">الكمية الحالية</th>
                        <th>تاريخ الإنتاج</th>
                        <th>تاريخ الانتهاء</th>
                        <th class="text-center pe-3">الأيام المتبقية</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Lots.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">لا توجد تشغيلات مسجلة</td>
                        </tr>
                    }
                    @foreach (var l in Model.Lots)
                    {
                        <tr class="@(l.IsExpired ? "table-danger" : (l.DaysRemaining <= 30 ? "table-warning" : ""))">
                            <td class="ps-3"><span class="badge bg-light text-dark border">@l.ItemType</span></td>
                            <td class="font-monospace fw-bold">@l.ItemCode</td>
                            <td class="fw-semibold">@l.ItemName</td>
                            <td class="font-monospace fw-bold">@l.BatchNumber</td>
                            <td>@l.WarehouseName</td>
                            <td class="text-end font-monospace">@l.Quantity.ToString("N2") @l.Unit</td>
                            <td>@(l.ProductionDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="fw-bold font-monospace">@l.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-center pe-3">
                                @if (l.IsExpired)
                                {
                                    <span class="badge bg-danger">منتهي الصلاحية (@Math.Abs(l.DaysRemaining) يوم مضت)</span>
                                }
                                else if (l.DaysRemaining <= 30)
                                {
                                    <span class="badge bg-warning text-dark">يوشك على الانتهاء (@l.DaysRemaining يوم)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">ساري (@l.DaysRemaining يوم)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
