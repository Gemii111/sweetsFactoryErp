@model FactoryX.Application.DTOs.InventoryMovementReportDto
@{
    ViewData["Title"] = "تقرير حركة وكارت الصنف المخزني";
    ViewData["ShowWarehouseFilter"] = true;
    ViewData["ShowMaterialFilter"] = true;
    ViewData["ShowProductFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-success me-2"></i>تقرير حركة وكارت الصنف المخزني (Inventory Movements)</h2>
        <p class="text-muted mb-0">سجل وتاريخ الحركات المخزنية الواردة والمنصرفة مع المستندات المرجعية</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">التاريخ والوقت</th>
                        <th>رقم الحركة</th>
                        <th>نوع الحركة</th>
                        <th>اسم الصنف</th>
                        <th>المستودع</th>
                        <th>رقم التشغيلة</th>
                        <th class="text-center">الاتجاه</th>
                        <th class="text-end">الكمية</th>
                        <th class="pe-3">المستند المرجعي</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Movements.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">لا توجد حركات مخزنية مسجلة</td>
                        </tr>
                    }
                    @foreach (var m in Model.Movements)
                    {
                        <tr>
                            <td class="ps-3">@m.Date.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="font-monospace fw-bold">@m.TransactionNumber</td>
                            <td><span class="badge bg-light text-dark border">@m.TransactionType</span></td>
                            <td class="fw-semibold">@m.ItemName</td>
                            <td>@m.WarehouseName</td>
                            <td class="font-monospace">@(m.BatchNumber ?? "-")</td>
                            <td class="text-center">
                                @if (m.Direction.Contains("IN"))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">وارد +</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">صادر -</span>
                                }
                            </td>
                            <td class="text-end font-monospace fw-bold">@m.Quantity.ToString("N2") @m.Unit</td>
                            <td class="pe-3 font-monospace small text-primary">@(m.ReferenceDocument ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
