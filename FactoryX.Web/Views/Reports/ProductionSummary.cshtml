@model FactoryX.Application.DTOs.ProductionSummaryReportDto
@{
    ViewData["Title"] = "تقرير ملخص الإنتاج ومعدلات الإنجاز";
    ViewData["ShowProductFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-gear-wide-connected text-primary me-2"></i>تقرير ملخص الإنتاج ومعدلات الإنجاز (Production Summary)</h2>
        <p class="text-muted mb-0">متابعة إجمالي خطط وأوامر الإنتاج، المخرجات الفعلية، ومعدل تحقيق الخطط</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">أوامر الإنتاج الإجمالية</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.TotalProductionOrders <small class="fs-6">أمر شغل</small></h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">الإنتاج المخطط له</small>
            <h4 class="fw-bold text-secondary font-monospace mb-0">@Model.TotalPlannedOutputKg.ToString("N2") <small class="fs-6">KG</small></h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">الإنتاج الفعلي المحقق</small>
            <h4 class="fw-bold text-success font-monospace mb-0">@Model.TotalActualOutputKg.ToString("N2") <small class="fs-6">KG</small></h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success-subtle p-3">
            <small class="text-success fw-bold">معدل تحقيق الخطة %</small>
            <h4 class="fw-bold text-success font-monospace mb-0">@Model.AchievementRate%</h4>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold">أداء أوامر الإنتاج التفصيلية</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">رقم أمر الشغل</th>
                        <th>المنتج</th>
                        <th>تاريخ التخطيط</th>
                        <th class="text-end">الكمية المخططة</th>
                        <th class="text-end">الكمية الفعلية</th>
                        <th class="text-end">الانحراف (+ / -)</th>
                        <th class="text-center">نسبة الإنجاز %</th>
                        <th class="text-center pe-3">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">لا توجد أوامر إنتاج مسجلة</td>
                        </tr>
                    }
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold">
                                <a asp-controller="ProductionOrders" asp-action="Details" asp-route-id="@o.OrderId" class="text-decoration-none">
                                    @o.OrderNumber
                                </a>
                            </td>
                            <td class="fw-semibold">@o.ProductName</td>
                            <td>@o.PlannedDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end font-monospace">@o.PlannedQuantity.ToString("N2") KG</td>
                            <td class="text-end font-monospace text-success fw-bold">@o.ActualQuantity.ToString("N2") KG</td>
                            <td class="text-end font-monospace @(o.Variance >= 0 ? "text-success" : "text-danger")">
                                @(o.Variance > 0 ? "+" : "")@o.Variance.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge @(o.AchievementPercent >= 100 ? "bg-success" : (o.AchievementPercent >= 80 ? "bg-primary" : "bg-warning text-dark")) font-monospace">
                                    @o.AchievementPercent%
                                </span>
                            </td>
                            <td class="text-center pe-3"><span class="badge bg-light text-dark border">@o.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
