@model FactoryX.Application.DTOs.WasteTypeReportDto
@{
    ViewData["Title"] = "تقرير الهالك حسب النوع والتصنيف";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-pie-chart-fill text-danger me-2"></i>تقرير الهالك حسب النوع (Waste by Type)</h2>
        <p class="text-muted mb-0">توزيع خسائر وكميات الهالك: هالك مواد خام، هالك خطوط الإنتاج، ومرفوضات المنتج النهائي</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">نوع الهالك</th>
                        <th class="text-end">الكمية الإجمالية</th>
                        <th class="text-end pe-3">التكلفة المالية الإجمالية</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.WasteTypes.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">لا يوجد هالك مسجل</td>
                        </tr>
                    }
                    @foreach (var t in Model.WasteTypes)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@t.TypeName</td>
                            <td class="text-end font-monospace">@t.Quantity.ToString("N2") KG</td>
                            <td class="text-end font-monospace pe-3 fw-bold text-danger">@t.Cost.ToString("N2") EGP</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
