@model FactoryX.Application.DTOs.QualityRejectionReportDto
@{
    ViewData["Title"] = "تقرير مرفوضات الجودة ومعايير الفشل";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-x-octagon-fill text-danger me-2"></i>تقرير مرفوضات الجودة (QC Rejections)</h2>
        <p class="text-muted mb-0">سجل عينات الفحص غير المطابقة والمعايير المعملية التي تسببت في رفض التشغيلة</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">رقم الفحص</th>
                        <th>التاريخ</th>
                        <th>اسم المنتج</th>
                        <th>رقم التشغيلة</th>
                        <th>المعايير غير المطابقة</th>
                        <th>القرار</th>
                        <th class="pe-3">ملاحظات الفاحص</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rejections.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-success fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i>لا توجد مرفوضات جودة مسجلة
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Rejections)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-danger">@r.InspectionNumber</td>
                            <td>@r.InspectionDate.ToString("yyyy-MM-dd")</td>
                            <td class="fw-semibold">@r.ProductName</td>
                            <td class="font-monospace">@(r.BatchNumber ?? "-")</td>
                            <td class="text-danger fw-bold">@(string.IsNullOrWhiteSpace(r.FailedParameters) ? "معايير فيزيائية/كيميائية" : r.FailedParameters)</td>
                            <td><span class="badge bg-danger">@r.Decision</span></td>
                            <td class="pe-3 text-muted small">@(r.Comments ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
