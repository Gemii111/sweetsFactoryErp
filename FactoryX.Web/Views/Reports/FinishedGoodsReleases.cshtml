@model FactoryX.Application.DTOs.FinishedGoodsReleaseReportDto
@{
    ViewData["Title"] = "تقرير أذونات الإفراج عن الإنتاج التام";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-check-fill text-success me-2"></i>تقرير أذونات الإفراج عن الإنتاج التام (FG Releases)</h2>
        <p class="text-muted mb-0">سجل الإفراج المخزني عن تشغيلات حلوى المولد المعتمدة بعد اجتياز فحص الجودة والتعبئة</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">رقم إذن الإفراج</th>
                        <th>تاريخ الإفراج</th>
                        <th>اسم المنتج</th>
                        <th>رقم التشغيلة (Batch)</th>
                        <th class="text-end">الكمية المفرج عنها</th>
                        <th class="text-end">التكلفة الإجمالية</th>
                        <th class="text-center pe-3">رقم فحص الجودة المعتمد</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Releases.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">لا توجد أذونات إفراج مسجلة</td>
                        </tr>
                    }
                    @foreach (var r in Model.Releases)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-success">@r.ReleaseNumber</td>
                            <td>@r.ReleasedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-semibold">@r.ProductName</td>
                            <td class="font-monospace fw-bold text-primary">@r.BatchNumber</td>
                            <td class="text-end font-monospace fw-bold">@r.ReleasedQuantity.ToString("N2") @r.Unit</td>
                            <td class="text-end font-monospace text-primary fw-bold">@r.TotalCost.ToString("N2") EGP</td>
                            <td class="text-center pe-3 font-monospace text-success"><i class="bi bi-check-circle-fill me-1"></i>@(r.QCInspectionNumber ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
