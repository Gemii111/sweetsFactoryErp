@model FactoryX.Application.DTOs.SupplierPayablesReportDto
@{
    ViewData["Title"] = "تقرير أرصدة ومستحقات الموردين والمطابقة المحاسبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-truck-front-fill text-warning me-2"></i>تقرير أرصدة الموردين والمطابقة مع الأستاذ العام (AP Reconciliation)</h2>
        <p class="text-muted mb-0">مطابقة إجمالي مستحقات دفاتر مساعد الموردين مع رصيد حساب الموردون والدائنون (2101) في الأستاذ العام</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<!-- Reconciliation KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">رصيد حساب الأستاذ العام (2101 GL Control)</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.AccountingControlBalance.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">مجموع أرصدة كشوف حسابات الموردين (Subledger Total)</small>
            <h4 class="fw-bold text-warning font-monospace mb-0">@Model.SubledgerTotalPayable.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "bg-success-subtle" : "bg-warning-subtle") p-3">
            <small class="fw-bold @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "text-success" : "text-warning")">فارق المطابقة (Reconciliation Diff)</small>
            <h4 class="fw-bold font-monospace mb-0 @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "text-success" : "text-dark")">
                @Model.ReconciliationDifference.ToString("N2") EGP
            </h4>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">كود المورد</th>
                        <th>اسم المورد</th>
                        <th class="text-end">إجمالي التوريدات (GRN)</th>
                        <th class="text-end">إجمالي المدفوعات المسددة (SPAY)</th>
                        <th class="text-end pe-3">الرصيد الدائن المستحق للدفع</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Suppliers)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold">@s.SupplierCode</td>
                            <td class="fw-semibold">
                                <a asp-controller="SupplierLedger" asp-action="Index" asp-route-supplierId="@s.SupplierId" class="text-decoration-none">
                                    @s.SupplierName
                                </a>
                            </td>
                            <td class="text-end font-monospace">@s.TotalPurchases.ToString("N2")</td>
                            <td class="text-end font-monospace text-primary">@s.TotalPaid.ToString("N2")</td>
                            <td class="text-end font-monospace pe-3 fw-bold @(s.OutstandingPayable > 0 ? "text-danger" : "text-dark")">
                                @s.OutstandingPayable.ToString("N2") EGP
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
