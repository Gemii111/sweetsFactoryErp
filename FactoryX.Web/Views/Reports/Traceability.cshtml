@model FactoryX.Application.DTOs.FinishedGoodsTraceabilityReportDto
@{
    ViewData["Title"] = "تقرير تتبع مسار الدفعة والتشغيلة الشامل";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-diagram-3-fill text-info me-2"></i>شجرة تتبع مسار التشغيلة الشامل (End-to-End Batch Traceability)</h2>
        <p class="text-muted mb-0">تتبع كامل من المورد والخامات الأولية مروراً بالإنتاج والجودة والتعبئة وحتى العميل وفواتير البيع</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<!-- Search Bar -->
<div class="card shadow-sm border-0 mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label small fw-bold mb-1">رقم تشغيلة الإنتاج التام (Batch #) أو كود المنتج</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.QuerySearch" placeholder="مثال: B-20260830-0001 أو أدخل جزء من رقم التشغيلة..." class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-diagram-3 me-1"></i>تتبع الشجرة الكاملة</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Found || Model.TraceTree == null)
{
    <div class="card shadow-sm border-0 text-center py-5">
        <div class="card-body">
            <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
            <h5 class="text-muted">لم يتم العثور على تشغيلة إنتاج تطابق: "@Model.QuerySearch"</h5>
            <p class="text-muted small">يرجى إدخال رقم تشغيلة إنتاج صالح من سجلات المصنع لبناء شجرة التتبع</p>
        </div>
    </div>
}
else
{
    var tree = Model.TraceTree;
    
    <!-- Central Batch Profile Card -->
    <div class="card shadow-sm border-0 border-top border-primary border-4 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-box-seam text-primary me-2"></i>التشغيلة المركزية: <span class="font-monospace text-primary">@tree.BatchNumber</span>
            </h5>
            <span class="badge bg-success-subtle text-success font-monospace px-3 py-2">
                <i class="bi bi-check-circle-fill me-1"></i>@(tree.QCDecision ?? "معتمد")
            </span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <small class="text-muted d-block">اسم المنتج التام</small>
                    <strong class="fs-6">@tree.ProductName</strong>
                    <span class="font-monospace text-muted d-block small">@tree.ProductCode</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">أمر الشغل / التركيبة</small>
                    <strong class="font-monospace">@(tree.ProductionOrderNumber ?? "-")</strong>
                    <span class="d-block small text-muted">تركيبة: @(tree.RecipeCode ?? "قياسية")</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">تاريخ الإنتاج والصلاحية</small>
                    <span class="d-block">إنتاج: @(tree.ProductionDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                    <span class="d-block text-danger small fw-bold">انتهاء: @(tree.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">أمر التعبئة / إذن الإفراج</small>
                    <span class="font-monospace d-block text-info">تعبئة: @(tree.PackagingOrderNumber ?? "-")</span>
                    <span class="font-monospace d-block text-success fw-bold">إفراج: @(tree.ReleaseNumber ?? "-")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 1. Upstream Traceability (Raw Materials & Suppliers) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-arrow-up-circle-fill text-warning me-2"></i>المسار الصاعد: الخامات والموردين (Upstream Materials)
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">الخامة المستهلكة</th>
                                    <th>تشغيلة الخامة</th>
                                    <th class="text-end">الكمية</th>
                                    <th class="pe-3">المورد / إذن الاستلام GRN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!tree.RawMaterials.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-3 text-muted">لا توجد خامات مسجلة</td>
                                    </tr>
                                }
                                @foreach (var m in tree.RawMaterials)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@m.MaterialName</td>
                                        <td class="font-monospace text-muted small">@(m.RawMaterialBatchNumber ?? "LOT-DEF")</td>
                                        <td class="text-end font-monospace">@m.ConsumedQuantity.ToString("N2") @m.Unit</td>
                                        <td class="pe-3 small">
                                            <span class="fw-bold d-block text-dark">@(m.SupplierName ?? "المورد الرئيسي")</span>
                                            <span class="font-monospace text-muted">@(m.PurchaseReceiptNumber ?? "GRN-AUTO")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Downstream Traceability (Sales Orders & Customers) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-arrow-down-circle-fill text-primary me-2"></i>المسار الهابط: تسليمات المبيعات والعملاء (Downstream Sales)
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">أمر البيع</th>
                                    <th>إذن التسليم</th>
                                    <th>العميل المستلم</th>
                                    <th class="text-end">تاريخ الشحن</th>
                                    <th class="text-end pe-3">الكمية المسلمة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!tree.SalesDeliveries.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">لم يتم تسليم كميات من هذه التشغيلة للعملاء بعد (مخزنة بالمستودع)</td>
                                    </tr>
                                }
                                @foreach (var s in tree.SalesDeliveries)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace fw-bold">@s.SalesOrderNumber</td>
                                        <td class="font-monospace text-primary">@s.FulfillmentNumber</td>
                                        <td class="fw-semibold">@s.CustomerName</td>
                                        <td class="text-end">@s.ShippedDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end pe-3 font-monospace text-success fw-bold">@s.ShippedQuantity.ToString("N2") @s.Unit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
