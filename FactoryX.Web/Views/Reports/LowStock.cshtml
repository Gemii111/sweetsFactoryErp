@model FactoryX.Application.DTOs.LowStockReportDto
@{
    ViewData["Title"] = "تقرير نواقص المخزون والأصناف تحت حد الطلب";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>تقرير نواقص المخزون والأصناف تحت حد الطلب (Low Stock)</h2>
        <p class="text-muted mb-0">قائمة الأصناف والخامات التي وصل رصيدها إلى ما دون الحد الأدنى الآمن للمخزون</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">نوع الصنف</th>
                        <th>كود الصنف</th>
                        <th>اسم الصنف</th>
                        <th>المستودع الافتراضي</th>
                        <th class="text-end">الرصيد الفعلي الحالي</th>
                        <th class="text-end">الحد الأدنى للمخزون</th>
                        <th class="text-end pe-3">مقدار العجز المطلوب تدبيره</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-success fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i>جميع الأصناف والخامات أعلى من الحد الأدنى للطلب ولا توجد نواقص
                            </td>
                        </tr>
                    }
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-light text-dark border">@i.ItemType</span></td>
                            <td class="font-monospace fw-bold">@i.ItemCode</td>
                            <td class="fw-semibold">@i.ItemName</td>
                            <td>@i.WarehouseName</td>
                            <td class="text-end font-monospace fw-bold text-danger">@i.CurrentQuantity.ToString("N2") @i.Unit</td>
                            <td class="text-end font-monospace">@i.MinimumQuantity.ToString("N2") @i.Unit</td>
                            <td class="text-end font-monospace pe-3 fw-bold text-danger">@i.Deficit.ToString("N2") @i.Unit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
