@model FactoryX.Application.DTOs.VatReportDto
@{
    ViewData["Title"] = "تقرير إقرار وضريبة القيمة المضافة (VAT)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-percent text-info me-2"></i>تقرير إقرار وضريبة القيمة المضافة (VAT Return)</h2>
        <p class="text-muted mb-0">حساب ضريبة المخرجات (المبيعات 2201) وضريبة المدخلات (المشتريات 1401) وصافي الضريبة المستحقة</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">ضريبة المخرجات (المبيعات المحصلة)</small>
            <h4 class="fw-bold text-primary font-monospace mb-0">@Model.OutputVatTotal.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">ضريبة المدخلات (المشتريات المخصومة)</small>
            <h4 class="fw-bold text-success font-monospace mb-0">@Model.InputVatTotal.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-info-subtle p-3">
            <small class="text-info-emphasis fw-bold">صافي الضريبة واجبة السداد لمصلحة الضرائب</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.NetVatPayable.ToString("N2") EGP</h4>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">التاريخ</th>
                        <th>رقم القيد اليومي</th>
                        <th>نوع الضريبة</th>
                        <th>المستند المرجعي</th>
                        <th>الطرف / العميل / المورد</th>
                        <th class="text-end">المبلغ الخاضع للضريبة (تقديري)</th>
                        <th class="text-end pe-3">قيمة الضريبة (14%)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Transactions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">لا توجد حركات ضريبية مسجلة</td>
                        </tr>
                    }
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td class="ps-3">@t.Date.ToString("yyyy-MM-dd")</td>
                            <td class="font-monospace fw-bold text-primary">@t.JournalNumber</td>
                            <td><span class="badge bg-light text-dark border">@t.Type</span></td>
                            <td class="font-monospace">@t.DocumentNumber</td>
                            <td>@t.PartnerName</td>
                            <td class="text-end font-monospace">@t.TaxableAmount.ToString("N2")</td>
                            <td class="text-end font-monospace pe-3 fw-bold @(t.Type.Contains("مبيعات") ? "text-danger" : "text-success")">
                                @t.VatAmount.ToString("N2") EGP
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
