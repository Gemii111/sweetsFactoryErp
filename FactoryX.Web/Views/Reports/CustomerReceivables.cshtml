@model FactoryX.Application.DTOs.CustomerReceivablesReportDto
@{
    ViewData["Title"] = "تقرير أرصدة ومديونيات العملاء والمطابقة المحاسبية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-check-fill text-primary me-2"></i>تقرير أرصدة العملاء والمطابقة مع الأستاذ العام (AR Reconciliation)</h2>
        <p class="text-muted mb-0">مطابقة إجمالي مديونيات دفاتر مساعد العملاء مع رصيد حساب العملاء والمدينون (1201) في الأستاذ العام</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

<!-- Reconciliation KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">رصيد حساب الأستاذ العام (1201 GL Control)</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.AccountingControlBalance.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">مجموع أرصدة كشوف حسابات العملاء (Subledger Total)</small>
            <h4 class="fw-bold text-primary font-monospace mb-0">@Model.SubledgerTotalReceivable.ToString("N2") EGP</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "bg-success-subtle" : "bg-warning-subtle") p-3">
            <small class="fw-bold @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "text-success" : "text-warning")">فارق المطابقة (Reconciliation Diff)</small>
            <h4 class="fw-bold font-monospace mb-0 @(Math.Abs(Model.ReconciliationDifference) < 0.01m ? "text-success" : "text-dark")">
                @Model.ReconciliationDifference.ToString("N2") EGP
            </h4>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">كود العميل</th>
                        <th>اسم العميل</th>
                        <th class="text-end">إجمالي الفواتير الصادرة</th>
                        <th class="text-end">إجمالي المدفوعات والمقبوضات</th>
                        <th class="text-end pe-3">الرصيد المدين المستحق</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold">@c.CustomerCode</td>
                            <td class="fw-semibold">
                                <a asp-controller="CustomerLedger" asp-action="Index" asp-route-customerId="@c.CustomerId" class="text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td class="text-end font-monospace">@c.InvoicedAmount.ToString("N2")</td>
                            <td class="text-end font-monospace text-success">@c.PaidAmount.ToString("N2")</td>
                            <td class="text-end font-monospace pe-3 fw-bold @(c.OutstandingReceivable > 0 ? "text-danger" : "text-dark")">
                                @c.OutstandingReceivable.ToString("N2") EGP
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
