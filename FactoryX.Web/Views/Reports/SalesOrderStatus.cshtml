@model FactoryX.Application.DTOs.SalesOrderStatusReportDto
@{
    ViewData["Title"] = "تقرير متابعة وحالات أوامر البيع";
    ViewData["ShowCustomerFilter"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-list-check text-primary me-2"></i>تقرير متابعة وحالات أوامر البيع (Sales Orders Status)</h2>
        <p class="text-muted mb-0">متابعة دقيقة لموقف تسليم أوامر البيع والكميات المتبقية للتسليم</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary no-print">
        <i class="bi bi-arrow-right me-1"></i>لوحة التقارير
    </a>
</div>

@await Html.PartialAsync("_ReportFilter", Model.Filter)

<!-- Status Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col">
        <div class="card shadow-sm border-0 bg-light p-3 text-center">
            <small class="text-muted">مسودة (Draft)</small>
            <h4 class="fw-bold mb-0">@Model.DraftCount</h4>
        </div>
    </div>
    <div class="col">
        <div class="card shadow-sm border-0 bg-primary-subtle text-primary p-3 text-center">
            <small>مؤكد وجاهز (Confirmed)</small>
            <h4 class="fw-bold mb-0">@Model.ConfirmedCount</h4>
        </div>
    </div>
    <div class="col">
        <div class="card shadow-sm border-0 bg-warning-subtle text-dark p-3 text-center">
            <small>تسليم جزئي (Partially)</small>
            <h4 class="fw-bold mb-0">@Model.PartiallyFulfilledCount</h4>
        </div>
    </div>
    <div class="col">
        <div class="card shadow-sm border-0 bg-success-subtle text-success p-3 text-center">
            <small>مسلم بالكامل (Fulfilled)</small>
            <h4 class="fw-bold mb-0">@Model.FullyFulfilledCount</h4>
        </div>
    </div>
    <div class="col">
        <div class="card shadow-sm border-0 bg-secondary-subtle text-secondary p-3 text-center">
            <small>مغلق ومكتمل (Closed)</small>
            <h4 class="fw-bold mb-0">@Model.ClosedCount</h4>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">رقم الطلب</th>
                        <th>تاريخ الطلب</th>
                        <th>تاريخ التسليم المطلوب</th>
                        <th>العميل</th>
                        <th class="text-end">الكمية الإجمالية</th>
                        <th class="text-end">الكمية المسلمة</th>
                        <th class="text-end">الكمية المتبقية</th>
                        <th class="text-end">إجمالي القيمة</th>
                        <th class="text-center">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Orders)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold">
                                <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none">
                                    @item.OrderNumber
                                </a>
                            </td>
                            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@(item.RequiredDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td class="text-end font-monospace">@item.TotalQuantity.ToString("N2")</td>
                            <td class="text-end font-monospace text-success fw-bold">@item.FulfilledQuantity.ToString("N2")</td>
                            <td class="text-end font-monospace @(item.RemainingQuantity > 0 ? "text-danger fw-bold" : "text-muted")">
                                @item.RemainingQuantity.ToString("N2")
                            </td>
                            <td class="text-end font-monospace">@item.TotalAmount.ToString("N2") EGP</td>
                            <td class="text-center"><span class="badge bg-light text-dark border">@item.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
