@model FactoryX.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب جديد";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إنشاء حساب جديد - مصنع حلويات المولد ERP</title>
    <!-- Google Arabic Font: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Cairo', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container-box {
            width: 100%;
            max-width: 460px;
            background: rgba(255, 255, 255, 0.96);
            border-radius: 20px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
            padding: 2.5rem 2rem;
        }

        .title {
            font-weight: 800;
            font-size: 1.6rem;
            text-align: center;
            color: #1e3a8a;
        }

        .btn-success {
            background: linear-gradient(90deg, #16a34a 0%, #22c55e 100%);
            border: none;
            font-weight: 700;
            padding: 0.7rem;
            font-size: 1.1rem;
        }

        .btn-success:hover {
            background: linear-gradient(90deg, #15803d 0%, #16a34a 100%);
        }
    </style>
</head>

<body>
    <div class="container-box shadow-lg">
        <div class="text-center mb-3">
            <i class="bi bi-person-plus-fill fs-1 text-success"></i>
            <div class="title mt-1">إنشاء مستخدم جديد</div>
            <small class="text-muted">نظام تخطيط وإدارة موارد المصنع ERP</small>
        </div>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">اسم المستخدم</label>
                <input asp-for="Username" class="form-control" autocomplete="username" placeholder="أدخل اسم المستخدم" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">كلمة المرور</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" type="password" placeholder="أدخل كلمة المرور" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">تأكيد كلمة المرور</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" type="password" placeholder="أعد إدخال كلمة المرور" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Role" class="form-label fw-semibold">الدور والصلاحية</label>
                <select asp-for="Role" class="form-select">
                    <option value="" disabled selected>-- اختر الدور --</option>
                    <option value="Admin">مدير النظام (Admin)</option>
                    <option value="Operator">مشغل / عامل (Operator)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-3 shadow-sm"><i class="bi bi-check-circle me-1"></i> تسجيل الحساب</button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <span class="text-muted small">لديك حساب بالفعل؟</span>
            <a asp-action="Login" class="text-primary fw-bold small text-decoration-none">تسجيل الدخول</a>
        </div>
    </div>
</body>

</html>
