@model FactoryX.Application.DTOs.Responses.UserManagementResponses.GetUserProfileResponse
@{
    ViewData["Title"] = "الملف الشخصي";
}
<partial name="_Alert" />
<div class="glass-card p-4 shadow-sm">
    <h3 class="fw-bold mb-4 text-primary"><i class="bi bi-person-gear me-2"></i>بيانات الملف الشخصي</h3>
    <form asp-action="Profile" method="post" autocomplete="off">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="UserName" class="form-label fw-semibold">اسم المستخدم</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold">البريد الإلكتروني</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="FullName" class="form-label fw-semibold">الاسم الكامل</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-save me-1"></i>حفظ التعديلات</button>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-key me-1"></i>تغيير كلمة المرور</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border-radius: 1.2rem;
        backdrop-filter: blur(8px);
        max-width: 540px;
        margin: 2rem auto;
    }

    [data-bs-theme="dark"] .glass-card {
        background: rgba(30, 34, 54, 0.85);
    }
</style>