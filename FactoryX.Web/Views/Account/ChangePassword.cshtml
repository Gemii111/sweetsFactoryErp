@model FactoryX.Application.DTOs.Requests.UserManagementRequests.ChangePasswordRequest
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}
<partial name="_Alert" />
<div class="glass-card p-4 shadow-sm">
    <h3 class="fw-bold mb-4 text-primary"><i class="bi bi-shield-lock me-2"></i>تغيير كلمة المرور</h3>
    <form asp-action="ChangePassword" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-semibold">كلمة المرور الحالية</label>
            <input asp-for="CurrentPassword" class="form-control" type="password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-semibold">كلمة المرور الجديدة</label>
            <input asp-for="NewPassword" class="form-control" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-semibold">تأكيد كلمة المرور الجديدة</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-check-circle me-1"></i>تحديث كلمة المرور</button>
            <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-3">إلغاء والعودة</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        border-radius: 1.2rem;
        backdrop-filter: blur(8px);
        max-width: 540px;
        margin: 2rem auto;
    }

    [data-bs-theme="dark"] .glass-card {
        background: rgba(30, 34, 54, 0.85);
    }
</style>