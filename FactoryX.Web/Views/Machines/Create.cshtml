@model FactoryX.Application.DTOs.Requests.MachineRequests.InsertMachineRequest
@{
    ViewData["Title"] = "إضافة ماكينة جديدة";
}
<div class="container py-4">
    @await Html.PartialAsync("_Alert")
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center text-primary"><i class="bi bi-cpu-fill me-2"></i>إضافة ماكينة / خط تصنيع</h3>
                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">اسم الماكينة / الخط</label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: حلة طبخ السمسمية 1" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">الحالة التشغيلية</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">نشطة وتعمل (Active)</option>
                                <option value="Inactive">متوقفة / تحت الصيانة (Inactive)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Capacity" class="form-label fw-semibold">الطاقة الإنتاجية (كجم/ساعة)</label>
                            <input asp-for="Capacity" class="form-control" type="number" min="1" placeholder="مثال: 500" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-right"></i> إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-check-lg"></i> حفظ الماكينة</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}