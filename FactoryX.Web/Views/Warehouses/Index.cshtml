@model IEnumerable<FactoryX.Application.DTOs.WarehouseDto>

@{
    ViewData["Title"] = "إدارة المستودعات والمخازن";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-buildings text-primary me-2"></i>إدارة المستودعات والمخازن</h2>
        <p class="text-muted mb-0">متابعة وإدارة مخازن المواد الخام، التعبئة، والمنتج التام لمصنع حلويات المولد.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-3"><i class="bi bi-plus-lg me-1"></i>إضافة مستودع جديد</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">كود المستودع</th>
                        <th>اسم المستودع</th>
                        <th>نوع المستودع</th>
                        <th>أماكن التخزين</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                لا توجد مستودعات مسجلة حتى الآن. اضغط على "إضافة مستودع جديد" للبدء.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">@item.Code</td>
                                <td>
                                    <div class="fw-bold">@item.Name</div>
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                        <i class="bi bi-tag me-1"></i>@item.TypeName
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="WarehouseLocations" asp-action="Index" asp-route-warehouseId="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                        <i class="bi bi-geo-alt me-1"></i>@item.LocationCount أماكن تخزين
                                    </a>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">معطل</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light me-1" title="عرض التفاصيل"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light me-1" title="تعديل"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="تغيير الحالة">
                                            <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
