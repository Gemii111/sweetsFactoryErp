@model FactoryX.Application.DTOs.InvoiceDto
@{
    ViewData["Title"] = $"فاتورة مبيعات - {Model.InvoiceNumber}";
}

<div class="container-fluid py-3">
    <!-- Action Toolbar (Hidden on Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-file-invoice-dollar text-primary me-2"></i>فاتورة مبيعات (Sales Invoice)</h2>
            <p class="text-muted mb-0">بيانات الفاتورة وحسابات القيمة المضافة وسجل المدفوعات</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-print me-1"></i> طباعة الفاتورة
            </a>

            @if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Draft)
            {
                <form asp-action="Issue" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success shadow-sm" onclick="return confirm('هل أنت متأكد من اعتماد وإصدار هذه الفاتورة للعميل؟');">
                        <i class="fas fa-check-circle me-1"></i> اعتماد وإصدار الفاتورة
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Issued || Model.Status == FactoryX.Domain.Entities.InvoiceStatus.PartiallyPaid)
            {
                <a asp-controller="Payments" asp-action="Create" asp-route-invoiceId="@Model.Id" class="btn btn-success shadow-sm">
                    <i class="fas fa-money-bill-wave me-1"></i> تسجيل سند قبض وسداد
                </a>
            }

            @if ((Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Draft || Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Issued) && Model.PaidAmount == 0)
            {
                <button type="button" class="btn btn-outline-danger shadow-sm" data-bs-toggle="modal" data-bs-target="#cancelInvoiceModal">
                    <i class="fas fa-ban me-1"></i> إلغاء الفاتورة
                </button>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invoice Header Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center pb-3 mb-3 border-bottom">
                <div class="col-md-6">
                    <span class="badge bg-light text-primary border font-monospace fs-5 mb-2">@Model.InvoiceNumber</span>
                    <h3 class="fw-bold mb-1">فاتورة مبيعات تجارية</h3>
                    <p class="text-muted mb-0">تاريخ الإصدار: @Model.InvoiceDate.ToString("yyyy-MM-dd")</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <span class="fs-5">حالة الفاتورة:</span>
                    @if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Draft)
                    {
                        <span class="badge bg-secondary fs-6 ms-2">مسودة (Draft)</span>
                    }
                    else if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Issued)
                    {
                        <span class="badge bg-warning text-dark fs-6 ms-2">صادرة وغير مسددة (Issued)</span>
                    }
                    else if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.PartiallyPaid)
                    {
                        <span class="badge bg-info text-dark fs-6 ms-2">مسددة جزئياً (Partially Paid)</span>
                    }
                    else if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Paid)
                    {
                        <span class="badge bg-success fs-6 ms-2">مسددة بالكامل (Paid)</span>
                    }
                    else if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Cancelled)
                    {
                        <span class="badge bg-dark fs-6 ms-2">ملغاة (Cancelled)</span>
                    }
                </div>
            </div>

            <!-- Customer & Order Meta -->
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">العميل المفوتر له:</small>
                    <div class="fw-bold fs-6">@Model.CustomerName</div>
                    <small class="text-muted font-monospace">@Model.CustomerCode</small>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">أمر البيع المعتمد:</small>
                    <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="fw-bold font-monospace text-decoration-none">
                        @Model.SalesOrderNumber
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">تاريخ الاستحقاق:</small>
                    <div class="fw-bold">@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("yyyy-MM-dd") : "عند الاستلام / فوري")</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">منشئ الفاتورة:</small>
                    <div class="fw-bold">@(Model.CreatedByName ?? "المسؤول")</div>
                </div>
            </div>

            @if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Cancelled && !string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="fas fa-info-circle me-2"></i><strong>سبب الإلغاء:</strong> @Model.CancellationReason
                    @if (Model.CancelledAt.HasValue)
                    {
                        <span class="ms-2 text-muted">(@Model.CancelledAt.Value.ToString("yyyy-MM-dd HH:mm"))</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Financial KPI Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body text-center p-3">
                    <small class="text-muted d-block mb-1">المجموع الفرعي</small>
                    <h4 class="fw-bold font-monospace mb-0">@Model.SubTotal.ToString("N2") <small class="fs-6">@Model.Currency</small></h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body text-center p-3">
                    <small class="text-muted d-block mb-1">الخصومات والضريبة (@Model.TaxRate.ToString("0.##")%)</small>
                    <h4 class="fw-bold font-monospace mb-0 text-info">
                        -@Model.DiscountAmount.ToString("N2") / +@Model.TaxAmount.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body text-center p-3">
                    <small class="text-muted d-block mb-1">إجمالي الفاتورة الصافي</small>
                    <h4 class="fw-bold font-monospace mb-0 text-primary">@Model.TotalAmount.ToString("N2") <small class="fs-6">@Model.Currency</small></h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm @(Model.RemainingAmount == 0 ? "bg-success bg-opacity-10 border-success" : "bg-warning bg-opacity-10 border-warning")">
                <div class="card-body text-center p-3">
                    <small class="text-muted d-block mb-1">المتبقي المطلوب سداده</small>
                    <h4 class="fw-bold font-monospace mb-0 @(Model.RemainingAmount == 0 ? "text-success" : "text-danger")">
                        @Model.RemainingAmount.ToString("N2") <small class="fs-6">@Model.Currency</small>
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoice Items Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-primary"><i class="fas fa-boxes me-2"></i>تفاصيل بنود الفاتورة المفوترة</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>المنتج</th>
                        <th>الكمية المفوترة</th>
                        <th>سعر الوحدة</th>
                        <th>الخصم</th>
                        <th>الضريبة %</th>
                        <th>قيمة الضريبة</th>
                        <th>إجمالي البند</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int idx = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@(idx++)</td>
                                <td>
                                    <div class="fw-bold">@item.ProductName</div>
                                    <small class="text-muted font-monospace">@item.ProductCode</small>
                                </td>
                                <td class="fw-bold font-monospace">@item.Quantity.ToString("N2") @item.Unit</td>
                                <td class="font-monospace">@item.UnitPrice.ToString("N2")</td>
                                <td class="font-monospace text-danger">@item.DiscountAmount.ToString("N2")</td>
                                <td class="font-monospace">@item.TaxRate.ToString("0.##")%</td>
                                <td class="font-monospace text-info">@item.TaxAmount.ToString("N2")</td>
                                <td class="fw-bold font-monospace text-primary">@item.LineTotal.ToString("N2") @Model.Currency</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Payment Transactions History -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-success"><i class="fas fa-receipt me-2"></i>سجل سندات القبض والتحصيل المسجلة على هذه الفاتورة</h5>
            @if (Model.Status == FactoryX.Domain.Entities.InvoiceStatus.Issued || Model.Status == FactoryX.Domain.Entities.InvoiceStatus.PartiallyPaid)
            {
                <a asp-controller="Payments" asp-action="Create" asp-route-invoiceId="@Model.Id" class="btn btn-sm btn-success">
                    <i class="fas fa-plus-circle me-1"></i> تسجيل دفعة جديدة
                </a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم السند</th>
                        <th>تاريخ السداد</th>
                        <th>طريقة السداد</th>
                        <th>الرقم المرجعي / الشيك</th>
                        <th>المبلغ المسدد</th>
                        <th>المستلم</th>
                        <th>الحالة</th>
                        <th class="text-center">الإيصال</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        foreach (var pay in Model.Payments)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Payments" asp-action="Details" asp-route-id="@pay.Id" class="fw-bold font-monospace text-success text-decoration-none">
                                        @pay.PaymentNumber
                                    </a>
                                </td>
                                <td>@pay.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge bg-light text-dark border">@pay.PaymentMethodName</span></td>
                                <td class="font-monospace">@(pay.ReferenceNumber ?? "—")</td>
                                <td class="fw-bold font-monospace text-success">@pay.Amount.ToString("N2") @pay.Currency</td>
                                <td>@(pay.ReceivedByName ?? "المسؤول")</td>
                                <td>
                                    @if (pay.Status == FactoryX.Domain.Entities.PaymentStatus.Recorded)
                                    {
                                        <span class="badge bg-success">مثبت ومسجل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">ملغي / مسترد</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Payments" asp-action="Receipt" asp-route-id="@pay.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="طباعة الإيصال">
                                        <i class="fas fa-print"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                لم يتم تسجيل أي مدفوعات أو سندات قبض على هذه الفاتورة حتى الآن.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Cancel Invoice Modal -->
<div class="modal fade" id="cancelInvoiceModal" tabindex="-1" aria-labelledby="cancelInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="cancelInvoiceModalLabel"><i class="fas fa-ban me-2"></i>إلغاء فاتورة مبيعات</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">تحذير: سيتم إلغاء الفاتورة رقم [@Model.InvoiceNumber] نهائياً.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">سبب الإلغاء <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="أدخل سبب إلغاء الفاتورة بالتفصيل..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">تراجع</button>
                    <button type="submit" class="btn btn-danger">تأكيد إلغاء الفاتورة</button>
                </div>
            </form>
        </div>
    </div>
</div>
