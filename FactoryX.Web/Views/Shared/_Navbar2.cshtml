@{
    var appTitle = "مصنع حلويات المولد | ERP";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var username = User.Identity?.Name;
}

<nav class="navbar navbar-expand-md shadow-sm border-bottom">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-primary" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-gear-wide-connected fs-4"></i>
            <span class="fs-5">@appTitle</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar2"
            aria-controls="mainNavbar2" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar2">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center gap-2">
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link text-dark fw-semibold"><i class="bi bi-person-circle me-1 text-primary"></i> مرحباً، @username</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger fw-semibold" asp-controller="Account" asp-action="Logout" title="تسجيل الخروج">
                            <i class="bi bi-box-arrow-left me-1"></i> خروج
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> دخول
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus me-1"></i> إنشاء حساب
                        </a>
                    </li>
                }
                <li class="nav-item d-flex align-items-center ms-2">
                    @await Html.PartialAsync("_ThemeToggle")
                </li>
            </ul>
        </div>
    </div>
</nav>

<style>
    .navbar {
        background: rgba(255, 255, 255, 0.95);
    }

    [data-bs-theme="dark"] .navbar {
        background: rgba(30, 34, 54, 0.95);
    }

    .navbar .nav-link {
        color: #333;
        font-weight: 600;
        transition: color 0.15s;
    }

    .navbar .nav-link:hover,
    .navbar .nav-link.active {
        color: #0d6efd;
    }

    [data-bs-theme="dark"] .navbar .nav-link {
        color: #f8fafc;
    }

    [data-bs-theme="dark"] .navbar .nav-link:hover,
    [data-bs-theme="dark"] .navbar .nav-link.active {
        color: #60a5fa;
    }
</style>