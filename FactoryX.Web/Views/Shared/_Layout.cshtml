@{
    Layout = null;
    var appTitle = "نظام إدارة مصنع حلويات المولد | Mawlid Sweets ERP";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @appTitle</title>
    <!-- Google Arabic Font: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap RTL 5.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            font-family: 'Cairo', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #f0f4ff 0%, #f8fafc 100%);
            margin: 0;
            padding: 0;
        }

        [data-bs-theme="dark"] body {
            background: linear-gradient(135deg, #1e2236 0%, #121629 100%);
        }

        .sidebar {
            background: rgba(255, 255, 255, 0.95);
            border-left: 1px solid rgba(0, 0, 0, 0.05);
        }

        [data-bs-theme="dark"] .sidebar {
            background: rgba(30, 34, 54, 0.95);
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-link {
            color: #555;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: 12px;
            margin-bottom: 8px;
            transition: all 0.2s ease-in-out;
            text-decoration: none;
        }

        .sidebar-link.active,
        .sidebar-link:hover {
            background: #e0e7ff;
            color: #0d6efd;
            transform: scale(1.08);
        }

        [data-bs-theme="dark"] .sidebar-link.active,
        [data-bs-theme="dark"] .sidebar-link:hover {
            background: #232946;
            color: #60a5fa;
        }

        .card {
            border-radius: 1rem;
        }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            @await Html.PartialAsync("_Sidebar")

            <div class="col p-0">
                <!-- Navbar-->
                <div>
                    @await Html.PartialAsync("_Navbar2")
                </div>

                <!-- Main Content -->
                <div>
                    <main class="p-4">
                        @RenderBody()
                    </main>
                </div>

                <!-- Production Footer -->
                <footer class="border-top py-2 px-4 text-muted small d-flex justify-content-between align-items-center bg-body-tertiary">
                    <div>
                        <span>&copy; @DateTime.Now.Year FactoryX Mawlid Sweets ERP. جميع الحقوق محفوظة لمصنع حلويات المولد.</span>
                    </div>
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary border">
                            <i class="bi bi-shield-check text-success me-1"></i> @FactoryX.Application.Common.SystemVersionInfo.FullVersionString
                        </span>
                    </div>
                </footer>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme-toggle.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
