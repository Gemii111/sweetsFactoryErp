@model FactoryX.Application.DTOs.SupplierPaymentDto
@{
    ViewData["Title"] = $"تفاصيل سند صرف مورد: {Model.PaymentNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">سند صرف مورد: <span class="font-monospace text-primary">@Model.PaymentNumber</span></h2>
            <span class="badge bg-success-subtle text-success fs-6">@Model.StatusName</span>
        </div>
        <p class="text-muted mb-0">المورد: <strong>@Model.SupplierName</strong> | التاريخ: <strong>@Model.PaymentDate.ToString("yyyy-MM-dd")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>العودة للسندات
        </a>
        <a asp-action="Receipt" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark">
            <i class="bi bi-printer me-1"></i>طباعة إيصال الصرف
        </a>
        <a asp-controller="SupplierLedger" asp-action="Index" asp-route-supplierId="@Model.SupplierId" class="btn btn-outline-info">
            <i class="bi bi-person-lines-fill me-1"></i>كشف حساب المورد
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>بيانات السند</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">المورد</label>
                        <span class="fw-bold fs-5">@Model.SupplierName</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">تاريخ الصرف</label>
                        <span class="fw-semibold">@Model.PaymentDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">طريقة الصرف</label>
                        <span class="badge bg-secondary-subtle text-dark border fs-6">@Model.PaymentMethodName</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">الرقم المرجعي (شيك / تحويل)</label>
                        <span class="font-monospace">@(Model.ReferenceNumber ?? "-")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">سند استلام المشتريات المرتبط (GRN)</label>
                        <span class="font-monospace">@(Model.PurchaseReceiptNumber ?? "-")</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">أمر الشراء المرتبط (PO)</label>
                        <span class="font-monospace">@(Model.PurchaseOrderNumber ?? "-")</span>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small d-block">البيان والملاحظات</label>
                        <span>@(Model.Notes ?? "سداد وصرف مستحقات المورد")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-header bg-transparent py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cash-stack text-primary me-2"></i>المبلغ المسدد</h6>
            </div>
            <div class="card-body d-flex flex-column justify-content-center text-center">
                <div class="text-muted mb-1">المبلغ المصروف والمسدد للمورد</div>
                <div class="display-6 fw-bold text-success font-monospace mb-2">
                    @Model.Amount.ToString("N2")
                </div>
                <div class="fw-bold text-muted">@Model.Currency</div>
                <div class="mt-3">
                    <span class="badge bg-success-subtle text-success p-2">
                        <i class="bi bi-check-circle-fill me-1"></i>تم الترحيل للقيد المحاسبي آلياً
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
