@model FactoryX.Application.DTOs.SupplierPaymentDto
@{
    Layout = null;
    ViewData["Title"] = $"إيصال وسند صرف مورد - {Model.PaymentNumber}";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #fff;
            color: #222;
            padding: 30px;
        }
        .font-monospace {
            font-family: 'JetBrains Mono', monospace !important;
        }
        .receipt-container {
            border: 2px solid #222;
            padding: 30px;
            border-radius: 8px;
            max-width: 800px;
            margin: auto;
        }
        .receipt-header {
            border-bottom: 2px solid #222;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .signature-box {
            border-top: 1px dashed #444;
            margin-top: 60px;
            padding-top: 10px;
            text-align: center;
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
            }
            .receipt-container {
                border: 1px solid #000;
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="receipt-container">
        <div class="no-print text-end mb-4">
            <button onclick="window.print()" class="btn btn-primary px-4">
                <i class="bi bi-printer"></i> طباعة السند (Print)
            </button>
            <button onclick="window.close()" class="btn btn-secondary ms-2">إغلاق</button>
        </div>

        <div class="receipt-header">
            <div class="row align-items-center">
                <div class="col-8">
                    <h3 class="fw-bold mb-1">مصنع حلويات المولد النبوي الشريف</h3>
                    <h5 class="text-muted mb-0">سند صرف نقدي / بنكي (Payment Voucher)</h5>
                </div>
                <div class="col-4 text-end">
                    <h4 class="font-monospace fw-bold text-primary mb-1">@Model.PaymentNumber</h4>
                    <div class="small text-muted">التاريخ: @Model.PaymentDate.ToString("yyyy/MM/dd")</div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <div class="row g-3">
                <div class="col-12">
                    <div class="p-3 bg-light rounded border">
                        <div class="row">
                            <div class="col-8">
                                <span class="text-muted">يُصرف إلى السادة / المورد:</span>
                                <div class="fs-4 fw-bold text-dark mt-1">@Model.SupplierName</div>
                            </div>
                            <div class="col-4 text-end">
                                <span class="text-muted">المبلغ المصروف:</span>
                                <div class="fs-3 fw-bold text-success font-monospace mt-1">@Model.Amount.ToString("N2") @Model.Currency</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <strong>طريقة الصرف:</strong> @Model.PaymentMethodName
                </div>
                <div class="col-6 text-end">
                    <strong>الرقم المرجعي:</strong> @(Model.ReferenceNumber ?? "-")
                </div>

                <div class="col-6">
                    <strong>سند الاستلام المرتبط:</strong> @(Model.PurchaseReceiptNumber ?? "-")
                </div>
                <div class="col-6 text-end">
                    <strong>أمر الشراء المرتبط:</strong> @(Model.PurchaseOrderNumber ?? "-")
                </div>

                <div class="col-12 mt-3">
                    <strong>البيان والغرض:</strong>
                    <div class="p-2 border rounded mt-1">@(Model.Notes ?? "سداد وصرف مستحقات المورد عن توريدات خامات ومشتريات")</div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-4">
                <div class="signature-box">
                    <strong>إعداد الصراف / المحاسب</strong>
                    <div class="small text-muted">@(Model.CreatedByName ?? "المسؤول")</div>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>اعتماد الإدارة المالية</strong>
                    <div class="small text-muted">المدير المالي</div>
                </div>
            </div>
            <div class="col-4">
                <div class="signature-box">
                    <strong>استلام المندوب / المورد</strong>
                    <div class="small text-muted">توقيع المستلم والبطاقة</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
