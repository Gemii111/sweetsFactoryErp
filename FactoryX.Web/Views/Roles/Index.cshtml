@model List<FactoryX.Application.DTOs.RoleItemDto>
@{
    ViewData["Title"] = "إدارة الأدوار ومصفوفة الصلاحيات (RBAC)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-shaded text-primary me-2"></i>إدارة الأدوار والصلاحيات (RBAC)</h2>
        <p class="text-muted mb-0">تحديد الأدوار الوظيفية وضبط مصفوفة الصلاحيات الدقيقة لكل دور</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-1"></i>إضافة دور وظيفي جديد
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">اسم الدور</th>
                        <th>الرمز البرمجي</th>
                        <th>الوصف</th>
                        <th class="text-center">المستخدمون</th>
                        <th class="text-center">الصلاحيات الممنوحة</th>
                        <th>الحالة</th>
                        <th class="text-end pe-3">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">@role.DisplayName</td>
                            <td><span class="badge bg-light text-dark border font-monospace">@role.Code</span></td>
                            <td class="text-muted small">@role.Description</td>
                            <td class="text-center">
                                <span class="badge bg-secondary-subtle text-secondary">@role.UsersCount مستخدم</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border">@role.PermissionsCount صلاحية</span>
                            </td>
                            <td>
                                @if (role.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">معطل</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Permissions" asp-route-id="@role.Id" class="btn btn-outline-primary" title="مصفوفة الصلاحيات">
                                        <i class="bi bi-grid-3x3-gap-fill me-1"></i>الصلاحيات
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-outline-secondary" title="تعديل">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    @if (role.Code != "SUPER_ADMIN")
                                    {
                                        <form asp-action="ToggleStatus" asp-route-id="@role.Id" asp-route-isActive="@(!role.IsActive)" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(role.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(role.IsActive ? "تعطيل الدور" : "تفعيل الدور")">
                                                <i class="bi @(role.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
