@model FactoryX.Application.DTOs.EditRoleRequestDto
@{
    ViewData["Title"] = "تعديل الدور الوظيفي";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>تعديل الدور: @Model.DisplayName</h2>
        <p class="text-muted mb-0">تحديث المسمى والرمز والحالة</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة لقائمة الأدوار
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DisplayName" class="form-label fw-bold">اسم الدور بالعربية <span class="text-danger">*</span></label>
                    <input asp-for="DisplayName" class="form-control" required />
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">اسم الدور بالإنجليزية <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Code" class="form-label fw-bold">الرمز البرمجي (Code) <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control font-monospace text-uppercase" required />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Description" class="form-label fw-bold">الوصف</label>
                    <input asp-for="Description" class="form-control" />
                </div>

                <div class="col-md-6 mt-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="activeRoleSwitch" />
                        <label class="form-check-label fw-bold" for="activeRoleSwitch">دور نشط (Active)</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>حفظ التعديلات</button>
            </div>
        </form>
    </div>
</div>
