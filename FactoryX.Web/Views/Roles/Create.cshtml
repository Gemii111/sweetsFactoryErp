@model FactoryX.Application.DTOs.CreateRoleRequestDto
@{
    ViewData["Title"] = "إضافة دور وظيفي جديد";
    var permissions = ViewBag.Permissions as List<FactoryX.Application.DTOs.PermissionItemDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-plus text-primary me-2"></i>إضافة دور وظيفي جديد</h2>
        <p class="text-muted mb-0">تعريف دور وظيفي جديد وتحديد الصلاحيات المبدئية</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة لقائمة الأدوار
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DisplayName" class="form-label fw-bold">اسم الدور بالعربية <span class="text-danger">*</span></label>
                    <input asp-for="DisplayName" class="form-control" required placeholder="e.g. أخصائي مبيعات كبار العملاء" />
                    <span asp-validation-for="DisplayName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-bold">اسم الدور بالإنجليزية <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required placeholder="e.g. Key Account Sales" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Code" class="form-label fw-bold">الرمز البرمجي (Code) <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control font-monospace text-uppercase" required placeholder="e.g. SALES_KEY_ACCOUNTS" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Description" class="form-label fw-bold">الوصف</label>
                    <input asp-for="Description" class="form-control" placeholder="وصف موجز للمسؤوليات" />
                </div>

                <div class="col-12 mt-4">
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-check2-all me-2"></i>منح الصلاحيات المبدئية للدور:</h5>
                    <div class="row g-2">
                        @foreach (var p in permissions)
                        {
                            <div class="col-md-4">
                                <div class="form-check card p-2 border shadow-none h-100">
                                    <input class="form-check-input ms-2 me-2" type="checkbox" name="SelectedPermissionIds" value="@p.Id" id="perm_@p.Id" />
                                    <label class="form-check-label" for="perm_@p.Id">
                                        <span class="fw-semibold">@p.Name</span>
                                        <small class="d-block text-muted font-monospace">@p.Code</small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>حفظ الدور</button>
            </div>
        </form>
    </div>
</div>
