@model IEnumerable<FactoryX.Application.DTOs.DocumentNumberSettingDto>
@{
    ViewData["Title"] = "تسلسلات وبادئات ترقيم المستندات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-123 text-dark me-2"></i>تسلسلات وبادئات ترقيم المستندات</h2>
        <p class="text-muted mb-0">تحديد البادئات (Prefixes)، تنسيق التواريخ، وأطوال الخانات للترقيم التلقائي</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة للوحة الإعدادات
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">نوع المستند</th>
                        <th>الرمز</th>
                        <th>البادئة (Prefix)</th>
                        <th>تنسيق التاريخ</th>
                        <th>الفاصل</th>
                        <th>طول التسلسل</th>
                        <th>الرقم التالي</th>
                        <th>نموذج الرقم المتوقع</th>
                        <th class="text-end pe-3">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        var sampleSeq = doc.NextSequenceValue.ToString().PadLeft(doc.SequenceWidth, '0');
                        var sampleDate = !string.IsNullOrWhiteSpace(doc.DateFormat) ? DateTime.UtcNow.ToString(doc.DateFormat) : "";
                        var sampleNum = string.IsNullOrWhiteSpace(sampleDate)
                            ? $"{doc.Prefix}{doc.Delimiter}{sampleSeq}"
                            : $"{doc.Prefix}{doc.Delimiter}{sampleDate}{doc.Delimiter}{sampleSeq}";

                        <tr>
                            <td class="ps-3 fw-bold">@doc.DocumentTypeNameArabic</td>
                            <td><span class="badge bg-secondary font-monospace">@doc.DocumentType</span></td>
                            <td><span class="badge bg-primary font-monospace">@doc.Prefix</span></td>
                            <td><code>@(string.IsNullOrWhiteSpace(doc.DateFormat) ? "(بدون تاريخ)" : doc.DateFormat)</code></td>
                            <td><kbd>@doc.Delimiter</kbd></td>
                            <td>@doc.SequenceWidth خانات</td>
                            <td><span class="fw-bold text-success">@doc.NextSequenceValue</span></td>
                            <td><span class="badge bg-light text-dark border font-monospace fs-6">@sampleNum</span></td>
                            <td class="text-end pe-3">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick='openEditNumberingModal(@Json.Serialize(doc))'>
                                    <i class="bi bi-pencil-fill me-1"></i>تعديل الصيغة
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Numbering Modal -->
<div class="modal fade" id="numberingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SaveNumbering" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="numberingModalLabel">تعديل صيغة ترقيم المستند</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="numId" name="Id" />
                    <input type="hidden" id="numDocType" name="DocumentType" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">اسم المستند</label>
                        <input type="text" class="form-control" id="numDocName" name="DocumentTypeNameArabic" readonly />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">البادئة (Prefix)</label>
                            <input type="text" class="form-control font-monospace text-uppercase" id="numPrefix" name="Prefix" required maxlength="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">الفاصل (Delimiter)</label>
                            <input type="text" class="form-control font-monospace" id="numDelimiter" name="Delimiter" required maxlength="3" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">تنسيق التاريخ</label>
                            <select class="form-select font-monospace" id="numDateFormat" name="DateFormat">
                                <option value="yyyyMMdd">yyyyMMdd (20260902)</option>
                                <option value="yyyyMM">yyyyMM (202609)</option>
                                <option value="yyMMdd">yyMMdd (260902)</option>
                                <option value="yyyy">yyyy (2026)</option>
                                <option value="">(بدون تاريخ)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">عدد خانات التسلسل (Width)</label>
                            <input type="number" min="1" max="10" class="form-control" id="numWidth" name="SequenceWidth" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">الرقم التسلسلي التالي (Next Sequence)</label>
                        <input type="number" min="1" class="form-control" id="numNextValue" name="NextSequenceValue" required />
                        <small class="text-muted">الرقم التسلسلي القادم الذي سيتم إسناده تلقائياً للمستند الجديد</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">الوصف / ملاحظات</label>
                        <textarea class="form-control" id="numDescription" name="Description" rows="2"></textarea>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="numIsActive" name="IsActive" value="true" />
                        <label class="form-check-label" for="numIsActive">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ صيغة الترقيم</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEditNumberingModal(doc) {
        document.getElementById('numId').value = doc.id;
        document.getElementById('numDocType').value = doc.documentType;
        document.getElementById('numDocName').value = doc.documentTypeNameArabic;
        document.getElementById('numPrefix').value = doc.prefix;
        document.getElementById('numDelimiter').value = doc.delimiter;
        document.getElementById('numDateFormat').value = doc.dateFormat || '';
        document.getElementById('numWidth').value = doc.sequenceWidth;
        document.getElementById('numNextValue').value = doc.nextSequenceValue;
        document.getElementById('numDescription').value = doc.description || '';
        document.getElementById('numIsActive').checked = doc.isActive;

        var modal = new bootstrap.Modal(document.getElementById('numberingModal'));
        modal.show();
    }
</script>
