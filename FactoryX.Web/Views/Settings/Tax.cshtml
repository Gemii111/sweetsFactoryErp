@model IEnumerable<FactoryX.Application.DTOs.TaxSettingDto>
@{
    ViewData["Title"] = "إعدادات الضرائب وضريبة القيمة المضافة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-percent text-success me-2"></i>إعدادات الضرائب وضريبة القيمة المضافة (VAT)</h2>
        <p class="text-muted mb-0">تعريف وإدارة نسب الضرائب وتحديد الضريبة الافتراضية المطبقة على المعاملات المالية</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#taxModal" onclick="openCreateModal()">
            <i class="bi bi-plus-circle me-1"></i>إضافة ضريبة جديدة
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>العودة للوحة الإعدادات
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">اسم الضريبة</th>
                        <th>الرمز البرمجي (Code)</th>
                        <th>النسبة المئوية (%)</th>
                        <th>تاريخ السريان</th>
                        <th>تاريخ الانتهاء</th>
                        <th>الافتراضية</th>
                        <th>الحالة</th>
                        <th class="text-end pe-3">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tax in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@tax.Name</td>
                            <td><span class="badge bg-light text-dark border font-monospace">@tax.Code</span></td>
                            <td><span class="fw-bold fs-6 text-success">@tax.Rate.ToString("N2")%</span></td>
                            <td>@tax.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                            <td>@(tax.EffectiveTo?.ToString("yyyy-MM-dd") ?? "سارية بشكل دائم")</td>
                            <td>
                                @if (tax.IsDefault)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-star-fill me-1"></i>افتراضية للنظام</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">ثانوية / خاصة</span>
                                }
                            </td>
                            <td>
                                @if (tax.IsActive)
                                {
                                    <span class="badge bg-success">نشطة</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">معطلة</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary" onclick='openEditModal(@Json.Serialize(tax))' title="تعديل">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    @if (!tax.IsDefault)
                                    {
                                        <form asp-action="ToggleTaxStatus" asp-route-id="@tax.Id" asp-route-isActive="@(!tax.IsActive)" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(tax.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(tax.IsActive ? "تعطيل" : "تفعيل")">
                                                <i class="bi @(tax.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal for Create / Edit Tax -->
<div class="modal fade" id="taxModal" tabindex="-1" aria-labelledby="taxModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SaveTax" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="taxModalLabel">إعداد الضريبة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="taxId" name="Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">اسم الضريبة</label>
                        <input type="text" class="form-control" id="taxName" name="Name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">رمز الضريبة (Code)</label>
                        <input type="text" class="form-control font-monospace" id="taxCode" name="Code" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">النسبة المئوية (%)</label>
                        <input type="number" step="0.01" min="0" max="100" class="form-control" id="taxRate" name="Rate" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">تاريخ بدء السريان</label>
                            <input type="date" class="form-control" id="taxEffectiveFrom" name="EffectiveFrom" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">تاريخ الانتهاء (اختياري)</label>
                            <input type="date" class="form-control" id="taxEffectiveTo" name="EffectiveTo" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">الوصف / ملاحظات</label>
                        <textarea class="form-control" id="taxDescription" name="Description" rows="2"></textarea>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="taxIsDefault" name="IsDefault" value="true" />
                        <label class="form-check-label fw-bold" for="taxIsDefault">تعيين كضريبة افتراضية للنظام</label>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="taxIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label" for="taxIsActive">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">حفظ الضريبة</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCreateModal() {
        document.getElementById('taxModalLabel').innerText = 'إضافة ضريبة جديدة';
        document.getElementById('taxId').value = 0;
        document.getElementById('taxName').value = '';
        document.getElementById('taxCode').value = '';
        document.getElementById('taxRate').value = '14.00';
        document.getElementById('taxEffectiveFrom').value = new Date().toISOString().split('T')[0];
        document.getElementById('taxEffectiveTo').value = '';
        document.getElementById('taxDescription').value = '';
        document.getElementById('taxIsDefault').checked = false;
        document.getElementById('taxIsActive').checked = true;
    }

    function openEditModal(tax) {
        document.getElementById('taxModalLabel').innerText = 'تعديل إعداد الضريبة: ' + tax.name;
        document.getElementById('taxId').value = tax.id;
        document.getElementById('taxName').value = tax.name;
        document.getElementById('taxCode').value = tax.code;
        document.getElementById('taxRate').value = tax.rate;
        document.getElementById('taxEffectiveFrom').value = tax.effectiveFrom.split('T')[0];
        document.getElementById('taxEffectiveTo').value = tax.effectiveTo ? tax.effectiveTo.split('T')[0] : '';
        document.getElementById('taxDescription').value = tax.description || '';
        document.getElementById('taxIsDefault').checked = tax.isDefault;
        document.getElementById('taxIsActive').checked = tax.isActive;

        var modal = new bootstrap.Modal(document.getElementById('taxModal'));
        modal.show();
    }
</script>
