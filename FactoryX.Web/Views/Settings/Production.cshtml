@model FactoryX.Application.DTOs.OperationalDefaultsDto
@{
    ViewData["Title"] = "ضوابط ومحددات الإنتاج والهوالك";
    var warehouses = ViewBag.Warehouses as List<FactoryX.Domain.Entities.Warehouse> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-gear-wide-connected text-danger me-2"></i>ضوابط ومحددات الإنتاج والهوالك</h2>
        <p class="text-muted mb-0">ضبط مستودعات صالة التشغيل، نسب التسامح في الفاقد والتوالف، وسياسات الاعتماد</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة للوحة الإعدادات
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Production" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">مستودعات صالة الإنتاج والتشغيل</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="DefaultProductionWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultProductionWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع صالة الإنتاج والتشغيل --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultProductionWarehouseId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DefaultQuarantineWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultQuarantineWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع الفحص وحجر الجودة --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultQuarantineWarehouseId" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">نسب التسامح والرقابة على الهدر والتوالف</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="MaxWasteTolerancePercent" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="MaxWasteTolerancePercent" class="form-control" type="number" step="0.1" min="0" max="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <small class="text-muted">الحد الأقصى لنسبة الهدر المسموحة في دورة تصنيع الدفعة قبل إطلاق تحذير جودة</small>
                    <span asp-validation-for="MaxWasteTolerancePercent" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="RequireWasteApproval" class="form-check-input" type="checkbox" />
                        <label asp-for="RequireWasteApproval" class="form-check-label fw-bold"></label>
                        <div class="text-muted small">إلزامية موافقة مدير الإنتاج / الجودة قبل تسوية وخصم الهالك مالياً ومخزنياً</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-save me-1"></i>حفظ ضوابط الإنتاج
                </button>
            </div>
        </form>
    </div>
</div>
