@model FactoryX.Application.DTOs.OperationalDefaultsDto
@{
    ViewData["Title"] = "محددات وضوابط المخزون";
    var warehouses = ViewBag.Warehouses as List<FactoryX.Domain.Entities.Warehouse> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-boxes text-warning me-2"></i>محددات وضوابط المخزون والمستودعات</h2>
        <p class="text-muted mb-0">تحديد المستودعات الافتراضية للخامات والمنتجات وحدود الأمان والتنبيهات</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة للوحة الإعدادات
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Inventory" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">المستودعات التشغيلية الافتراضية</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="DefaultRawMaterialWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultRawMaterialWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع الخامات الافتراضي --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultRawMaterialWarehouseId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DefaultPackagingWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultPackagingWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع مواد التعبئة والتغليف الافتراضي --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultPackagingWarehouseId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DefaultFinishedGoodsWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultFinishedGoodsWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع المنتجات التامة الافتراضي --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultFinishedGoodsWarehouseId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DefaultQuarantineWarehouseId" class="form-label fw-bold"></label>
                    <select asp-for="DefaultQuarantineWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع الحجر والفحص الافتراضي --</option>
                        @foreach (var wh in warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                    <span asp-validation-for="DefaultQuarantineWarehouseId" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">حدود الأمان وسياسات المخزون</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="LowStockWarningThreshold" class="form-label fw-bold"></label>
                    <input asp-for="LowStockWarningThreshold" class="form-control" type="number" step="0.01" />
                    <small class="text-muted">يتم إطلاق تنبيه عند انخفاض رصيد المادة عن هذه القيمة</small>
                    <span asp-validation-for="LowStockWarningThreshold" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExpiryWarningDays" class="form-label fw-bold"></label>
                    <input asp-for="ExpiryWarningDays" class="form-control" type="number" min="1" max="365" />
                    <small class="text-muted">عدد الأيام قبل انتهاء الصلاحية لإظهار التحذير في اللوحات الرقابية</small>
                    <span asp-validation-for="ExpiryWarningDays" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch mt-3">
                        <input asp-for="AllowNegativeStock" class="form-check-input" type="checkbox" />
                        <label asp-for="AllowNegativeStock" class="form-check-label fw-bold"></label>
                        <div class="text-muted small">حظر الصرف عند عدم توفر رصيد كافٍ في المستودع</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch mt-3">
                        <input asp-for="RequireLotTracking" class="form-check-input" type="checkbox" />
                        <label asp-for="RequireLotTracking" class="form-check-label fw-bold"></label>
                        <div class="text-muted small">إلزامية تحديد أرقام التشغيلات وتواريخ الصلاحية عند الصرف والاستلام</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-warning text-dark px-4 fw-bold">
                    <i class="bi bi-save me-1"></i>حفظ ضوابط المخزون
                </button>
            </div>
        </form>
    </div>
</div>
