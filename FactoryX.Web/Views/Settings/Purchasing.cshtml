@model FactoryX.Application.DTOs.OperationalDefaultsDto
@{
    ViewData["Title"] = "محددات وضوابط المشتريات";
    var warehouses = ViewBag.Warehouses as List<FactoryX.Domain.Entities.Warehouse> ?? new();
    var requirePOApproval = (bool)(ViewBag.RequirePOApproval ?? true);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cart-check text-secondary me-2"></i>محددات وضوابط المشتريات والتوريد</h2>
        <p class="text-muted mb-0">ضبط مستودعات الاستلام الافتراضية وإلزامية مسارات الاعتماد لأوامر الشراء</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة للوحة الإعدادات
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Purchasing" method="post">
            @Html.AntiForgeryToken()

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">مستودعات استلام التوريدات الافتراضية</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">مستودع استلام المواد الخام الافتراضي (GRN)</label>
                    <select name="defaultRawWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع استلام المواد الخام --</option>
                        @foreach (var wh in warehouses)
                        {
                            if (Model.DefaultRawMaterialWarehouseId == wh.Id)
                            {
                                <option value="@wh.Id" selected>@wh.Name (@wh.Code)</option>
                            }
                            else
                            {
                                <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">مستودع استلام مواد التعبئة الافتراضي (GRN)</label>
                    <select name="defaultPackagingWarehouseId" class="form-select">
                        <option value="">-- اختر مستودع استلام مواد التعبئة --</option>
                        @foreach (var wh in warehouses)
                        {
                            if (Model.DefaultPackagingWarehouseId == wh.Id)
                            {
                                <option value="@wh.Id" selected>@wh.Name (@wh.Code)</option>
                            }
                            else
                            {
                                <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">سياسات الاعتماد والرقابة</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="requirePOApproval" name="requirePOApproval" value="true" @(requirePOApproval ? "checked" : "") />
                        <label class="form-check-label fw-bold" for="requirePOApproval">إلزامية اعتماد أمر الشراء من الإدارة</label>
                        <div class="text-muted small">منع إصدار سند الاستلام المخزني (GRN) إلا بعد اعتماد أمر الشراء رسمياً</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-secondary px-4">
                    <i class="bi bi-save me-1"></i>حفظ ضوابط المشتريات
                </button>
            </div>
        </form>
    </div>
</div>
