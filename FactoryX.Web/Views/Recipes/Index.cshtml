@model IEnumerable<FactoryX.Application.DTOs.RecipeDto>
@{
    ViewData["Title"] = "الوصفات وقوائم المواد المعيارية (Recipes / BOM)";
    var search = ViewBag.Search as string;
    var productId = ViewBag.ProductId as int?;
    var isActive = ViewBag.IsActive as bool?;
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.RecipeSummaryDto;
    var products = ViewBag.Products as SelectList;
}

<div class="container-fluid py-4" dir="rtl">
    @await Html.PartialAsync("_Alert")

    <!-- رأس الصفحة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-richtext text-danger me-2"></i>الوصفات وقوائم المواد المعيارية (Recipes / BOM)
            </h2>
            <p class="text-muted mb-0">إدارة خلطات ومقادير حلويات المولد (السمسمية، الفولية، الحمصية، الملبن، النوجا، العلب المشكلة...) واحتساب تكاليف التشغيل.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-box-seam me-1"></i> قائمة المنتجات التامة
            </a>
            <a asp-action="Create" class="btn btn-danger rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> إضافة وصفة جديدة
            </a>
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    @if (summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-danger border-4 text-center">
                    <span class="text-muted small d-block">إجمالي الوصفات</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@summary.TotalRecipes</h3>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-success border-4 text-center">
                    <span class="text-muted small d-block">الوصفات النشطة</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@summary.ActiveRecipes</h3>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-primary border-4 text-center">
                    <span class="text-muted small d-block">إجمالي الإصدارات</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@summary.TotalVersions</h3>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-success border-4 text-center">
                    <span class="text-muted small d-block">الإصدارات النشطة</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@summary.ActiveVersions</h3>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-warning border-4 text-center">
                    <span class="text-muted small d-block">مسودات الإصدارات</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@summary.DraftVersions</h3>
                </div>
            </div>
            <div class="col-md-2 col-sm-4 col-6">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-info border-4 text-center">
                    <span class="text-muted small d-block">منتجات لها وصفات</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@summary.ProductsWithRecipesCount</h3>
                </div>
            </div>
        </div>
    }

    <!-- شريط البحث والفلترة -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-0" placeholder="بحث باسم الوصفة، الكود، أو المنتج..." value="@search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="productId" class="form-select bg-light border-0" asp-items="products">
                        <option value="">جميع المنتجات التامة</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="isActive" class="form-select bg-light border-0">
                        <option value="">جميع الحالات</option>
                        <option value="true" selected="@(isActive == true ? "selected" : null)">نشط فقط</option>
                        <option value="false" selected="@(isActive == false ? "selected" : null)">معطل فقط</option>
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-dark rounded-pill w-100"><i class="bi bi-funnel"></i></button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-2" title="إعادة تعيين"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- جدول عرض الوصفات -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-secondary">كود الوصفة</th>
                        <th class="py-3 px-4 text-secondary">اسم الوصفة</th>
                        <th class="py-3 px-4 text-secondary">المنتج التام المستهدف</th>
                        <th class="py-3 px-4 text-secondary text-center">التشغيلة المعيارية</th>
                        <th class="py-3 px-4 text-secondary text-center">الإصدار النشط</th>
                        <th class="py-3 px-4 text-secondary text-end">التكلفة التقديرية / كجم</th>
                        <th class="py-3 px-4 text-secondary text-center">الحالة</th>
                        <th class="py-3 px-4 text-secondary text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                لا توجد وصفات مسجلة مطابقة لمعايير البحث.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-danger font-monospace">@item.Code</td>
                                <td class="px-4">
                                    <span class="fw-semibold text-dark d-block">@item.Name</span>
                                    @if (!string.IsNullOrEmpty(item.ArabicName))
                                    {
                                        <span class="text-muted small">@item.ArabicName</span>
                                    }
                                </td>
                                <td class="px-4">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-box-seam me-1"></i> @item.ProductName
                                    </span>
                                </td>
                                <td class="px-4 text-center fw-semibold text-dark">
                                    @item.BaseOutputQuantity.ToString("N0") @item.Unit
                                </td>
                                <td class="px-4 text-center">
                                    @if (!string.IsNullOrEmpty(item.ActiveVersionNumber))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 font-monospace">
                                            <i class="bi bi-check-circle me-1"></i> @item.ActiveVersionNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-exclamation-triangle me-1"></i> بدون إصدار نشط
                                        </span>
                                    }
                                    <span class="text-muted small d-block mt-1">(@item.VersionCount إصدار)</span>
                                </td>
                                <td class="px-4 text-end fw-bold text-success">
                                    @if (item.ActiveVersionCostPerUnit.HasValue)
                                    {
                                        <span>@item.ActiveVersionCostPerUnit.Value.ToString("N2") ج.م</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="px-4 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">معطل</span>
                                    }
                                </td>
                                <td class="px-4 text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-circle shadow-none" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye text-primary me-2"></i> تفاصيل الوصفة والإصدارات
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="CreateVersion" asp-route-recipeId="@item.Id">
                                                    <i class="bi bi-plus-circle text-success me-2"></i> إضافة إصدار جديد (BOM)
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil text-warning me-2"></i> تعديل بيانات الوصفة
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2">
                                                        @if (item.IsActive)
                                                        {
                                                            <span><i class="bi bi-slash-circle text-secondary me-2"></i> تعطيل الوصفة</span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-check2-circle text-success me-2"></i> تنشيط الوصفة</span>
                                                        }
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذه الوصفة وكافة إصداراتها؟');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                                        <i class="bi bi-trash me-2"></i> حذف الوصفة
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
