@model FactoryX.Application.DTOs.RecipeVersionDto
@{
    ViewData["Title"] = $"تفاصيل الإصدار {Model.VersionNumber} - {Model.RecipeName}";
    var totalQty = Model.Items?.Sum(i => i.Quantity) ?? 0m;
}

<div class="container-fluid py-4" dir="rtl">
    @await Html.PartialAsync("_Alert")

    <!-- رأس الصفحة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 font-monospace fs-6">
                    @Model.RecipeCode
                </span>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 font-monospace fs-6">
                    @Model.VersionNumber
                </span>
                <h3 class="fw-bold text-dark mb-0">@(string.IsNullOrEmpty(Model.VersionName) ? Model.RecipeName : Model.VersionName)</h3>
            </div>
            <p class="text-muted mb-0">الوصفة المعيارية: <span class="fw-bold text-dark">@Model.RecipeName</span> | المنتج التام: <span class="badge bg-primary-subtle text-primary">@Model.ProductName</span></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.RecipeId" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-right me-1"></i> العودة للوصفة
            </a>

            @if (Model.Status == FactoryX.Domain.Entities.RecipeStatus.Draft)
            {
                <a asp-action="EditVersion" asp-route-versionId="@Model.Id" class="btn btn-outline-warning rounded-pill px-3">
                    <i class="bi bi-pencil me-1"></i> تعديل المسودة وقائمة المواد
                </a>
                <form asp-action="ActivateVersion" asp-route-versionId="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm" onclick="return confirm('هل تريد اعتماد وتنشيط هذا الإصدار ليصبح سارياً في خطط الإنتاج؟');">
                        <i class="bi bi-check2-circle me-1"></i> اعتماد وتنشيط الإصدار
                    </button>
                </form>
            }
            else if (Model.Status == FactoryX.Domain.Entities.RecipeStatus.Active)
            {
                <form asp-action="DeactivateVersion" asp-route-versionId="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary rounded-pill px-3" onclick="return confirm('هل أنت متأكد من إيقاف تنشيط هذا الإصدار؟');">
                        <i class="bi bi-slash-circle me-1"></i> إيقاف التنشيط
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- ملخص بيانات الإصدار -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    <i class="bi bi-info-circle text-danger me-2"></i>معلومات الإصدار وسريانه
                </h5>
                <div class="d-flex flex-column gap-3">
                    <div>
                        <span class="text-muted small d-block">حالة الإصدار</span>
                        @switch (Model.Status)
                        {
                            case FactoryX.Domain.Entities.RecipeStatus.Active:
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 fs-6">
                                    <i class="bi bi-check-circle me-1"></i> نشط ومعتمد (Active)
                                </span>
                                break;
                            case FactoryX.Domain.Entities.RecipeStatus.Draft:
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 fs-6">
                                    <i class="bi bi-pencil me-1"></i> مسودة (Draft)
                                </span>
                                break;
                            case FactoryX.Domain.Entities.RecipeStatus.Inactive:
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 fs-6">
                                    <i class="bi bi-dash-circle me-1"></i> معطل (Inactive)
                                </span>
                                break;
                        }
                    </div>

                    <div>
                        <span class="text-muted small d-block">فترة السريان</span>
                        <div class="bg-light p-3 rounded-3 small">
                            <div><span class="text-muted">تاريخ البدء:</span> <span class="fw-bold">@Model.EffectiveFrom.ToString("yyyy-MM-dd")</span></div>
                            @if (Model.EffectiveTo.HasValue)
                            {
                                <div><span class="text-muted">تاريخ الانتهاء:</span> <span class="fw-bold">@Model.EffectiveTo.Value.ToString("yyyy-MM-dd")</span></div>
                            }
                            else
                            {
                                <div><span class="text-muted">تاريخ الانتهاء:</span> <span class="badge bg-light text-muted border">سارٍ بدون تاريخ انتهاء</span></div>
                            }
                        </div>
                    </div>

                    <div>
                        <span class="text-muted small d-block">الكمية المستهدفة للتشغيلة المعيارية</span>
                        <span class="fw-bold text-dark fs-5">@Model.ExpectedOutput.ToString("N0") @Model.OutputUnit</span>
                    </div>

                    <div>
                        <span class="text-muted small d-block">نسبة الهالك المعياري المتوقع</span>
                        <span class="fw-bold text-danger fs-5">@Model.ExpectedWastePercentage.ToString("N1")%</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div>
                            <span class="text-muted small d-block">ملاحظات الإصدار</span>
                            <p class="text-secondary small mb-0 bg-light p-3 rounded-3">@Model.Notes</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- بطاقة احتساب التكاليف الشفافة -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-calculator text-primary me-2"></i>هيكل التكاليف التقديرية للتشغيلة (Cost Sheet)
                    </h5>
                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">
                        <i class="bi bi-broadcast me-1"></i> احتساب ديناميكي حي
                    </span>
                </div>

                @if (Model.CostBreakdown != null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-md-3 col-6">
                            <div class="bg-light p-3 rounded-3 text-center">
                                <span class="text-muted small d-block">تكلفة الخامات (BOM)</span>
                                <h5 class="fw-bold text-dark mb-0 mt-1">@Model.CostBreakdown.MaterialCost.ToString("N2") ج.م</h5>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="bg-light p-3 rounded-3 text-center">
                                <span class="text-muted small d-block">تكلفة العمالة</span>
                                <h5 class="fw-bold text-dark mb-0 mt-1">@Model.CostBreakdown.LaborCost.ToString("N2") ج.م</h5>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="bg-light p-3 rounded-3 text-center">
                                <span class="text-muted small d-block">تكلفة الماكينات</span>
                                <h5 class="fw-bold text-dark mb-0 mt-1">@Model.CostBreakdown.MachineCost.ToString("N2") ج.م</h5>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="bg-light p-3 rounded-3 text-center">
                                <span class="text-muted small d-block">المصاريف غير المباشرة</span>
                                <h5 class="fw-bold text-dark mb-0 mt-1">@Model.CostBreakdown.OverheadCost.ToString("N2") ج.م</h5>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="bg-danger-subtle border border-danger-subtle p-3 rounded-3 text-center">
                                <span class="text-danger small d-block">تكلفة الهالك المتوقع (@Model.ExpectedWastePercentage.ToString("N1")%)</span>
                                <h4 class="fw-bold text-danger mb-0 mt-1">@Model.CostBreakdown.WasteCost.ToString("N2") ج.م</h4>
                                <small class="text-muted d-block mt-1">تكلفة الخامات × نسبة الهالك</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-dark text-white p-3 rounded-3 text-center">
                                <span class="text-light small d-block">إجمالي تكلفة التشغيلة (@Model.ExpectedOutput.ToString("N0") @Model.OutputUnit)</span>
                                <h4 class="fw-bold text-white mb-0 mt-1">@Model.CostBreakdown.TotalCost.ToString("N2") ج.م</h4>
                                <small class="text-secondary d-block mt-1">الخامات + العمالة + الماكينات + الهالك</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="bg-success text-white p-3 rounded-3 text-center">
                                <span class="text-light small d-block">التكلفة التقديرية / @Model.OutputUnit</span>
                                <h3 class="fw-bold text-white mb-0 mt-1">@Model.CostBreakdown.CostPerOutputUnit.ToString("N2") ج.م</h3>
                                <small class="text-light-50 d-block mt-1">إجمالي التكلفة ÷ كمية المخرجات</small>
                            </div>
                        </div>
                    </div>
                }

                <div class="alert alert-secondary rounded-3 mt-4 mb-0 py-2 small d-flex align-items-center">
                    <i class="bi bi-info-circle me-2 fs-5"></i>
                    <span><strong>ملاحظة شفافية التسعير:</strong> يتم احتساب تكلفة الوصفة في هذه المرحلة ديناميكياً استناداً للأسعار الحالية للمواد الخام (Material Current Cost). التكاليف التاريخية للتشغيلات الفعلية ترتبط بمراحل أوامر الإنتاج والتكاليف لاحقاً.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول قائمة المواد BOM Items -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-card-checklist text-danger me-2"></i>قائمة المواد الخام والمكونات (Bill of Materials - BOM)
                </h5>
                <small class="text-muted">المقادير والمعايير اللازمة لإنتاج تشغيلة معيارية بحجم @Model.ExpectedOutput.ToString("N0") @Model.OutputUnit</small>
            </div>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@(Model.Items?.Count ?? 0) خامات</span>
        </div>

        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-exclamation-circle fs-2 d-block mb-2 text-warning"></i>
                لم يتم إضافة أي خامات في هذا الإصدار بعد.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center text-secondary" style="width: 5%;">#</th>
                            <th class="text-secondary" style="width: 15%;">كود الخامة</th>
                            <th class="text-secondary" style="width: 30%;">اسم المادة الخام</th>
                            <th class="text-center text-secondary" style="width: 15%;">الكمية المطلوبة</th>
                            <th class="text-center text-secondary" style="width: 10%;">نسبة المكون (%)</th>
                            <th class="text-end text-secondary" style="width: 12%;">سعر التكلفة الحالي</th>
                            <th class="text-end text-secondary" style="width: 13%;">إجمالي تكلفة الخامة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.Sequence))
                        {
                            <tr>
                                <td class="text-center text-muted fw-bold">@item.Sequence</td>
                                <td class="fw-bold font-monospace text-danger">@item.MaterialCode</td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@item.MaterialName</span>
                                    @if (!string.IsNullOrEmpty(item.MaterialArabicName))
                                    {
                                        <span class="text-muted small">@item.MaterialArabicName</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark">
                                    @item.Quantity.ToString("N2") @item.Unit
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(totalQty > 0 ? (item.Quantity / totalQty * 100m).ToString("N1") : "0")%
                                    </span>
                                </td>
                                <td class="text-end text-muted font-monospace">
                                    @item.UnitCost.ToString("N2") ج.م
                                </td>
                                <td class="text-end fw-bold text-dark font-monospace">
                                    @item.TotalCost.ToString("N2") ج.م
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end text-dark">الإجمالي المعياري للدفعة:</td>
                            <td class="text-center text-dark font-monospace">@totalQty.ToString("N2") كجم</td>
                            <td class="text-center">100%</td>
                            <td class="text-end text-muted">إجمالي تكلفة الخامات:</td>
                            <td class="text-end text-danger fs-6 font-monospace">@(Model.Items.Sum(i => i.TotalCost).ToString("N2")) ج.م</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>
