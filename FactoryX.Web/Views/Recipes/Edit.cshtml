@model FactoryX.Application.DTOs.UpdateRecipeRequest
@{
    ViewData["Title"] = "تعديل الوصفة (Edit Recipe)";
    var products = ViewBag.Products as SelectList;
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold text-dark mb-1">
                                <i class="bi bi-pencil-square text-warning me-2"></i>تعديل بيانات الوصفة المعيارية
                            </h4>
                            <p class="text-muted small mb-0">تعديل كود واسم ووصف الوصفة الرئيسية.</p>
                        </div>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                            <i class="bi bi-arrow-right me-1"></i> العودة لتفاصيل الوصفة
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="ProductId" class="form-label fw-semibold text-secondary">المنتج التام المستهدف <span class="text-danger">*</span></label>
                                <select asp-for="ProductId" class="form-select rounded-3 py-2" asp-items="products">
                                    <option value="">-- اختر المنتج التام --</option>
                                </select>
                                <span asp-validation-for="ProductId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label fw-semibold text-secondary">كود الوصفة <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control font-monospace rounded-3 py-2" />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary">اسم الوصفة <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ArabicName" class="form-label fw-semibold text-secondary">الاسم العربي للوصفة</label>
                                <input asp-for="ArabicName" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="ArabicName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="BaseOutputQuantity" class="form-label fw-semibold text-secondary">كمية التشغيلة المعيارية <span class="text-danger">*</span></label>
                                <input asp-for="BaseOutputQuantity" type="number" step="0.01" class="form-control rounded-3 py-2" />
                                <span asp-validation-for="BaseOutputQuantity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Unit" class="form-label fw-semibold text-secondary">وحدة المخرجات</label>
                                <select asp-for="Unit" class="form-select rounded-3 py-2">
                                    <option value="KG" selected="@(Model.Unit == "KG" ? "selected" : null)">كجم (KG)</option>
                                    <option value="علبة" selected="@(Model.Unit == "علبة" ? "selected" : null)">علبة</option>
                                    <option value="قطعة" selected="@(Model.Unit == "قطعة" ? "selected" : null)">قطعة</option>
                                    <option value="كرتونة" selected="@(Model.Unit == "كرتونة" ? "selected" : null)">كرتونة</option>
                                    <option value="طبق" selected="@(Model.Unit == "طبق" ? "selected" : null)">طبق</option>
                                </select>
                                <span asp-validation-for="Unit" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch py-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                                    <label class="form-check-label fw-semibold text-dark" for="isActiveSwitch">الوصفة نشطة ومتاحة للاستخدام</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold text-secondary">وصف الوصفة وملاحظات</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4">إلغاء</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4">
                                <i class="bi bi-check2-circle me-1"></i> حفظ التعديلات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
