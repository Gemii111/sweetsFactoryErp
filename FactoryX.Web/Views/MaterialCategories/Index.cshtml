@model IEnumerable<FactoryX.Application.DTOs.MaterialCategoryDto>
@{
    ViewData["Title"] = "تصنيفات المواد الخام";
    var currentSearch = ViewBag.Search as string;
    var currentIsActive = ViewBag.IsActive as bool?;
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_Alert")

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-tags-fill text-primary me-2"></i>تصنيفات المواد الخام</h2>
            <p class="text-muted mb-0">إدارة تصنيفات مدخلات الإنتاج (المكسرات والسمسم، السكريات والمحليات، الزيوت، الألبان، النكهات والألوان، مواد التعبئة والتغليف...).</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد
        </a>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 bg-light" placeholder="بحث بالاسم، الرمز، أو الوصف..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="isActive" class="form-select bg-light">
                        <option value="">-- جميع الحالات --</option>
                        <option value="true" selected="@(currentIsActive == true ? "selected" : null)">النشطة فقط</option>
                        <option value="false" selected="@(currentIsActive == false ? "selected" : null)">غير النشطة (المعطلة)</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 rounded-pill"><i class="bi bi-funnel-fill me-1"></i> تصفية</button>
                    @if (!string.IsNullOrEmpty(currentSearch) || currentIsActive.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-x-circle"></i> إلغاء</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Category Grid -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 h-100 bg-white hover-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@item.Name</h5>
                                <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">@item.Code</span>
                            </div>
                            <span class="badge bg-@(item.IsActive ? "success-subtle text-success" : "secondary-subtle text-secondary") rounded-pill px-3 py-1">
                                @(item.IsActive ? "نشط" : "معطل")
                            </span>
                        </div>

                        <p class="text-muted small mb-4" style="min-height: 40px;">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "لا يوجد وصف إضافي لهذا التصنيف." : item.Description)
                        </p>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <div class="text-muted small">
                                <i class="bi bi-box-seam me-1"></i> الخامات المرتبطة: <span class="fw-bold text-primary">@item.MaterialCount</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="تفاصيل"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm rounded-pill px-3" title="تعديل"><i class="bi bi-pencil"></i></a>
                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-@(item.IsActive ? "secondary" : "success") btn-sm rounded-pill px-2" title="@(item.IsActive ? "تعطيل التصنيف" : "تفعيل التصنيف")">
                                        <i class="bi bi-@(item.IsActive ? "slash-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4 text-center rounded-4 p-5 shadow-sm">
            <i class="bi bi-tags fs-1 text-primary d-block mb-3"></i>
            <h5 class="fw-bold">لا توجد تصنيفات مطابقة</h5>
            <p class="text-muted mb-3">لم يتم العثور على تصنيفات تطابق معايير البحث المحددة، أو لم يتم إضافة تصنيفات بعد.</p>
            <a asp-action="Create" class="btn btn-primary px-4 rounded-pill"><i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد</a>
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
    }
</style>
