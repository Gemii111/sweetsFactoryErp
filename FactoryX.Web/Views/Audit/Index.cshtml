@model List<FactoryX.Application.DTOs.AuditLogItemDto>
@{
    ViewData["Title"] = "سجل التدقيق والرقابة (Audit Trail)";
    var users = ViewBag.Users as List<FactoryX.Application.DTOs.UserAdminItemDto> ?? new();
    var filter = ViewBag.Filter as FactoryX.Application.DTOs.AuditLogFilterDto ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>سجل التدقيق وتتبع العمليات (Audit Trail)</h2>
        <p class="text-muted mb-0">سجل غير قابل للتعديل (Append-Only) لتوثيق كافة العمليات الحساسة في النظام</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Security" asp-action="Dashboard" class="btn btn-outline-info">
            <i class="bi bi-speedometer2 me-1"></i>لوحة الأمان
        </a>
        <a asp-controller="Security" asp-action="Events" class="btn btn-outline-secondary">
            <i class="bi bi-shield-exclamation me-1"></i>الأحداث الأمنية
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">من تاريخ</label>
                <input type="date" name="FromDate" class="form-control form-control-sm" value="@(filter.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                <input type="date" name="ToDate" class="form-control form-control-sm" value="@(filter.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">المستخدم</label>
                <select name="UserId" class="form-select form-select-sm">
                    <option value="">-- كافة المستخدمين --</option>
                    @foreach (var u in users)
                    {
                        <option value="@u.Id" selected="@(filter.UserId == u.Id)">@u.Username</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">الوحدة (Module)</label>
                <select name="Module" class="form-select form-select-sm">
                    <option value="">-- كافة الوحدات --</option>
                    <option value="Sales" selected="@(filter.Module == "Sales")">المبيعات (Sales)</option>
                    <option value="Purchasing" selected="@(filter.Module == "Purchasing")">المشتريات (Purchasing)</option>
                    <option value="Inventory" selected="@(filter.Module == "Inventory")">المخزون (Inventory)</option>
                    <option value="Production" selected="@(filter.Module == "Production")">الإنتاج (Production)</option>
                    <option value="Waste" selected="@(filter.Module == "Waste")">الهوالك (Waste)</option>
                    <option value="QC" selected="@(filter.Module == "QC")">الجودة (QC)</option>
                    <option value="Accounting" selected="@(filter.Module == "Accounting")">الحسابات (Accounting)</option>
                    <option value="Security" selected="@(filter.Module == "Security")">الأمان (Security)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">نوع الإجراء</label>
                <select name="Action" class="form-select form-select-sm">
                    <option value="">-- كافة الإجراءات --</option>
                    <option value="Create" selected="@(filter.Action == "Create")">إنشاء (Create)</option>
                    <option value="Update" selected="@(filter.Action == "Update")">تعديل (Update)</option>
                    <option value="Approve" selected="@(filter.Action == "Approve")">اعتماد (Approve)</option>
                    <option value="Release" selected="@(filter.Action == "Release")">إفراج (Release)</option>
                    <option value="Post" selected="@(filter.Action == "Post")">ترحيل (Post)</option>
                    <option value="Reverse" selected="@(filter.Action == "Reverse")">عكس / إلغاء (Reverse)</option>
                    <option value="Execute" selected="@(filter.Action == "Execute")">تنفيذ (Execute)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-filter me-1"></i>تطبيق الفلتر</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">التوقيت (UTC)</th>
                        <th>المستخدم</th>
                        <th>الوحدة</th>
                        <th>الإجراء</th>
                        <th>نوع الكيان</th>
                        <th>رقم المرجع</th>
                        <th>الوصف والبيان</th>
                        <th>عنوان IP</th>
                        <th class="text-end pe-3">التفاصيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">لا توجد سجلات تدقيق مطابقة للبحث</td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="ps-3 font-monospace small">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-bold font-monospace text-primary">@log.Username</td>
                            <td><span class="badge bg-light text-dark border">@log.Module</span></td>
                            <td>
                                <span class="badge @(log.Action == "Create" ? "bg-success-subtle text-success" : (log.Action == "Approve" ? "bg-primary-subtle text-primary" : (log.Action == "Reverse" || log.Action == "Delete" ? "bg-danger-subtle text-danger" : "bg-info-subtle text-info"))) border">
                                    @log.Action
                                </span>
                            </td>
                            <td>@log.EntityType</td>
                            <td class="font-monospace fw-bold">@(string.IsNullOrEmpty(log.EntityNumber) ? "-" : log.EntityNumber)</td>
                            <td class="small">@log.Description</td>
                            <td class="font-monospace small text-muted">@(string.IsNullOrEmpty(log.IpAddress) ? "-" : log.IpAddress)</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye me-1"></i>عرض
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
