@model FactoryX.Application.DTOs.UserWarehouseAssignmentDto
@{
    ViewData["Title"] = "تخصيص صلاحيات المستودعات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i>صلاحيات المستودعات للمستخدم: @Model.Username</h2>
        <p class="text-muted mb-0">تحديد المستودعات والمخازن المسموح للمستخدم الاطلاع عليها وإجراء الحركات المخزنية فيها</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة لقائمة المستخدمين
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Warehouses" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <div class="alert alert-info d-flex align-items-center mb-4">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>قيد الأمان:</strong> في حال عدم تفعيل "الوصول الشامل"، سيتم حظر المستخدم برمجياً من الاطلاع على أرصدة أي مستودع آخر أو تنفيذ تحويلات أو تسويات جردية عليه.
                </div>
            </div>

            <div class="form-check form-switch p-3 bg-light rounded border mb-4">
                <input class="form-check-input ms-2" type="checkbox" role="switch" asp-for="IsAllWarehousesAllowed" id="globalWhSwitch" />
                <label class="form-check-label fw-bold" for="globalWhSwitch">
                    السماح بالوصول الشامل لكافة المستودعات والمواقع (Global Access)
                </label>
            </div>

            <div id="warehouseSelectionSection">
                <h5 class="fw-bold text-primary mb-3"><i class="bi bi-geo-alt-fill me-2"></i>المستودعات المخصصة المسموح بها:</h5>
                <div class="row g-3">
                    @foreach (var wh in Model.AvailableWarehouses)
                    {
                        <div class="col-md-6">
                            <div class="form-check card p-3 border shadow-none h-100">
                                <input class="form-check-input ms-2 me-2" type="checkbox" name="selectedWarehouseIds" value="@wh.Id" id="wh_@wh.Id" @(Model.SelectedWarehouseIds.Contains(wh.Id) ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="wh_@wh.Id">
                                    <span class="badge bg-secondary font-monospace me-1">@wh.Code</span>
                                    @wh.Name
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>حفظ الصلاحيات</button>
            </div>
        </form>
    </div>
</div>
