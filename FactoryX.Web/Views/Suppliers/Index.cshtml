@model IEnumerable<FactoryX.Application.DTOs.SupplierDto>
@{
    ViewData["Title"] = "سجل الموردين (Suppliers Master)";
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.SupplierSummaryDto;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-truck text-primary me-2"></i>سجل الموردين (Suppliers Master)</h2>
            <p class="text-muted mb-0">إدارة بيانات الموردين وتصنيفاتهم وسجل أسعار المواد الخام ومتابعة أوامر الشراء</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> إضافة مورد جديد
            </a>
            <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-file-invoice-dollar me-1"></i> أوامر الشراء
            </a>
            <a asp-controller="PurchaseReceipts" asp-action="Index" class="btn btn-outline-success shadow-sm">
                <i class="fas fa-boxes-packing me-1"></i> سندات الاستلام (GRN)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary KPI Cards -->
    @if (summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-white-50 mb-1">إجمالي الموردين</h6>
                                <h3 class="fw-bold mb-0">@summary.TotalSuppliers</h3>
                            </div>
                            <div class="fs-1 text-white-50"><i class="fas fa-truck"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-white-50 mb-1">الموردون النشطون</h6>
                                <h3 class="fw-bold mb-0">@summary.ActiveSuppliers</h3>
                            </div>
                            <div class="fs-1 text-white-50"><i class="fas fa-user-check"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-secondary text-white">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-white-50 mb-1">الموردون غير النشطين</h6>
                                <h3 class="fw-bold mb-0">@summary.InactiveSuppliers</h3>
                            </div>
                            <div class="fs-1 text-white-50"><i class="fas fa-user-slash"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-white-50 mb-1">تصنيفات التوريد</h6>
                                <h3 class="fw-bold mb-0">@summary.TotalCategories</h3>
                            </div>
                            <div class="fs-1 text-white-50"><i class="fas fa-tags"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">بحث بالاسم / الكود / الهاتف:</label>
                    <input type="text" name="searchTerm" class="form-control" placeholder="اسم المورد، كود، بريد..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">تصنيف المورد:</label>
                    <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- جميع التصنيفات --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">حالة النشاط:</label>
                    <select name="isActive" class="form-select">
                        <option value="">-- جميع الحالات --</option>
                        <option value="true" selected="@(ViewBag.SelectedIsActive == true)">نشط فقط</option>
                        <option value="false" selected="@(ViewBag.SelectedIsActive == false)">غير نشط فقط</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> تصفية</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">كود المورد</th>
                            <th>اسم المورد</th>
                            <th>التصنيف</th>
                            <th>مسؤول الاتصال</th>
                            <th>الهاتف / الجوال</th>
                            <th>أوامر الشراء</th>
                            <th>سندات الاستلام</th>
                            <th>الحالة</th>
                            <th class="text-end pe-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fas fa-truck fa-3x mb-3 text-secondary d-block"></i>
                                    لا توجد بيانات موردين مطابقة للبحث
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none font-monospace">
                                            @item.Code
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.Name</div>
                                        @if (!string.IsNullOrEmpty(item.ArabicName))
                                        {
                                            <small class="text-muted">@item.ArabicName</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.CategoryName ?? "عام")</span>
                                    </td>
                                    <td>@(string.IsNullOrEmpty(item.ContactPerson) ? "—" : item.ContactPerson)</td>
                                    <td>
                                        <div><i class="fas fa-phone small text-muted me-1"></i>@(string.IsNullOrEmpty(item.Phone) ? "—" : item.Phone)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.PurchaseOrdersCount أمر</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">@item.PurchaseReceiptsCount سند</span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>غير نشط</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="التفاصيل وسجل الأسعار">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
