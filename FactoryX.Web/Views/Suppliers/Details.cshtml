@model FactoryX.Application.DTOs.SupplierDto
@{
    ViewData["Title"] = $"بيانات المورد - {Model.Name}";
    var priceHistories = ViewBag.PriceHistories as IEnumerable<FactoryX.Application.DTOs.SupplierPriceHistoryDto>;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-dark font-monospace fs-6">@Model.Code</span>
                <h2 class="fw-bold mb-0">@Model.Name</h2>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>نشط</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>معطل / غير نشط</span>
                }
            </div>
            <p class="text-muted mb-0">@(Model.ArabicName ?? Model.Name) — تصنيف: @(Model.CategoryName ?? "عام")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm">
                <i class="fas fa-edit me-1"></i> تعديل
            </a>
            <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success") shadow-sm">
                    <i class="fas @(Model.IsActive ? "fa-ban" : "fa-check") me-1"></i> @(Model.IsActive ? "تعطيل المورد" : "تفعيل المورد")
                </button>
            </form>
            <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-file-invoice-dollar me-1"></i> أمر شراء جديد
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Supplier Info Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-address-card text-primary me-2"></i>معلومات الاتصال والبيانات</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">مسؤول المبيعات:</span>
                            <span class="fw-bold">@(string.IsNullOrEmpty(Model.ContactPerson) ? "—" : Model.ContactPerson)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">الهاتف:</span>
                            <span class="fw-bold font-monospace">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">الجوال:</span>
                            <span class="fw-bold font-monospace">@(string.IsNullOrEmpty(Model.Mobile) ? "—" : Model.Mobile)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">البريد الإلكتروني:</span>
                            <span class="fw-bold font-monospace">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">الرقم الضريبي:</span>
                            <span class="fw-bold font-monospace">@(string.IsNullOrEmpty(Model.TaxNumber) ? "—" : Model.TaxNumber)</span>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted d-block mb-1">العنوان:</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</span>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <li class="list-group-item px-0">
                                <span class="text-muted d-block mb-1">ملاحظات وشروط التوريد:</span>
                                <div class="p-2 bg-light rounded small text-secondary">@Model.Notes</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Purchasing Statistics Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-chart-pie text-primary me-2"></i>نشاط التوريد</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">أوامر الشراء المسجلة:</span>
                        <span class="badge bg-primary fs-6">@Model.PurchaseOrdersCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">سندات الاستلام المخزني:</span>
                        <span class="badge bg-success fs-6">@Model.PurchaseReceiptsCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Price History Table -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-tags text-primary me-2"></i>سجل أسعار الشراء وتاريخ التوريد للمورد</h6>
                    <span class="badge bg-secondary">@(priceHistories?.Count() ?? 0) حركة شراء</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">تاريخ الشراء</th>
                                    <th>كود الخامة</th>
                                    <th>اسم المادة الخام</th>
                                    <th>سعر الوحدة المستلمة</th>
                                    <th>أمر الشراء المرجعي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (priceHistories == null || !priceHistories.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            لا توجد حركات شراء أو أسعار مسجلة لهذا المورد حتى الآن
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in priceHistories)
                                    {
                                        <tr>
                                            <td class="ps-3 font-monospace">@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                            <td><span class="badge bg-secondary font-monospace">@p.MaterialCode</span></td>
                                            <td class="fw-bold">@p.MaterialName</td>
                                            <td class="fw-bold text-success font-monospace">@p.UnitPrice.ToString("N2") @p.Currency</td>
                                            <td>
                                                @if (p.PurchaseOrderId.HasValue)
                                                {
                                                    <a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@p.PurchaseOrderId" class="font-monospace text-decoration-none">
                                                        @(p.PurchaseOrderNumber ?? $"PO-#{p.PurchaseOrderId}")
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
