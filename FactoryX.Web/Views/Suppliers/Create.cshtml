@model FactoryX.Application.DTOs.CreateSupplierRequest
@{
    ViewData["Title"] = "إضافة مورد جديد";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-truck-medical me-2"></i>إضافة مورد جديد إلى النظام</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label fw-bold">كود المورد <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control font-monospace" placeholder="مثال: SUP-0001" />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">تصنيف المورد</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">-- اختر التصنيف --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold">اسم المورد / الشركة <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="اسم الشركة أو المورد" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ArabicName" class="form-label fw-bold">الاسم التجاري / العربي</label>
                                <input asp-for="ArabicName" class="form-control" placeholder="الاسم المتداول" />
                                <span asp-validation-for="ArabicName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ContactPerson" class="form-label fw-bold">اسم الشخص المسؤول</label>
                                <input asp-for="ContactPerson" class="form-control" placeholder="مندوب أو مدير المبيعات" />
                                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold">رقم الهاتف</label>
                                <input asp-for="Phone" class="form-control" placeholder="01xxxxxxxxx" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Mobile" class="form-label fw-bold">رقم الجوال الإضافي</label>
                                <input asp-for="Mobile" class="form-control" placeholder="01xxxxxxxxx" />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                                <input asp-for="Email" class="form-control" placeholder="supplier@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TaxNumber" class="form-label fw-bold">الرقم الضريبي / السجل التجاري</label>
                                <input asp-for="TaxNumber" class="form-control" placeholder="xxx-xxx-xxx" />
                                <span asp-validation-for="TaxNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mt-4">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label fw-bold">مورد نشط (متاح للاستخدام بأوامر الشراء)</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold">العنوان ومقر الشركة</label>
                                <input asp-for="Address" class="form-control" placeholder="العنوان بالتفصيل" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label fw-bold">ملاحظات وشروط التوريد</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات وشروط الدفع أو فترات السماح..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i> حفظ المورد</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
