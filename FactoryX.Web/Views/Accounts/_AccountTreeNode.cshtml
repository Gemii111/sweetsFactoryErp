@model FactoryX.Application.DTOs.AccountTreeNodeDto

<div class="account-item mb-2">
    <div class="account-node d-flex justify-content-between align-items-center @(Model.IsControlAccount ? "is-control" : "")">
        <div class="d-flex align-items-center cursor-pointer" onclick="@(Model.Children.Any() ? "toggleNode(this)" : "")">
            @if (Model.Children.Any())
            {
                <i class="bi bi-chevron-down tree-toggle-icon text-muted me-2"></i>
            }
            else
            {
                <i class="bi bi-dot text-secondary me-2 fs-5"></i>
            }
            <span class="badge bg-secondary-subtle text-secondary border me-2 font-monospace">@Model.AccountCode</span>
            <span class="fw-semibold">@Model.AccountNameAr</span>
            <span class="text-muted ms-2 small">(@Model.AccountName)</span>
            
            @if (Model.IsControlAccount)
            {
                <span class="badge bg-light text-dark border ms-2">حساب رئيسي</span>
            }
            @if (!Model.IsActive)
            {
                <span class="badge bg-danger-subtle text-danger ms-2">معطل</span>
            }
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="font-monospace fw-bold @(Model.Balance >= 0 ? "text-dark" : "text-danger")">
                @Model.Balance.ToString("N2") EGP
            </span>
            <div class="btn-group btn-group-sm">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary" title="تعديل الحساب">
                    <i class="bi bi-pencil"></i>
                </a>
                <a asp-controller="GeneralLedger" asp-action="Index" asp-route-AccountId="@Model.Id" class="btn btn-outline-info" title="كشف حساب الأستاذ">
                    <i class="bi bi-journal-text"></i>
                </a>
            </div>
        </div>
    </div>

    @if (Model.Children.Any())
    {
        <ul class="sub-accounts ps-0">
            @foreach (var child in Model.Children)
            {
                <li>@await Html.PartialAsync("_AccountTreeNode", child)</li>
            }
        </ul>
    }
</div>
