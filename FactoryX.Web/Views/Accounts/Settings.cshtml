@model IEnumerable<FactoryX.Application.DTOs.AccountingSettingDto>
@{
    ViewData["Title"] = "إعدادات الربط المحاسبي التلقائي";
    var accounts = ViewBag.Accounts as IEnumerable<FactoryX.Application.DTOs.AccountDto> ?? new List<FactoryX.Application.DTOs.AccountDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-gear-wide-connected text-primary me-2"></i>إعدادات التوجيه المحاسبي التلقائي</h2>
        <p class="text-muted mb-0">تحديد الحسابات المالية الافتراضية المرتبطة بالعمليات التشغيلية (فواتير المبيعات، المدفوعات، استلام المشتريات، الهالك، المخزون)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>العودة لشجرة الحسابات
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">الدور المحاسبي (Operational Role)</th>
                        <th>الحساب المرتبط حالياً</th>
                        <th>رمز الحساب</th>
                        <th class="text-end pe-4">تغيير الحساب المرتبط</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var setting in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@setting.RoleName</div>
                                <small class="text-muted">@setting.Role</small>
                            </td>
                            <td>
                                <span class="fw-semibold text-primary">@setting.AccountNameAr</span>
                                <div class="small text-muted">@setting.AccountName</div>
                            </td>
                            <td class="font-monospace fw-bold">@setting.AccountCode</td>
                            <td class="text-end pe-4">
                                <form asp-action="UpdateSetting" method="post" class="d-inline-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Role" value="@setting.Role" />
                                    <select name="AccountId" class="form-select form-select-sm" style="min-width: 250px;">
                                        @foreach (var acc in accounts)
                                        {
                                            <option value="@acc.Id" selected="@(acc.Id == setting.AccountId)">@acc.AccountCode - @acc.AccountNameAr</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">حفظ</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
