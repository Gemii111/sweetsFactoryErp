@model IEnumerable<FactoryX.Application.DTOs.PackagingOrderDto>
@{
    ViewData["Title"] = "أوامر التعبئة والتغليف (Packaging Orders)";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-dolly-flatbed text-primary me-2"></i>أوامر التعبئة والتغليف (Packaging Execution)</h2>
            <p class="text-muted mb-0">متابعة وتنفيذ أوامر تعبئة دفعات الإنتاج المعتمدة من الجودة، وصرف مواد التعبئة آلياً</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> إنشاء أمر تعبئة جديد
            </a>
            <a asp-controller="PackagingBOMs" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-boxes-packing me-1"></i> مواصفات التعبئة (BOM)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">حالة الأمر:</label>
                    <select name="status" class="form-select">
                        <option value="">-- جميع الحالات --</option>
                        <option value="1" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 1)">مسودة (Draft)</option>
                        <option value="2" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 2)">مخطط (Planned)</option>
                        <option value="3" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 3)">قيد التنفيذ (In Progress)</option>
                        <option value="4" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 4)">متوقف مؤقتاً (Paused)</option>
                        <option value="5" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 5)">مكتمل (Completed)</option>
                        <option value="6" selected="@(ViewBag.SelectedStatus != null && (int)ViewBag.SelectedStatus == 6)">ملغي (Cancelled)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">المنتج التام:</label>
                    <select name="productId" asp-items="ViewBag.Products" class="form-select">
                        <option value="">-- جميع المنتجات --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">بحث برقم الأمر أو الدفعة:</label>
                    <input type="text" name="searchTerm" class="form-control" value="@ViewBag.SearchTerm" placeholder="PKG-..., BAT-..." />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i> بحث</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="ps-3">رقم أمر التعبئة</th>
                            <th>دفعة الإنتاج</th>
                            <th>المنتج التام</th>
                            <th>مواصفة التعبئة</th>
                            <th>الكمية المخططة</th>
                            <th>الكمية المعبأة الفعلية</th>
                            <th>تكلفة مواد التعبئة</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th class="text-center pe-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="fw-bold font-monospace text-primary text-decoration-none">
                                            @order.OrderNumber
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@order.BatchNumber</span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @order.ProductName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@order.PackagingBOMCode</span>
                                        <small class="text-muted d-block">@order.PackagingBOMName</small>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@order.PlannedQuantity.ToString("N0")</span> @order.PackUnit
                                    </td>
                                    <td>
                                        @if (order.ActualQuantity > 0)
                                        {
                                            <span class="fw-bold text-success">@order.ActualQuantity.ToString("N0")</span> @order.PackUnit
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (order.PackagingMaterialCost > 0)
                                        {
                                            <span class="fw-bold text-success">@order.PackagingMaterialCost.ToString("C2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (order.Status == FactoryX.Domain.Entities.PackagingOrderStatus.Completed)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-double me-1"></i>مكتمل</span>
                                        }
                                        else if (order.Status == FactoryX.Domain.Entities.PackagingOrderStatus.InProgress)
                                        {
                                            <span class="badge bg-primary"><i class="fas fa-spinner fa-spin me-1"></i>قيد التنفيذ</span>
                                        }
                                        else if (order.Status == FactoryX.Domain.Entities.PackagingOrderStatus.Planned)
                                        {
                                            <span class="badge bg-info text-dark"><i class="fas fa-clock me-1"></i>مخطط</span>
                                        }
                                        else if (order.Status == FactoryX.Domain.Entities.PackagingOrderStatus.Paused)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-pause me-1"></i>متوقف</span>
                                        }
                                        else if (order.Status == FactoryX.Domain.Entities.PackagingOrderStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>ملغي</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">مسودة</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @order.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info" title="عرض التفاصيل">
                                            <i class="fas fa-eye me-1"></i>التفاصيل
                                        </a>
                                        @if (order.Status != FactoryX.Domain.Entities.PackagingOrderStatus.Completed && order.Status != FactoryX.Domain.Entities.PackagingOrderStatus.Cancelled)
                                        {
                                            <a asp-action="Execute" asp-route-id="@order.Id" class="btn btn-sm btn-success" title="تنفيذ وصرف التعبئة">
                                                <i class="fas fa-play me-1"></i>تنفيذ
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="fas fa-dolly-flatbed fa-3x mb-3 text-secondary d-block"></i>
                                    لا توجد أوامر تعبئة وتغليف مسجلة.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
