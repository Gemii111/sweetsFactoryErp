@model FactoryX.Application.DTOs.ProductionRecordDto
@{
    ViewData["Title"] = "تفاصيل سجل الإنتاج";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center text-primary"><i class="bi bi-clipboard-data me-2"></i>تفاصيل سجل الإنتاج #@Model.Id</h3>
                    <dl class="row mb-4">
                        <dt class="col-5 text-muted">أمر التشغيل</dt>
                        <dd class="col-7 fw-bold">@Model.WorkOrderName</dd>
                        <dt class="col-5 text-muted">المشغل المسؤول</dt>
                        <dd class="col-7">@Model.OperatorName</dd>
                        <dt class="col-5 text-muted">الكمية المصنعة</dt>
                        <dd class="col-7 fw-bold text-success fs-5">@Model.QuantityProduced</dd>
                        <dt class="col-5 text-muted">تاريخ ووقت التسجيل</dt>
                        <dd class="col-7 text-muted">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>
                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill"><i class="bi bi-arrow-right"></i> عودة للقائمة</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 rounded-pill shadow-sm"><i class="bi bi-pencil"></i> تعديل</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>