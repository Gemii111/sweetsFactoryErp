@model FactoryX.Application.DTOs.ProductionRecordDto
@{
    ViewData["Title"] = "حذف سجل الإنتاج";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center text-danger"><i class="bi bi-trash me-2"></i>تأكيد حذف سجل الإنتاج</h3>
                    <div class="alert alert-warning mb-4 rounded-3"><i class="bi bi-exclamation-triangle-fill me-1"></i> هل أنت متأكد من رغبتك في حذف هذا السجل نهائياً؟</div>
                    <dl class="row mb-4">
                        <dt class="col-5 text-muted">رقم السجل</dt>
                        <dd class="col-7 fw-bold">#@Model.Id</dd>
                        <dt class="col-5 text-muted">الكمية المصنعة</dt>
                        <dd class="col-7 fw-bold text-success fs-5">@Model.QuantityProduced</dd>
                        <dt class="col-5 text-muted">التاريخ والوقت</dt>
                        <dd class="col-7 text-muted">@Model.Timestamp.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill"><i class="bi bi-arrow-right"></i> إلغاء</a>
                            <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm"><i class="bi bi-trash"></i> تأكيد الحذف</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>