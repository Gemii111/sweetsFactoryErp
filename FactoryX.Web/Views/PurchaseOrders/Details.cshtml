@model FactoryX.Application.DTOs.PurchaseOrderDto
@{
    ViewData["Title"] = $"تفاصيل أمر الشراء {Model.OrderNumber}";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-dark font-monospace fs-6">@Model.OrderNumber</span>
                <h2 class="fw-bold mb-0">أمر شراء مواد خام وتعبئة</h2>
                @switch (Model.Status)
                {
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.Draft:
                        <span class="badge bg-secondary fs-6">مسودة (Draft)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.Submitted:
                        <span class="badge bg-primary fs-6">مقدم للاعتماد (Submitted)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.Approved:
                        <span class="badge bg-info text-dark fs-6"><i class="fas fa-check-circle me-1"></i>معتمد (جاهز للاستلام)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.PartiallyReceived:
                        <span class="badge bg-warning text-dark fs-6"><i class="fas fa-spinner fa-spin me-1"></i>مستلم جزئياً</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.FullyReceived:
                        <span class="badge bg-success fs-6"><i class="fas fa-check-double me-1"></i>مستلم بالكامل</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.Cancelled:
                        <span class="badge bg-danger fs-6">ملغي (Cancelled)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseOrderStatus.Closed:
                        <span class="badge bg-dark fs-6">مغلق (Closed)</span>
                        break;
                }
            </div>
            <p class="text-muted mb-0">المورد: <strong>@Model.SupplierName</strong> (@Model.SupplierCode) | تاريخ الأمر: @Model.OrderDate.ToString("yyyy-MM-dd")</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Draft)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary shadow-sm">
                    <i class="fas fa-edit me-1"></i> تعديل
                </a>

                <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="fas fa-paper-plane me-1"></i> تقديم للاعتماد
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Submitted || Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Draft)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success shadow-sm">
                        <i class="fas fa-check me-1"></i> اعتماد أمر الشراء
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Approved || Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.PartiallyReceived)
            {
                <a asp-controller="PurchaseReceipts" asp-action="Create" asp-route-purchaseOrderId="@Model.Id" class="btn btn-success shadow-sm">
                    <i class="fas fa-dolly me-1"></i> استلام شحنة واردة (GRN)
                </a>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.PartiallyReceived || Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.FullyReceived)
            {
                <form asp-action="Close" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-dark shadow-sm" onclick="return confirm('هل تريد إغلاق أمر الشراء؟');">
                        <i class="fas fa-lock me-1"></i> إغلاق الأمر
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Draft || Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Submitted || Model.Status == FactoryX.Domain.Entities.PurchaseOrderStatus.Approved)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger shadow-sm" onclick="return confirm('هل أنت متأكد من إلغاء أمر الشراء؟');">
                        <i class="fas fa-ban me-1"></i> إلغاء الأمر
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">المستودع الرئيسي للاستلام</span>
                    <span class="fw-bold">@Model.WarehouseName</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">طلب الشراء المرجعي</span>
                    <span class="fw-bold font-monospace">@(Model.PurchaseRequestNumber ?? "—")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">معتمد الأمر</span>
                    <span class="fw-bold">@(Model.ApprovedByName ?? "—")</span>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <small class="text-muted d-block">في: @Model.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")</small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body py-3">
                    <span class="text-white-50 small d-block">إجمالي قيمة أمر الشراء</span>
                    <h4 class="fw-bold mb-0">@Model.TotalAmount.ToString("N2") @Model.Currency</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="fas fa-list text-primary me-2"></i>بنود أمر الشراء ومتابعة الكميات المستلمة</h6>
            <span class="badge bg-secondary">@(Model.Items?.Count ?? 0) بنود</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>كود الخامة</th>
                            <th>اسم المادة الخام</th>
                            <th>الكمية المطلوبة</th>
                            <th>الكمية المستلمة</th>
                            <th>الكمية المتبقية</th>
                            <th>سعر الوحدة</th>
                            <th>الخصم</th>
                            <th>الضريبة</th>
                            <th class="text-end pe-3">إجمالي القيمة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr>
                                <td class="ps-3 text-muted">@(i + 1)</td>
                                <td><span class="badge bg-secondary font-monospace">@item.MaterialCode</span></td>
                                <td class="fw-bold">@item.MaterialName</td>
                                <td class="fw-bold font-monospace">@item.OrderedQuantity.ToString("N2") @item.Unit</td>
                                <td class="fw-bold text-success font-monospace">@item.ReceivedQuantity.ToString("N2") @item.Unit</td>
                                <td class="fw-bold @(item.RemainingQuantity > 0 ? "text-warning" : "text-muted") font-monospace">
                                    @item.RemainingQuantity.ToString("N2") @item.Unit
                                </td>
                                <td class="font-monospace">@item.UnitPrice.ToString("N2")</td>
                                <td class="font-monospace text-danger">@item.DiscountAmount.ToString("N2")</td>
                                <td class="font-monospace">@item.TaxAmount.ToString("N2")</td>
                                <td class="text-end pe-3 fw-bold text-success font-monospace">@item.TotalPrice.ToString("N2") @Model.Currency</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="9" class="text-end">إجمالي أمر الشراء الصافي:</td>
                            <td class="text-end pe-3 fs-5 text-success font-monospace">@Model.TotalAmount.ToString("N2") @Model.Currency</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
