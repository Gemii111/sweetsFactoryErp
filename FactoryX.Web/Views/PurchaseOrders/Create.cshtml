@model FactoryX.Application.DTOs.CreatePurchaseOrderRequest
@{
    ViewData["Title"] = "إنشاء أمر شراء جديد";
    var materials = ViewBag.Materials as IEnumerable<FactoryX.Application.DTOs.MaterialDto>;
}

<div class="container-fluid py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i>إنشاء أمر شراء مواد خام وتعبئة (Purchase Order)</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="poForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PurchaseRequestId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                <!-- Header Info -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="SupplierId" class="form-label fw-bold">المورد <span class="text-danger">*</span></label>
                        <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers" required>
                            <option value="">-- اختر المورد --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="WarehouseId" class="form-label fw-bold">مستودع الاستلام الرئيسي <span class="text-danger">*</span></label>
                        <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.Warehouses" required>
                            <option value="">-- اختر المستودع --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OrderDate" class="form-label fw-bold">تاريخ أمر الشراء <span class="text-danger">*</span></label>
                        <input asp-for="OrderDate" type="date" class="form-control" />
                        <span asp-validation-for="OrderDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedDeliveryDate" class="form-label fw-bold">تاريخ التوريد المتوقع</label>
                        <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpectedDeliveryDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Currency" class="form-label fw-bold">العملة</label>
                        <select asp-for="Currency" class="form-select">
                            <option value="EGP">جنيه مصري (EGP)</option>
                            <option value="USD">دولار أمريكي (USD)</option>
                            <option value="EUR">يورو (EUR)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات وشروط الدفع</label>
                        <input asp-for="Notes" class="form-control" placeholder="ملاحظات وشروط أمر الشراء..." />
                    </div>
                </div>

                <!-- Items Section -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-cubes text-primary me-2"></i>بنود أمر الشراء والأسعار</h6>
                    <button type="button" class="btn btn-sm btn-outline-success" id="btnAddItem">
                        <i class="fas fa-plus me-1"></i> إضافة بند آخر
                    </button>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">المادة الخام <span class="text-danger">*</span></th>
                                <th style="width: 15%;">الكمية <span class="text-danger">*</span></th>
                                <th style="width: 10%;">الوحدة</th>
                                <th style="width: 15%;">سعر الوحدة <span class="text-danger">*</span></th>
                                <th style="width: 10%;">الخصم</th>
                                <th style="width: 10%;">الضريبة</th>
                                <th style="width: 5%;">حذف</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <select name="Items[@i].MaterialId" class="form-select material-select" required>
                                            <option value="">-- اختر المادة الخام --</option>
                                            @if (materials != null)
                                            {
                                                @foreach (var m in materials)
                                                {
                                                    <option value="@m.Id" data-unit="@m.Unit" data-cost="@(m.CurrentCost > 0 ? m.CurrentCost : m.StandardCost)" selected="@(Model.Items[i].MaterialId == m.Id)">
                                                        @m.Name (@m.Code)
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0.01" name="Items[@i].OrderedQuantity" class="form-control font-monospace item-qty" value="@Model.Items[i].OrderedQuantity" required />
                                    </td>
                                    <td>
                                        <input type="text" name="Items[@i].Unit" class="form-control item-unit" value="@Model.Items[i].Unit" placeholder="كجم" required />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0" name="Items[@i].UnitPrice" class="form-control font-monospace item-price" value="@Model.Items[i].UnitPrice" required />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0" name="Items[@i].DiscountAmount" class="form-control font-monospace item-disc" value="@Model.Items[i].DiscountAmount" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0" name="Items[@i].TaxAmount" class="form-control font-monospace item-tax" value="@Model.Items[i].TaxAmount" />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-item"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i> حفظ أمر الشراء</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const table = document.getElementById('itemsTable').getElementsByTagName('tbody')[0];
        const btnAdd = document.getElementById('btnAddItem');

        function bindRow(row) {
            const select = row.querySelector('.material-select');
            const unitInput = row.querySelector('.item-unit');
            const priceInput = row.querySelector('.item-price');
            const btnRemove = row.querySelector('.btn-remove-item');

            select.addEventListener('change', function() {
                const opt = select.selectedOptions[0];
                if (opt && opt.dataset.unit) {
                    unitInput.value = opt.dataset.unit;
                    if (!priceInput.value || priceInput.value == '0') {
                        priceInput.value = opt.dataset.cost || 0;
                    }
                }
            });

            btnRemove.addEventListener('click', function() {
                if (table.rows.length > 1) {
                    row.remove();
                    reindexRows();
                } else {
                    alert('يجب أن يحتوي أمر الشراء على بند واحد على الأقل.');
                }
            });
        }

        function reindexRows() {
            Array.from(table.rows).forEach((row, index) => {
                row.querySelector('.material-select').name = `Items[${index}].MaterialId`;
                row.querySelector('.item-qty').name = `Items[${index}].OrderedQuantity`;
                row.querySelector('.item-unit').name = `Items[${index}].Unit`;
                row.querySelector('.item-price').name = `Items[${index}].UnitPrice`;
                row.querySelector('.item-disc').name = `Items[${index}].DiscountAmount`;
                row.querySelector('.item-tax').name = `Items[${index}].TaxAmount`;
            });
        }

        Array.from(table.rows).forEach(bindRow);

        btnAdd.addEventListener('click', function() {
            const index = table.rows.length;
            const firstRow = table.rows[0];
            const newRow = firstRow.cloneNode(true);
            newRow.querySelector('.material-select').value = '';
            newRow.querySelector('.item-qty').value = '100';
            newRow.querySelector('.item-unit').value = '';
            newRow.querySelector('.item-price').value = '0';
            newRow.querySelector('.item-disc').value = '0';
            newRow.querySelector('.item-tax').value = '0';
            table.appendChild(newRow);
            bindRow(newRow);
            reindexRows();
        });
    });
</script>
}
