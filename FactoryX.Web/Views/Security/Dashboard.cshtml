@model FactoryX.Application.DTOs.SecurityDashboardDto
@{
    ViewData["Title"] = "لوحة الرقابة والأمان (Security Dashboard)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-check text-success me-2"></i>لوحة الرقابة والأمان (Security & RBAC Dashboard)</h2>
        <p class="text-muted mb-0">مراقبة الجلسات، محاولات الدخول، الحسابات المقفلة، والعمليات الحساسة في ERP</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Events" class="btn btn-outline-secondary">
            <i class="bi bi-shield-exclamation me-1"></i>سجل الأحداث الأمنية
        </a>
        <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i>سجل التدقيق الشامل
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">إجمالي المستخدمين</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.TotalUsersCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-success-subtle p-3">
            <small class="text-success fw-bold">الحسابات النشطة</small>
            <h4 class="fw-bold text-success font-monospace mb-0">@Model.ActiveUsersCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-danger-subtle p-3">
            <small class="text-danger fw-bold">الحسابات المعطلة</small>
            <h4 class="fw-bold text-danger font-monospace mb-0">@Model.DisabledUsersCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-warning-subtle p-3">
            <small class="text-warning-emphasis fw-bold">الحسابات المقفلة</small>
            <h4 class="fw-bold text-dark font-monospace mb-0">@Model.LockedUsersCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">الأدوار المفعلة</small>
            <h4 class="fw-bold text-primary font-monospace mb-0">@Model.TotalRolesCount</h4>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card shadow-sm border-0 bg-light p-3">
            <small class="text-muted">الصلاحيات المعرفة</small>
            <h4 class="fw-bold text-info font-monospace mb-0">@Model.TotalPermissionsCount</h4>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-success-subtle p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-success fw-bold">دخول ناجح اليوم</small>
                    <h3 class="fw-bold text-success mb-0 font-monospace">@Model.TodaySuccessfulLoginsCount</h3>
                </div>
                <i class="bi bi-box-arrow-in-right fs-1 text-success opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-danger-subtle p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-danger fw-bold">محاولات فاشلة اليوم</small>
                    <h3 class="fw-bold text-danger mb-0 font-monospace">@Model.TodayFailedLoginsCount</h3>
                </div>
                <i class="bi bi-shield-x fs-1 text-danger opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-warning-subtle p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-dark fw-bold">عمليات حساسة اليوم (High Risk)</small>
                    <h3 class="fw-bold text-dark mb-0 font-monospace">@Model.TodayHighRiskActionsCount</h3>
                </div>
                <i class="bi bi-exclamation-diamond-fill fs-1 text-warning opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Security Events -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-shield-exclamation text-primary me-2"></i>آخر الأحداث الأمنية</h6>
                <a asp-action="Events" class="btn btn-sm btn-link text-decoration-none">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">التوقيت</th>
                                <th>الحدث</th>
                                <th>المستخدم</th>
                                <th>الخطورة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentSecurityEvents.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted">لا توجد أحداث أمنية مسجلة</td>
                                </tr>
                            }
                            @foreach (var ev in Model.RecentSecurityEvents)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace small">@ev.Timestamp.ToString("HH:mm:ss")</td>
                                    <td><span class="badge bg-light text-dark border">@ev.EventType</span></td>
                                    <td class="font-monospace fw-bold text-primary">@ev.Username</td>
                                    <td>
                                        <span class="badge @(ev.Severity == "Critical" ? "bg-danger" : (ev.Severity == "Warning" ? "bg-warning text-dark" : "bg-info"))">
                                            @ev.Severity
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent High-Risk Operations -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>آخر العمليات الحساسة (Audit)</h6>
                <a asp-controller="Audit" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">عرض الكل</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">التوقيت</th>
                                <th>المستخدم</th>
                                <th>الإجراء</th>
                                <th>المرجع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentHighRiskAudits.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted">لا توجد حركات حساسة مسجلة</td>
                                </tr>
                            }
                            @foreach (var a in Model.RecentHighRiskAudits)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace small">@a.Timestamp.ToString("HH:mm:ss")</td>
                                    <td class="font-monospace fw-bold text-primary">@a.Username</td>
                                    <td><span class="badge bg-danger-subtle text-danger border">@a.Action</span></td>
                                    <td class="font-monospace fw-semibold">@a.EntityNumber</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
