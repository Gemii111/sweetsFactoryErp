@model List<FactoryX.Application.DTOs.SecurityEventItemDto>
@{
    ViewData["Title"] = "سجل الأحداث الأمنية (Security Events)";
    var filter = ViewBag.Filter as FactoryX.Application.DTOs.SecurityEventFilterDto ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-exclamation text-primary me-2"></i>سجل الأحداث الأمنية ومحاولات الدخول</h2>
        <p class="text-muted mb-0">توثيق محاولات الدخول، فشل المصادقة، قفل الحسابات، وتغييرات الصلاحيات</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Dashboard" class="btn btn-outline-info">
            <i class="bi bi-speedometer2 me-1"></i>لوحة الأمان
        </a>
        <a asp-controller="Audit" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-clock-history me-1"></i>سجل التدقيق
        </a>
    </div>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">نوع الحدث (Event Type)</label>
                <select name="EventType" class="form-select form-select-sm">
                    <option value="">-- كافة الأحداث --</option>
                    <option value="LoginSuccess" selected="@(filter.EventType == "LoginSuccess")">دخول ناجح (LoginSuccess)</option>
                    <option value="LoginFailure" selected="@(filter.EventType == "LoginFailure")">محاولة فاشلة (LoginFailure)</option>
                    <option value="AccountLocked" selected="@(filter.EventType == "AccountLocked")">قفل حساب (AccountLocked)</option>
                    <option value="AccountUnlocked" selected="@(filter.EventType == "AccountUnlocked")">إلغاء قفل (AccountUnlocked)</option>
                    <option value="PasswordChanged" selected="@(filter.EventType == "PasswordChanged")">تغيير كلمة المرور (PasswordChanged)</option>
                    <option value="UserCreated" selected="@(filter.EventType == "UserCreated")">إنشاء مستخدم (UserCreated)</option>
                    <option value="RoleCreated" selected="@(filter.EventType == "RoleCreated")">إنشاء دور (RoleCreated)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">مستوى الخطورة</label>
                <select name="Severity" class="form-select form-select-sm">
                    <option value="">-- كافة المستويات --</option>
                    <option value="Info" selected="@(filter.Severity == "Info")">معلومة (Info)</option>
                    <option value="Warning" selected="@(filter.Severity == "Warning")">تحذير (Warning)</option>
                    <option value="Critical" selected="@(filter.Severity == "Critical")">حرج (Critical)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold mb-1">اسم المستخدم</label>
                <input type="text" name="Username" class="form-control form-control-sm" placeholder="ابحث باسم المستخدم..." value="@filter.Username" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-filter me-1"></i>تطبيق الفلتر</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">التوقيت (UTC)</th>
                        <th>نوع الحدث</th>
                        <th>اسم المستخدم</th>
                        <th>البيان والتفاصيل</th>
                        <th>عنوان IP</th>
                        <th class="text-end pe-3">مستوى الخطورة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">لا توجد أحداث أمنية مطابقة للبحث</td>
                        </tr>
                    }
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td class="ps-3 font-monospace small">@ev.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-light text-dark border">@ev.EventType</span></td>
                            <td class="font-monospace fw-bold text-primary">@ev.Username</td>
                            <td>@ev.Details</td>
                            <td class="font-monospace small text-muted">@(string.IsNullOrEmpty(ev.IpAddress) ? "-" : ev.IpAddress)</td>
                            <td class="text-end pe-3">
                                <span class="badge @(ev.Severity == "Critical" ? "bg-danger" : (ev.Severity == "Warning" ? "bg-warning text-dark" : "bg-info"))">
                                    @ev.Severity
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
