@model FactoryX.Application.DTOs.FinishedGoodsStockDto
@{
    ViewData["Title"] = $"بطاقة تتبع المنتج التام — {Model.ProductName} [{Model.BatchNumber}]";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-sitemap text-primary me-2"></i>بطاقة تتبع المنتج التام (Finished Goods Traceability)</h2>
            <p class="text-muted mb-0">شجرة التتبع التصنيعي الكاملة من أمر الإنتاج حتى المستودع النهائي</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> العودة للمخزون
            </a>
            <a asp-action="Adjust" asp-route-stockId="@Model.Id" class="btn btn-outline-warning shadow-sm">
                <i class="fas fa-sliders me-1"></i> تسوية جردية
            </a>
            <a asp-action="Transfer" asp-route-stockId="@Model.Id" class="btn btn-outline-info shadow-sm">
                <i class="fas fa-arrow-right-arrow-left me-1"></i> نقل داخلي
            </a>
        </div>
    </div>

    <!-- Stock Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <span class="text-muted small d-block">المنتج التام:</span>
                    <h5 class="fw-bold mb-0 text-primary">@Model.ProductName</h5>
                    <small class="text-muted">كود: @Model.ProductCode | SKU: @Model.ProductSKU</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <span class="text-muted small d-block">الرصيد المتاح الحالي:</span>
                    <h4 class="fw-bold mb-0 text-success">@Model.Quantity.ToString("N0") <small class="fs-6">@Model.Unit</small></h4>
                    <small class="text-muted">القيمة: @Model.TotalCost.ToString("C2") (@Model.UnitCost.ToString("C2")/وحدة)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-info border-4">
                <div class="card-body">
                    <span class="text-muted small d-block">مستودع وموقع التخزين:</span>
                    <h5 class="fw-bold mb-0 text-dark">@Model.WarehouseName</h5>
                    <small class="text-muted">الموقع: @(Model.LocationName ?? "المنطقة العامة")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <span class="text-muted small d-block">رقم التشغيلة والصلاحية:</span>
                    <h5 class="fw-bold mb-0 font-monospace">@Model.BatchNumber</h5>
                    <small class="text-muted">انتهاء: @Model.ExpiryDate.ToString("yyyy-MM-dd") (@Model.DaysUntilExpiry يوم متبقي)</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Traceability Timeline & Stages -->
    <div class="row g-4">
        <!-- Manufacturing Traceability Flow -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-route me-2"></i>مسار التتبع التصنيعي (Upstream Traceability Chain)
                </div>
                <div class="card-body">
                    <div class="timeline position-relative ps-4 border-start border-2 border-primary my-2">
                        
                        <!-- Step 1: Production Batch & Work Order -->
                        <div class="mb-4 position-relative">
                            <i class="fas fa-industry position-absolute top-0 start-0 translate-middle rounded-circle bg-primary text-white p-2 shadow-sm" style="margin-left: -1px;"></i>
                            <div class="ms-3">
                                <h6 class="fw-bold text-primary mb-1">1. دفعة وتشغيل الإنتاج (Production Batch & Work Order)</h6>
                                <p class="text-muted small mb-2">تم تصنيع هذه الدفعة وإغلاقها بنجاح وفق مواصفات أمر العمل المعتمد.</p>
                                <div class="bg-light p-3 rounded border">
                                    <div class="row g-2 small">
                                        <div class="col-md-6">
                                            <span class="text-muted">رقم التشغيلة:</span>
                                            <strong class="font-monospace">@Model.BatchNumber</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">أمر الإنتاج المرتبط:</span>
                                            <strong>@(Model.WorkOrderNumber ?? "غير محدد")</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">تاريخ بدء التصنيع:</span>
                                            <span>@Model.ProductionDate.ToString("yyyy-MM-dd")</span>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">حالة الدفعة:</span>
                                            <span class="badge bg-success">مكتملة (Completed)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Quality Control Gate -->
                        <div class="mb-4 position-relative">
                            <i class="fas fa-clipboard-check position-absolute top-0 start-0 translate-middle rounded-circle bg-info text-dark p-2 shadow-sm" style="margin-left: -1px;"></i>
                            <div class="ms-3">
                                <h6 class="fw-bold text-info mb-1">2. فحص الجودة وبوابة الإفراج (Quality Inspection & Gate)</h6>
                                <p class="text-muted small mb-2">اجتياز فحص الجودة المعتمد والموافقة على إفراج الدفعة مخزنياً.</p>
                                <div class="bg-light p-3 rounded border">
                                    <div class="row g-2 small">
                                        <div class="col-md-6">
                                            <span class="text-muted">سجل الفحص المرجعي:</span>
                                            <strong class="text-primary font-monospace">@(Model.QCInspectionNumber ?? "معتمد آلياً / فحص مباشر")</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">قرار الجودة:</span>
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>مطابق ومعتمد (QC APPROVED)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Packaging Execution -->
                        <div class="mb-4 position-relative">
                            <i class="fas fa-box-open position-absolute top-0 start-0 translate-middle rounded-circle bg-warning text-dark p-2 shadow-sm" style="margin-left: -1px;"></i>
                            <div class="ms-3">
                                <h6 class="fw-bold text-warning mb-1">3. التعبئة والتغليف (Packaging Order)</h6>
                                <p class="text-muted small mb-2">تجهيز وتغليف المنتج التام بالعبوات والمواد المخصصة.</p>
                                <div class="bg-light p-3 rounded border">
                                    <div class="row g-2 small">
                                        <div class="col-md-6">
                                            <span class="text-muted">أمر التعبئة:</span>
                                            <strong>@(Model.PackagingOrderNumber ?? "غير مطلوب / تعبئة مباشرة")</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">مواصفة التعبئة:</span>
                                            <span>@(Model.PackagingBOMName ?? "تعبئة سائلة / خام")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 4: Finished Goods Release -->
                        <div class="position-relative">
                            <i class="fas fa-warehouse position-absolute top-0 start-0 translate-middle rounded-circle bg-success text-white p-2 shadow-sm" style="margin-left: -1px;"></i>
                            <div class="ms-3">
                                <h6 class="fw-bold text-success mb-1">4. الإفراج والتخزين التام (Finished Goods Release & Storage)</h6>
                                <p class="text-muted small mb-2">تم إصدار سند إفراج المنتج التام واستلام الكمية في المستودع النهائي.</p>
                                <div class="bg-light p-3 rounded border">
                                    <div class="row g-2 small">
                                        <div class="col-md-6">
                                            <span class="text-muted">المستودع النهائي:</span>
                                            <strong class="text-success">@Model.WarehouseName</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">الموقع الداخلي:</span>
                                            <span>@(Model.LocationName ?? "عام")</span>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">الكمية المسلمة:</span>
                                            <strong class="text-success">@Model.Quantity.ToString("N0") @Model.Unit</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <span class="text-muted">تاريخ التسجيل:</span>
                                            <span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Meta & Cost Details Side Panel -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold">
                    <i class="fas fa-calculator text-primary me-2"></i>هيكل التكاليف والمواصفات
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">تكلفة الوحدة المحسوبة:</span>
                            <strong class="text-primary fs-6">@Model.UnitCost.ToString("C2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">الكمية المتوفرة:</span>
                            <strong>@Model.Quantity.ToString("N0") @Model.Unit</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">إجمالي القيمة المخزنية:</span>
                            <strong class="text-success fs-6">@Model.TotalCost.ToString("C2")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">تاريخ الإنتاج:</span>
                            <span>@Model.ProductionDate.ToString("yyyy-MM-dd")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">تاريخ الانتهاء:</span>
                            <span>@Model.ExpiryDate.ToString("yyyy-MM-dd")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">الحالة المخزنية:</span>
                            <span class="badge bg-success">جاهز ومتاح للتوزيع</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body text-center p-4">
                    <i class="fas fa-qrcode fa-4x text-muted mb-3 d-block"></i>
                    <h6 class="fw-bold mb-1 font-monospace">@Model.BatchNumber</h6>
                    <small class="text-muted d-block mb-3">رمز التتبع المخزني السريع</small>
                    <a asp-action="Movements" asp-route-batchNumber="@Model.BatchNumber" class="btn btn-sm btn-outline-dark w-100">
                        <i class="fas fa-list-ol me-1"></i> عرض كافة حركات هذه التشغيلة
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
