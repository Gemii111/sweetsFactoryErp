@model FactoryX.Application.DTOs.FinishedGoodsTransferRequest
@{
    ViewData["Title"] = "نقل منتجات تامة بين المستودعات";
    var currentStock = ViewBag.CurrentStock as FactoryX.Application.DTOs.FinishedGoodsStockDto;
}

<div class="container py-3" style="max-width: 850px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-arrow-right-arrow-left text-info me-2"></i>نقل منتجات تامة بين المستودعات والمواقع</h2>
            <p class="text-muted mb-0">مناقلة المخزون التام بين مستودعات المنتجات التامة أو المواقع الداخلية</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> العودة للمخزون
        </a>
    </div>

    @if (currentStock != null)
    {
        <div class="alert alert-info shadow-sm mb-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold mb-1"><i class="fas fa-info-circle me-1"></i>الرصيد المتاح بالمصدر:</h6>
                    <span>المنتج: <strong>@currentStock.ProductName</strong> | التشغيلة: <strong class="font-monospace">@currentStock.BatchNumber</strong> | المستودع: <strong>@currentStock.WarehouseName</strong></span>
                </div>
                <div class="text-end">
                    <span class="fs-4 fw-bold text-primary">@currentStock.Quantity.ToString("N0")</span> <small>@currentStock.Unit</small>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Transfer" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                <div class="row g-3">
                    <!-- Product & Batch Info -->
                    <div class="col-md-6">
                        <label asp-for="ProductId" class="form-label fw-bold">المنتج التام <span class="text-danger">*</span></label>
                        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" required>
                            <option value="">-- اختر المنتج التام --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BatchNumber" class="form-label fw-bold">رقم التشغيلة (Batch Number) <span class="text-danger">*</span></label>
                        <input asp-for="BatchNumber" class="form-control font-monospace" placeholder="مثال: B-20260831-0001" required />
                        <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                    </div>

                    <!-- Source Section -->
                    <div class="col-12 mt-4">
                        <h6 class="fw-bold text-danger border-bottom pb-2"><i class="fas fa-arrow-up-from-bracket me-1"></i>مستودع وموقع المصدر (Source)</h6>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SourceWarehouseId" class="form-label fw-bold">مستودع المصدر <span class="text-danger">*</span></label>
                        <select asp-for="SourceWarehouseId" asp-items="ViewBag.SourceWarehouses" class="form-select" id="srcWhSelect" required>
                            <option value="">-- اختر مستودع المصدر --</option>
                        </select>
                        <span asp-validation-for="SourceWarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SourceLocationId" class="form-label fw-bold">موقع المصدر (اختياري)</label>
                        <select asp-for="SourceLocationId" class="form-select" id="srcLocSelect">
                            <option value="">-- المنطقة العامة --</option>
                        </select>
                        <span asp-validation-for="SourceLocationId" class="text-danger small"></span>
                    </div>

                    <!-- Destination Section -->
                    <div class="col-12 mt-4">
                        <h6 class="fw-bold text-success border-bottom pb-2"><i class="fas fa-arrow-down-to-bracket me-1"></i>مستودع وموقع الوجهة (Destination)</h6>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DestinationWarehouseId" class="form-label fw-bold">مستودع الوجهة <span class="text-danger">*</span></label>
                        <select asp-for="DestinationWarehouseId" asp-items="ViewBag.DestinationWarehouses" class="form-select" id="destWhSelect" required>
                            <option value="">-- اختر مستودع الوجهة --</option>
                        </select>
                        <span asp-validation-for="DestinationWarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DestinationLocationId" class="form-label fw-bold">موقع الوجهة (اختياري)</label>
                        <select asp-for="DestinationLocationId" class="form-select" id="destLocSelect">
                            <option value="">-- المنطقة العامة --</option>
                        </select>
                        <span asp-validation-for="DestinationLocationId" class="text-danger small"></span>
                    </div>

                    <!-- Quantity & Details -->
                    <div class="col-12 mt-4">
                        <h6 class="fw-bold text-primary border-bottom pb-2"><i class="fas fa-cubes me-1"></i>الكمية المنقولة وتفاصيل الحركة</h6>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Quantity" class="form-label fw-bold">الكمية المنقولة <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" class="form-control form-control-lg fw-bold text-primary" type="number" step="any" min="0.0001" required />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Unit" class="form-label fw-bold">وحدة القياس <span class="text-danger">*</span></label>
                        <input asp-for="Unit" class="form-control" placeholder="KG, علبة, كرتونة" required />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ReferenceNumber" class="form-label fw-bold">رقم الإذن / المستند</label>
                        <input asp-for="ReferenceNumber" class="form-control" placeholder="اختياري (TRSF-...)" />
                        <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات النقل</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات توثيقية إضافية عن سبب النقل أو أمر التوزيع"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">إلغاء</a>
                    <button type="submit" class="btn btn-info px-4 fw-bold text-dark">
                        <i class="fas fa-paper-plane me-1"></i> تنفيذ النقل المخزني
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function loadLocations(whSelectId, locSelectId, selectedLocationId) {
                var whId = $(whSelectId).val();
                if (!whId) {
                    $(locSelectId).html('<option value="">-- المنطقة العامة --</option>');
                    return;
                }
                $.get('/FinishedGoods/GetLocationsByWarehouse?warehouseId=' + whId, function (data) {
                    var options = '<option value="">-- المنطقة العامة --</option>';
                    $.each(data, function (i, item) {
                        var isSel = (selectedLocationId && selectedLocationId == item.id) ? 'selected' : '';
                        options += '<option value="' + item.id + '" ' + isSel + '>' + item.name + ' (' + item.code + ')</option>';
                    });
                    $(locSelectId).html(options);
                });
            }

            $('#srcWhSelect').change(function () {
                loadLocations('#srcWhSelect', '#srcLocSelect');
            });

            $('#destWhSelect').change(function () {
                loadLocations('#destWhSelect', '#destLocSelect');
            });

            var initialSrcWh = $('#srcWhSelect').val();
            var initialSrcLoc = '@(Model?.SourceLocationId ?? 0)';
            if (initialSrcWh) {
                loadLocations('#srcWhSelect', '#srcLocSelect', initialSrcLoc);
            }

            var initialDestWh = $('#destWhSelect').val();
            var initialDestLoc = '@(Model?.DestinationLocationId ?? 0)';
            if (initialDestWh) {
                loadLocations('#destWhSelect', '#destLocSelect', initialDestLoc);
            }
        });
    </script>
}
