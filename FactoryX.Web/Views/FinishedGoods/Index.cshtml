@model IEnumerable<FactoryX.Application.DTOs.FinishedGoodsStockDto>
@{
    ViewData["Title"] = "مخزون المنتجات التامة (Finished Goods Inventory)";
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.FinishedGoodsStockSummaryDto;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-boxes-packing text-primary me-2"></i>مخزون المنتجات التامة (Finished Goods Stock)</h2>
            <p class="text-muted mb-0">متابعة أرصدة المنتجات التامة المفرجة بالمستودعات، تواريخ الصلاحية، والتتبع الشامل بالتشغيلة</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="FinishedGoodsReleases" asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> إفراج منتج تام جديد
            </a>
            <a asp-action="Movements" class="btn btn-outline-dark shadow-sm">
                <i class="fas fa-list-ol me-1"></i> سجل حركات المخزون
            </a>
            <a asp-action="Adjust" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-sliders me-1"></i> تسوية جردية
            </a>
            <a asp-action="Transfer" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-right-arrow-left me-1"></i> نقل داخلي
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small d-block">إجمالي كمية المخزون التام:</span>
                            <h3 class="fw-bold mb-0">@(summary != null ? summary.TotalQuantity.ToString("N0") : "0") <small class="fs-6">وحدة</small></h3>
                        </div>
                        <i class="fas fa-boxes-stacked fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small d-block">إجمالي القيمة التقديرية للمخزون:</span>
                            <h3 class="fw-bold mb-0">@(summary != null ? summary.TotalValue.ToString("C2") : "0.00 ر.س")</h3>
                        </div>
                        <i class="fas fa-coins fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info text-dark">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-dark small d-block opacity-75">عدد التشغيلات / المنتجات:</span>
                            <h3 class="fw-bold mb-0">@(summary != null ? summary.TotalBatchesCount : 0) <small class="fs-6">تشغيلة / @(summary != null ? summary.TotalProductsCount : 0) صنف</small></h3>
                        </div>
                        <i class="fas fa-barcode fa-2x text-dark opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-dark small d-block opacity-75">تنبيهات الصلاحية (أقل من 30 يوم):</span>
                            <h3 class="fw-bold mb-0">@(summary != null ? summary.ExpiringSoonCount : 0) <small class="fs-6">تشغيلة</small></h3>
                        </div>
                        <i class="fas fa-clock-rotate-left fa-2x text-dark opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">مستودع المنتجات التامة:</label>
                    <select name="warehouseId" asp-items="ViewBag.Warehouses" class="form-select">
                        <option value="">-- جميع مستودعات المنتجات التامة --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted">المنتج التام:</label>
                    <select name="productId" asp-items="ViewBag.Products" class="form-select">
                        <option value="">-- جميع المنتجات التامة --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">بحث برقم التشغيلة أو الكود:</label>
                    <input type="text" name="batchNumber" class="form-control" value="@ViewBag.BatchNumber" placeholder="B-2026..., PRD-..." />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search me-1"></i> تصفية</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Finished Goods Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-nowrap">
                        <tr>
                            <th class="ps-3">المنتج التام</th>
                            <th>كود الصنف / SKU</th>
                            <th>رقم التشغيلة (Batch)</th>
                            <th>المستودع / الموقع</th>
                            <th>الرصيد المتاح</th>
                            <th>تكلفة الوحدة</th>
                            <th>إجمالي القيمة</th>
                            <th>تاريخ الإنتاج</th>
                            <th>تاريخ الانتهاء</th>
                            <th class="text-center pe-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var stock in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <a asp-action="Details" asp-route-id="@stock.Id" class="fw-bold text-primary text-decoration-none">
                                            @stock.ProductName
                                        </a>
                                        @if (!string.IsNullOrEmpty(stock.ProductArabicName) && stock.ProductArabicName != stock.ProductName)
                                        {
                                            <small class="text-muted d-block">@stock.ProductArabicName</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@stock.ProductCode</span>
                                        <small class="text-muted d-block font-monospace">@stock.ProductSKU</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary font-monospace">@stock.BatchNumber</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@stock.WarehouseName</span>
                                        @if (!string.IsNullOrEmpty(stock.LocationName))
                                        {
                                            <small class="text-muted d-block">@stock.LocationName</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold fs-6 @(stock.Quantity > 0 ? "text-success" : "text-danger")">@stock.Quantity.ToString("N0")</span> @stock.Unit
                                    </td>
                                    <td>
                                        <span class="text-muted">@stock.UnitCost.ToString("C2")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@stock.TotalCost.ToString("C2")</span>
                                    </td>
                                    <td>
                                        <small>@stock.ProductionDate.ToString("yyyy-MM-dd")</small>
                                    </td>
                                    <td>
                                        @if (stock.IsExpired)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-triangle-exclamation me-1"></i>منتهي الصلاحية</span>
                                        }
                                        else if (stock.DaysUntilExpiry <= 30)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>متبقي @stock.DaysUntilExpiry يوم</span>
                                        }
                                        else
                                        {
                                            <small class="text-muted">@stock.ExpiryDate.ToString("yyyy-MM-dd")</small>
                                        }
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <a asp-action="Details" asp-route-id="@stock.Id" class="btn btn-sm btn-outline-info" title="عرض شجرة التتبع الشاملة">
                                            <i class="fas fa-eye me-1"></i>التتبع
                                        </a>
                                        <a asp-action="Adjust" asp-route-stockId="@stock.Id" class="btn btn-sm btn-outline-secondary" title="تسوية جردية">
                                            <i class="fas fa-sliders"></i>
                                        </a>
                                        <a asp-action="Transfer" asp-route-stockId="@stock.Id" class="btn btn-sm btn-outline-secondary" title="نقل بين المستودعات">
                                            <i class="fas fa-arrow-right-arrow-left"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="fas fa-boxes-packing fa-3x mb-3 text-secondary d-block"></i>
                                    لا توجد أرصدة منتجات تامة مسجلة حالياً بالمستودعات.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
