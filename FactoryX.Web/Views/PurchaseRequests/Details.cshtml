@model FactoryX.Application.DTOs.PurchaseRequestDto
@{
    ViewData["Title"] = $"تفاصيل طلب الشراء {Model.RequestNumber}";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-dark font-monospace fs-6">@Model.RequestNumber</span>
                <h2 class="fw-bold mb-0">طلب شراء مواد خام</h2>
                @switch (Model.Status)
                {
                    case FactoryX.Domain.Entities.PurchaseRequestStatus.Draft:
                        <span class="badge bg-secondary fs-6">مسودة (Draft)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseRequestStatus.Submitted:
                        <span class="badge bg-primary fs-6">مقدم للاعتماد (Submitted)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseRequestStatus.Approved:
                        <span class="badge bg-success fs-6"><i class="fas fa-check-circle me-1"></i>معتمد (Approved)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseRequestStatus.Rejected:
                        <span class="badge bg-danger fs-6"><i class="fas fa-times-circle me-1"></i>مرفوض (Rejected)</span>
                        break;
                    case FactoryX.Domain.Entities.PurchaseRequestStatus.Cancelled:
                        <span class="badge bg-dark fs-6">ملغي (Cancelled)</span>
                        break;
                }
            </div>
            <p class="text-muted mb-0">تاريخ الطلب: @Model.RequestDate.ToString("yyyy-MM-dd") | الأولوية: @Model.Priority</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.Status == FactoryX.Domain.Entities.PurchaseRequestStatus.Draft)
            {
                <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="fas fa-paper-plane me-1"></i> تقديم للاعتماد
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseRequestStatus.Submitted || Model.Status == FactoryX.Domain.Entities.PurchaseRequestStatus.Draft)
            {
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success shadow-sm">
                        <i class="fas fa-check me-1"></i> اعتماد الطلب
                    </button>
                </form>

                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger shadow-sm">
                        <i class="fas fa-times me-1"></i> رفض الطلب
                    </button>
                </form>
            }

            @if (Model.Status == FactoryX.Domain.Entities.PurchaseRequestStatus.Approved)
            {
                <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-fromRequestId="@Model.Id" class="btn btn-success shadow-sm">
                    <i class="fas fa-file-invoice-dollar me-1"></i> إنشاء أمر شراء من هذا الطلب
                </a>
            }

            @if (Model.Status != FactoryX.Domain.Entities.PurchaseRequestStatus.Cancelled && Model.Status != FactoryX.Domain.Entities.PurchaseRequestStatus.Rejected)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary shadow-sm" onclick="return confirm('هل أنت متأكد من إلغاء طلب الشراء؟');">
                        <i class="fas fa-ban me-1"></i> إلغاء الطلب
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Metadata Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">مقدم الطلب</span>
                    <span class="fw-bold">@(Model.RequestedByName ?? "المسؤول")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">تاريخ الاحتياج المطلوب</span>
                    <span class="fw-bold">@(Model.RequiredDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3">
                    <span class="text-muted small d-block">معتمد الطلب</span>
                    <span class="fw-bold">@(Model.ApprovedByName ?? "—")</span>
                    @if (Model.ApprovedAt.HasValue)
                    {
                        <small class="text-muted d-block">في: @Model.ApprovedAt.Value.ToString("yyyy-MM-dd HH:mm")</small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body py-3">
                    <span class="text-white-50 small d-block">إجمالي التكلفة التقديرية</span>
                    <h4 class="fw-bold mb-0">@Model.TotalEstimatedCost.ToString("N2") ج.م</h4>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body py-2">
                <span class="fw-bold text-secondary me-2"><i class="fas fa-sticky-note me-1"></i>ملاحظات:</span>
                <span>@Model.Notes</span>
            </div>
        </div>
    }

    <!-- Items Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <h6 class="mb-0 fw-bold"><i class="fas fa-list-ol text-primary me-2"></i>بنود المواد الخام المطلوبة</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>كود الخامة</th>
                            <th>اسم المادة الخام</th>
                            <th>الكمية المطلوبة</th>
                            <th>الوحدة</th>
                            <th>السعر التقديري</th>
                            <th class="text-end pe-3">إجمالي التكلفة التقديرية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr>
                                <td class="ps-3 text-muted">@(i + 1)</td>
                                <td><span class="badge bg-secondary font-monospace">@item.MaterialCode</span></td>
                                <td class="fw-bold">@item.MaterialName</td>
                                <td class="fw-bold font-monospace fs-6">@item.RequestedQuantity.ToString("N2")</td>
                                <td><span class="badge bg-light text-dark border">@item.Unit</span></td>
                                <td class="font-monospace">@item.EstimatedUnitPrice.ToString("N2") ج.م</td>
                                <td class="text-end pe-3 fw-bold font-monospace text-success">@item.EstimatedTotalPrice.ToString("N2") ج.م</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td colspan="6" class="text-end">الإجمالي التقديري للطلب:</td>
                            <td class="text-end pe-3 fs-5 text-success font-monospace">@Model.TotalEstimatedCost.ToString("N2") ج.م</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
