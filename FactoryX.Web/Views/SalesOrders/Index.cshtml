@model IEnumerable<FactoryX.Application.DTOs.SalesOrderDto>
@using FactoryX.Domain.Entities
@{
    ViewData["Title"] = "أوامر البيع (Sales Orders)";
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.SalesOrderSummaryDto;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-shopping-cart text-primary me-2"></i>أوامر البيع (Sales Orders)</h2>
            <p class="text-muted mb-0">إصدار ومتابعة أوامر بيع المنتجات التامة واعتمادها ومتابعة نسب الصرف والتسليم المخزني</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> إنشاء أمر بيع جديد
            </a>
            <a asp-controller="SalesFulfillments" asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-truck-loading me-1"></i> تسليم وصرف مبيعات
            </a>
            <a asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-users me-1"></i> سجل العملاء
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary KPI Cards -->
    @if (summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-2">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body py-3">
                        <span class="text-white-50 small d-block">إجمالي الأوامر</span>
                        <h3 class="fw-bold mb-0">@summary.TotalOrders</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm bg-secondary text-white">
                    <div class="card-body py-3">
                        <span class="text-white-50 small d-block">مسودات (Draft)</span>
                        <h3 class="fw-bold mb-0">@summary.DraftOrders</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body py-3">
                        <span class="text-white-50 small d-block">معتمدة جاهزة للتسليم</span>
                        <h3 class="fw-bold mb-0">@summary.ConfirmedOrders</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-warning text-dark">
                    <div class="card-body py-3">
                        <span class="text-black-50 small d-block">مستلم جزئياً (Partially)</span>
                        <h3 class="fw-bold mb-0">@summary.PartiallyFulfilledOrders</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body py-3">
                        <span class="text-white-50 small d-block">مكتمل التسليم (Fully)</span>
                        <h3 class="fw-bold mb-0">@summary.FullyFulfilledOrders</h3>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">بحث برقم الأمر أو العميل</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="رقم الأمر SO-..." value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">العميل</label>
                    <select name="customerId" class="form-select" asp-items="ViewBag.Customers">
                        <option value="">-- كل العملاء --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">حالة الأمر</label>
                    <select name="status" class="form-select">
                        <option value="">-- كل الحالات --</option>
                        @foreach (SalesOrderStatus st in Enum.GetValues(typeof(SalesOrderStatus)))
                        {
                            <option value="@st" selected="@(ViewBag.SelectedStatus != null && (SalesOrderStatus)ViewBag.SelectedStatus == st)">
                                @st.ToString()
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">المستودع</label>
                    <select name="warehouseId" class="form-select" asp-items="ViewBag.Warehouses">
                        <option value="">-- كل المستودعات --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> تصفية</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Sales Orders Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0"><i class="fas fa-list me-2 text-primary"></i>قائمة أوامر البيع (@Model.Count())</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم أمر البيع</th>
                        <th>العميل</th>
                        <th>تاريخ الطلب</th>
                        <th>المستودع</th>
                        <th>إجمالي الكمية</th>
                        <th>تم الصرف والتسليم</th>
                        <th>المتبقي</th>
                        <th>القيمة الإجمالية</th>
                        <th>الحالة</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="fas fa-shopping-cart fs-1 mb-2 d-block opacity-50"></i>
                                لا توجد أوامر بيع مطابقة للبحث
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-primary border font-monospace fs-6">@item.OrderNumber</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.CustomerName</div>
                                    <small class="text-muted font-monospace">@item.CustomerCode</small>
                                </td>
                                <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td>@item.WarehouseName</td>
                                <td class="font-monospace">@item.TotalOrderedQuantity.ToString("N2")</td>
                                <td class="font-monospace text-success fw-bold">@item.TotalFulfilledQuantity.ToString("N2")</td>
                                <td class="font-monospace text-danger">@item.RemainingQuantity.ToString("N2")</td>
                                <td class="fw-bold font-monospace">@item.TotalAmount.ToString("N2") EGP</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case SalesOrderStatus.Draft:
                                            <span class="badge bg-secondary"><i class="fas fa-pencil-alt me-1"></i>مسودة</span>
                                            break;
                                        case SalesOrderStatus.Confirmed:
                                            <span class="badge bg-primary"><i class="fas fa-check me-1"></i>معتمد</span>
                                            break;
                                        case SalesOrderStatus.PartiallyFulfilled:
                                            <span class="badge bg-info text-dark"><i class="fas fa-spinner me-1"></i>تسليم جزئي</span>
                                            break;
                                        case SalesOrderStatus.FullyFulfilled:
                                            <span class="badge bg-success"><i class="fas fa-check-double me-1"></i>مكتمل التسليم</span>
                                            break;
                                        case SalesOrderStatus.Cancelled:
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>ملغي</span>
                                            break;
                                        case SalesOrderStatus.Closed:
                                            <span class="badge bg-dark"><i class="fas fa-lock me-1"></i>مغلق</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.StatusName</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="عرض التفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.Status == SalesOrderStatus.Draft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if ((item.Status == SalesOrderStatus.Confirmed || item.Status == SalesOrderStatus.PartiallyFulfilled) && item.RemainingQuantity > 0)
                                        {
                                            <a asp-controller="SalesFulfillments" asp-action="Create" asp-route-salesOrderId="@item.Id" class="btn btn-success" title="تسليم وصرف مبيعات">
                                                <i class="fas fa-truck-loading"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
