@model FactoryX.Application.DTOs.UpdatePackagingBOMRequest
@{
    ViewData["Title"] = "تعديل مواصفة التعبئة والتغليف";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-edit text-primary me-2"></i>تعديل مواصفة التعبئة [@Model.Code]</h2>
            <p class="text-muted mb-0">تعديل البيانات العامة وحجم العبوة لمواصفة التعبئة والتغليف</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right me-1"></i> العودة لتفاصيل المواصفة
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0"><i class="fas fa-boxes-packing me-2"></i>بيانات مواصفة التعبئة والتغليف</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label fw-bold">كود المواصفة: <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control font-monospace" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold">اسم مواصفة التعبئة: <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="ProductId" class="form-label fw-bold">المنتج التام: <span class="text-danger">*</span></label>
                                <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select" required></select>
                                <span asp-validation-for="ProductId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PackSize" class="form-label fw-bold">حجم العبوة: <span class="text-danger">*</span></label>
                                <input asp-for="PackSize" class="form-control" type="number" step="0.01" min="0.01" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PackUnit" class="form-label fw-bold">وحدة العبوة:</label>
                                <input asp-for="PackUnit" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="PackSizeKg" class="form-label fw-bold">الوزن الصافي بالكجم: <span class="text-danger">*</span></label>
                                <input asp-for="PackSizeKg" class="form-control" type="number" step="0.001" min="0.001" required />
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-bold">الوصف والتفاصيل:</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label fw-bold">مواصفة نشطة</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="fas fa-save me-1"></i> حفظ التعديلات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
