@model FactoryX.Application.DTOs.PackagingBOMDto
@{
    ViewData["Title"] = $"تفاصيل مواصفة التعبئة - {Model.Code}";
    var costSummary = ViewBag.CostSummary as FactoryX.Application.DTOs.PackagingCostSummaryDto;
    var packagingMaterials = ViewBag.PackagingMaterials as IEnumerable<FactoryX.Application.DTOs.MaterialDto> ?? Enumerable.Empty<FactoryX.Application.DTOs.MaterialDto>();
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary fs-5 font-monospace">@Model.Code</span>
                <h2 class="fw-bold mb-0">@Model.Name</h2>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>نشط</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>معطل</span>
                }
            </div>
            <p class="text-muted mb-0">المنتج المرتبط: <strong>@Model.ProductName</strong> (@Model.ProductCode) | حجم العبوة: <strong>@Model.PackSize.ToString("0.##") @Model.PackUnit</strong> (@Model.PackSizeKg.ToString("0.###") كجم)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="fas fa-edit me-1"></i> تعديل المواصفة
            </a>
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#newVersionModal">
                <i class="fas fa-code-branch me-1"></i> إنشاء إصدار جديد
            </button>
            <a asp-controller="PackagingOrders" asp-action="Create" class="btn btn-info text-white">
                <i class="fas fa-plus me-1"></i> إنشاء أمر تعبئة
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i> العودة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Cost Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small d-block">تكلفة مواد التعبئة للعبوة الواحدة:</span>
                            <h3 class="fw-bold mb-0">@(costSummary != null ? costSummary.CostPerPack.ToString("C2") : Model.TotalPackagingMaterialCost.ToString("C2"))</h3>
                        </div>
                        <i class="fas fa-box-open fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small d-block">تكلفة التعبئة لكل 1 كجم منتج:</span>
                            <h3 class="fw-bold mb-0">@(costSummary != null ? costSummary.CostPerKg.ToString("C2") : "0.00 ر.س")</h3>
                        </div>
                        <i class="fas fa-scale-balanced fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-dark text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 small d-block">عدد مواد التعبئة في المواصفة:</span>
                            <h3 class="fw-bold mb-0">@Model.CurrentItems.Count مادة</h3>
                        </div>
                        <i class="fas fa-layer-group fa-2x text-white-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active BOM Items Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold"><i class="fas fa-list-check text-primary me-2"></i>قائمة مواد التعبئة والتغليف للعبوة (الإصدار النشط v@Model.ActiveVersionNumber)</h5>
            <span class="badge bg-info text-dark">الإصدار النشط</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 5%;">#</th>
                            <th style="width: 35%;">مادة التعبئة والتغليف</th>
                            <th style="width: 15%;">كود الخامة</th>
                            <th style="width: 15%;">الكمية المطلوبة للعبوة</th>
                            <th style="width: 15%;">تكلفة الوحدة</th>
                            <th style="width: 15%;" class="pe-3">إجمالي تكلفة البند</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CurrentItems != null && Model.CurrentItems.Any())
                        {
                            @foreach (var item in Model.CurrentItems.OrderBy(i => i.Sequence))
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@item.Sequence</td>
                                    <td class="fw-bold">
                                        @item.MaterialName
                                        @if (item.IsOptional)
                                        {
                                            <span class="badge bg-secondary ms-1">اختياري</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark font-monospace border">@item.MaterialCode</span></td>
                                    <td><span class="fw-bold text-primary">@item.QuantityRequired.ToString("0.####")</span> @item.Unit</td>
                                    <td>@item.MaterialUnitCost.ToString("C2")</td>
                                    <td class="pe-3 fw-bold text-success">@item.LineCost.ToString("C2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">لا توجد مواد تعبئة مسجلة في هذا الإصدار.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="5" class="text-end ps-3">إجمالي تكلفة مواد التعبئة للعبوة الواحدة:</td>
                            <td class="pe-3 text-success fs-5">@Model.TotalPackagingMaterialCost.ToString("C2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- BOM Versions History -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="card-title mb-0"><i class="fas fa-history me-2"></i>سجل إصدارات مواصفة التعبئة (Version History)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">رقم الإصدار</th>
                            <th>مسمى الإصدار</th>
                            <th>تاريخ السريان من</th>
                            <th>تاريخ السريان إلى</th>
                            <th>الحالة</th>
                            <th>تكلفة الإصدار</th>
                            <th>ملاحظات</th>
                            <th class="text-center pe-3">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Versions != null && Model.Versions.Any())
                        {
                            @foreach (var v in Model.Versions.OrderByDescending(v => v.VersionNumber))
                            {
                                <tr>
                                    <td class="ps-3 font-monospace fw-bold">v@v.VersionNumber</td>
                                    <td class="fw-bold">@v.VersionName</td>
                                    <td>@v.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                                    <td>@(v.EffectiveTo.HasValue ? v.EffectiveTo.Value.ToString("yyyy-MM-dd") : "مفتوح")</td>
                                    <td>
                                        @if (v.Status == FactoryX.Domain.Entities.PackagingBOMStatus.Active)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>نشط</span>
                                        }
                                        else if (v.Status == FactoryX.Domain.Entities.PackagingBOMStatus.Draft)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-pencil me-1"></i>مسودة</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">غير نشط</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">@v.PackagingCost.ToString("C2")</td>
                                    <td class="text-muted small">@v.Notes</td>
                                    <td class="text-center pe-3">
                                        @if (v.Status != FactoryX.Domain.Entities.PackagingBOMStatus.Active)
                                        {
                                            <form asp-action="ActivateVersion" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                <input type="hidden" name="bomId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="تفعيل هذا الإصدار">
                                                    <i class="fas fa-check me-1"></i> تفعيل
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="DeactivateVersion" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                <input type="hidden" name="bomId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="إلغاء التفعيل">
                                                    <i class="fas fa-ban me-1"></i> تعطيل
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create New Version -->
<div class="modal fade" id="newVersionModal" tabindex="-1" aria-labelledby="newVersionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="CreateVersion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PackagingBOMId" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="newVersionModalLabel"><i class="fas fa-code-branch me-2"></i>إنشاء إصدار جديد لمواصفة التعبئة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">اسم الإصدار: <span class="text-danger">*</span></label>
                            <input type="text" name="VersionName" class="form-control" placeholder="مثال: إصدار عبوة رمضان v2" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">تاريخ بدء السريان: <span class="text-danger">*</span></label>
                            <input type="date" name="EffectiveFrom" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">تاريخ انتهاء السريان (اختياري):</label>
                            <input type="date" name="EffectiveTo" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">حالة الإصدار:</label>
                            <select name="Status" class="form-select">
                                <option value="1">مسودة (Draft)</option>
                                <option value="2" selected>نشط (Active)</option>
                                <option value="3">غير نشط (Inactive)</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">ملاحظات الإصدار والتغييرات:</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="أسباب إنشاء هذا الإصدار والتعديلات المجراة على مواد التعبئة..."></textarea>
                        </div>
                    </div>

                    <div class="alert alert-info border-info mt-4 mb-0">
                        <i class="fas fa-info-circle me-1"></i>
                        سيتم نسخ بنود مواد التعبئة الحالية تلقائياً إلى هذا الإصدار الجديد ويمكنك تعديلها لاحقاً.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-1"></i> حفظ الإصدار</button>
                </div>
            </form>
        </div>
    </div>
</div>
