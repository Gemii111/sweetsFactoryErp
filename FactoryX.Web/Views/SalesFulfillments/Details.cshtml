@model FactoryX.Application.DTOs.SalesFulfillmentDto
@{
    ViewData["Title"] = $"إذن تسليم وصرف مبيعات - {Model.FulfillmentNumber}";
}

<div class="container-fluid py-3">
    <!-- Header Actions (Hidden in Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-file-invoice text-success me-2"></i>إذن تسليم وصرف مبيعات (Sales Delivery Note)</h2>
            <p class="text-muted mb-0">محضر تسليم بضاعة تامة للعميل وسند خصم مخزني رسمي</p>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-print me-1"></i> طباعة إذن التسليم
            </button>
            <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrderId" class="btn btn-outline-info shadow-sm">
                <i class="fas fa-shopping-cart me-1"></i> أمر البيع المرتبط
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Official Printable Certificate -->
    <div class="card border-0 shadow-sm p-4 print-card">
        <div class="card-body">
            <!-- Document Header -->
            <div class="row align-items-center border-bottom pb-4 mb-4">
                <div class="col-6">
                    <h3 class="fw-bold mb-1 text-primary">مصنع حلاوة المولد النبوي الشريف</h3>
                    <h5 class="text-muted mb-0">Mawlid Sweets Factory ERP — إدارة المبيعات والتوزيع</h5>
                </div>
                <div class="col-6 text-end">
                    <h2 class="fw-bold font-monospace mb-1 text-success">إذن تسليم مبيعات</h2>
                    <span class="badge bg-light text-primary border font-monospace fs-5">@Model.FulfillmentNumber</span>
                </div>
            </div>

            <!-- Document Meta Details -->
            <div class="row g-3 mb-4 bg-light p-3 rounded">
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">العميل المستلم:</small>
                    <div class="fw-bold fs-6">@Model.CustomerName</div>
                    <small class="font-monospace text-muted">@Model.CustomerCode</small>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">أمر البيع المعتمد:</small>
                    <div class="fw-bold font-monospace fs-6">@Model.SalesOrderNumber</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">مستودع الصرف:</small>
                    <div class="fw-bold">@Model.WarehouseName</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">تاريخ الصرف والتسليم:</small>
                    <div class="fw-bold font-monospace">@Model.FulfillmentDate.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>

            <!-- Shipped Items Table -->
            <h5 class="fw-bold mb-3"><i class="fas fa-boxes me-2 text-primary"></i>تفاصيل الأصناف والتشغيلات المصروفة</h5>
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 25%;">المنتج التام</th>
                            <th style="width: 15%;">رقم التشغيلة (Batch)</th>
                            <th style="width: 12%;">تاريخ الانتهاء</th>
                            <th style="width: 13%;">مكان التخزين</th>
                            <th style="width: 12%;">الكمية المصروفة</th>
                            <th style="width: 18%;">سعر الوحدة والقيمة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center font-monospace">@(i++)</td>
                                <td>
                                    <div class="fw-bold">@item.ProductName</div>
                                    <small class="text-muted font-monospace">@item.ProductCode</small>
                                </td>
                                <td class="text-center font-monospace fw-bold text-primary">@item.BatchNumber</td>
                                <td class="text-center font-monospace">@(item.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="text-center">@(item.LocationName ?? "الموقع الافتراضي")</td>
                                <td class="text-center font-monospace fw-bold fs-6 text-success">
                                    @item.ShippedQuantity.ToString("N2") @item.Unit
                                </td>
                                <td class="text-end font-monospace">
                                    <div>@item.UnitPrice.ToString("N2") EGP / @item.Unit</div>
                                    <small class="fw-bold text-dark">الإجمالي: @item.TotalPrice.ToString("N2") EGP</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="5" class="text-start">الإجمالي الكلي للشحنة:</th>
                            <th class="text-center font-monospace fs-5 text-success">@Model.TotalQuantity.ToString("N2") KG</th>
                            <th class="text-end font-monospace fs-5 fw-bold text-primary">@Model.TotalPrice.ToString("N2") EGP</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="alert alert-light border mb-4">
                    <small class="text-muted d-block fw-bold mb-1">ملاحظات التسليم والتوصيل:</small>
                    <div>@Model.Notes</div>
                </div>
            }

            <!-- Signatures Section -->
            <div class="row g-4 mt-4 pt-4 border-top">
                <div class="col-3 text-center">
                    <small class="text-muted d-block mb-4">أمين مستودع المنتجات التامة</small>
                    <div class="border-bottom pb-2 font-monospace">@(Model.ShippedByName ?? "المسؤول")</div>
                    <small class="text-muted">التوقيع والتاريخ</small>
                </div>
                <div class="col-3 text-center">
                    <small class="text-muted d-block mb-4">سائق / مندوب التوصيل</small>
                    <div class="border-bottom pb-2 text-muted">...................................</div>
                    <small class="text-muted">التوقيع ورقم السيارة</small>
                </div>
                <div class="col-3 text-center">
                    <small class="text-muted d-block mb-4">المستلم / مفوض العميل</small>
                    <div class="border-bottom pb-2 text-muted">...................................</div>
                    <small class="text-muted">الاسم والتوقيع بالاستلام</small>
                </div>
                <div class="col-3 text-center">
                    <small class="text-muted d-block mb-4">إدارة المبيعات والتوزيع</small>
                    <div class="border-bottom pb-2 text-muted">معتمد وصادر</div>
                    <small class="text-muted">الختم والاعتماد</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body {
            background-color: #fff !important;
        }
        .container-fluid {
            padding: 0 !important;
        }
        .print-card {
            box-shadow: none !important;
            border: 0 !important;
            padding: 0 !important;
        }
        .sidebar, .navbar, footer {
            display: none !important;
        }
    }
</style>
