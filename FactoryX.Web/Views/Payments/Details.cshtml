@model FactoryX.Application.DTOs.PaymentDto
@{
    ViewData["Title"] = $"سند قبض رقم {Model.PaymentNumber}";
}

<div class="container-fluid py-3">
    <!-- Header Actions (Hidden in Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-receipt text-success me-2"></i>سند قبض وتحصيل (Payment Receipt)</h2>
            <p class="text-muted mb-0">بيانات تحصيل القيمة وسند السداد المالي</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Receipt" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-print me-1"></i> طباعة إيصال القبض
            </a>
            <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-info shadow-sm">
                <i class="fas fa-file-invoice-dollar me-1"></i> الفاتورة المرتبطة
            </a>

            @if (Model.Status == FactoryX.Domain.Entities.PaymentStatus.Recorded)
            {
                <button type="button" class="btn btn-outline-danger shadow-sm" data-bs-toggle="modal" data-bs-target="#voidPaymentModal">
                    <i class="fas fa-undo me-1"></i> إلغاء / استرداد السند
                </button>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-right me-1"></i> العودة للقائمة
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Payment Details Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center pb-3 mb-3 border-bottom">
                <div class="col-md-6">
                    <span class="badge bg-light text-success border font-monospace fs-5 mb-2">@Model.PaymentNumber</span>
                    <h3 class="fw-bold mb-1">سند استلام نقدية / تحصيل</h3>
                    <p class="text-muted mb-0">تاريخ السداد: @Model.PaymentDate.ToString("yyyy-MM-dd")</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <span class="fs-5">حالة السند:</span>
                    @if (Model.Status == FactoryX.Domain.Entities.PaymentStatus.Recorded)
                    {
                        <span class="badge bg-success fs-6 ms-2">مثبت ومسجل (Recorded)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6 ms-2">ملغي / مسترد (Voided)</span>
                    }
                </div>
            </div>

            <!-- Meta Details -->
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">العميل المسدد:</small>
                    <div class="fw-bold fs-6">@Model.CustomerName</div>
                    <small class="text-muted font-monospace">@Model.CustomerCode</small>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">الفاتورة المفوترة:</small>
                    <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model.InvoiceId" class="fw-bold font-monospace text-decoration-none">
                        @Model.InvoiceNumber
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">طريقة السداد:</small>
                    <div class="fw-bold">@Model.PaymentMethodName</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">الرقم المرجعي / الشيك:</small>
                    <div class="fw-bold font-monospace">@(Model.ReferenceNumber ?? "—")</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">المبلغ المحصل:</small>
                    <div class="fw-bold text-success fs-4 font-monospace">@Model.Amount.ToString("N2") @Model.Currency</div>
                </div>
                <div class="col-md-3 col-6">
                    <small class="text-muted d-block">المستلم:</small>
                    <div class="fw-bold">@(Model.ReceivedByName ?? "المسؤول")</div>
                </div>
                <div class="col-md-6 col-12">
                    <small class="text-muted d-block">ملاحظات وبيان السند:</small>
                    <div>@(Model.Notes ?? "لا توجد ملاحظات إضافية.")</div>
                </div>
            </div>

            @if (Model.Status == FactoryX.Domain.Entities.PaymentStatus.Voided && !string.IsNullOrEmpty(Model.VoidReason))
            {
                <div class="alert alert-danger mt-4 mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i><strong>سبب الإلغاء / الاسترداد:</strong> @Model.VoidReason
                    @if (Model.VoidedAt.HasValue)
                    {
                        <span class="ms-2 text-muted">(@Model.VoidedAt.Value.ToString("yyyy-MM-dd HH:mm"))</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Void Payment Modal -->
<div class="modal fade" id="voidPaymentModal" tabindex="-1" aria-labelledby="voidPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="Void" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PaymentId" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="voidPaymentModalLabel"><i class="fas fa-undo me-2"></i>إلغاء / استرداد سند القبض</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">تحذير: سيتم إلغاء السند رقم [@Model.PaymentNumber] وإعادة إدراج المبلغ (@Model.Amount.ToString("N2") @Model.Currency) كرصيد مستحق على الفاتورة [@Model.InvoiceNumber].</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">سبب الإلغاء <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" required placeholder="أدخل سبب إلغاء أو استرداد هذا السند..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">تراجع</button>
                    <button type="submit" class="btn btn-danger">تأكيد إلغاء السند</button>
                </div>
            </form>
        </div>
    </div>
</div>
