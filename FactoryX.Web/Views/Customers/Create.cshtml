@model FactoryX.Application.DTOs.CreateCustomerRequest
@using FactoryX.Domain.Entities
@{
    ViewData["Title"] = "إضافة عميل جديد";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-user-plus text-primary me-2"></i>إضافة عميل جديد (Create Customer)</h2>
            <p class="text-muted mb-0">تسجيل بيانات العميل وجهات الاتصال والحد الائتماني</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-right me-1"></i> العودة للقائمة
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label fw-bold">كود العميل <span class="text-danger">*</span></label>
                                <input asp-for="Code" class="form-control font-monospace" placeholder="CUS-0001" required />
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Name" class="form-label fw-bold">اسم العميل (إنجليزي / تجاري) <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="اسم العميل..." required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ArabicName" class="form-label fw-bold">الاسم العربي للعميل</label>
                                <input asp-for="ArabicName" class="form-control" placeholder="الاسم باللغة العربية..." />
                                <span asp-validation-for="ArabicName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Type" class="form-label fw-bold">نوع العميل <span class="text-danger">*</span></label>
                                <select asp-for="Type" class="form-select">
                                    @foreach (CustomerType t in Enum.GetValues(typeof(CustomerType)))
                                    {
                                        <option value="@t">@t.ToString()</option>
                                    }
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ContactPerson" class="form-label fw-bold">الشخص المسؤول / المفوض</label>
                                <input asp-for="ContactPerson" class="form-control" placeholder="اسم مسؤول التواصل..." />
                                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="TaxNumber" class="form-label fw-bold">الرقم الضريبي</label>
                                <input asp-for="TaxNumber" class="form-control font-monospace" placeholder="الرقم الضريبي..." />
                                <span asp-validation-for="TaxNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Phone" class="form-label fw-bold">رقم الهاتف</label>
                                <input asp-for="Phone" class="form-control" placeholder="02..." />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Mobile" class="form-label fw-bold">رقم الجوال</label>
                                <input asp-for="Mobile" class="form-control" placeholder="01..." />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="client@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreditLimit" class="form-label fw-bold">الحد الائتماني (EGP)</label>
                                <input asp-for="CreditLimit" type="number" step="0.01" class="form-control font-monospace" value="0.00" />
                                <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch mt-4">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked />
                                    <label class="form-check-label fw-bold" for="isActiveSwitch">حساب العميل نشط (Active)</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-bold">العنوان التفصيلي / مكان التسليم</label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="العنوان، المدينة، المنطقة..."></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label fw-bold">ملاحظات إضافية</label>
                                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات وشروط خاصة بالعميل..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-1"></i> حفظ العميل
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
