@model FactoryX.Application.DTOs.WorkOrderDto
@{
    ViewData["Title"] = "تعديل أمر التشغيل";
}

<partial name="_Alert" />

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 bg-white">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4 text-center text-warning"><i class="bi bi-pencil me-2"></i>تعديل أمر التشغيل</h3>
                <form asp-action="Edit" method="post" autocomplete="off">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label fw-semibold">صنف الحلويات (المنتج)</label>
                        <select asp-for="ProductId" class="form-select" asp-items="ViewBag.Products">
                            <option value="">-- اختر المنتج --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MachineId" class="form-label fw-semibold">الماكينة / خط التصنيع</label>
                        <select asp-for="MachineId" class="form-select" asp-items="ViewBag.Machines">
                            <option value="">-- اختر الماكينة --</option>
                        </select>
                        <span asp-validation-for="MachineId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">الكمية المطلوبة للإنتاج</label>
                        <input asp-for="Quantity" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold">تاريخ بدء التشغيل</label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold">تاريخ الانتهاء المتوقع</label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-semibold">حالة الأمر</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Created">جديد (Created)</option>
                            <option value="InProgress">قيد التشغيل (InProgress)</option>
                            <option value="Completed">مكتمل (Completed)</option>
                            <option value="Cancelled">ملغي (Cancelled)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill"><i class="bi bi-arrow-right"></i> إلغاء</a>
                        <button type="submit" class="btn btn-warning px-4 rounded-pill shadow-sm"><i class="bi bi-check-lg"></i> حفظ التعديلات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}