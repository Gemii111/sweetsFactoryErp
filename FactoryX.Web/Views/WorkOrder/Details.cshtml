@model FactoryX.Application.DTOs.WorkOrderDto
@{
    ViewData["Title"] = "تفاصيل أمر التشغيل";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center text-primary"><i class="bi bi-list-task me-2"></i>تفاصيل أمر التشغيل #@Model.Id</h3>
                    <dl class="row mb-4">
                        <dt class="col-5 text-muted">صنف الحلويات</dt>
                        <dd class="col-7 fw-bold">@Model.ProductName</dd>
                        <dt class="col-5 text-muted">الماكينة / الخط</dt>
                        <dd class="col-7">@Model.MachineName</dd>
                        <dt class="col-5 text-muted">الكمية المستهدفة</dt>
                        <dd class="col-7 fw-bold text-success">@Model.Quantity</dd>
                        <dt class="col-5 text-muted">تاريخ البدء</dt>
                        <dd class="col-7">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-5 text-muted">تاريخ الانتهاء</dt>
                        <dd class="col-7">@Model.EndDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-5 text-muted">الحالة التشغيلية</dt>
                        <dd class="col-7"><span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">@Model.Status</span></dd>
                    </dl>
                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill"><i class="bi bi-arrow-right"></i> عودة للقائمة</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 rounded-pill shadow-sm"><i class="bi bi-pencil"></i> تعديل</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>