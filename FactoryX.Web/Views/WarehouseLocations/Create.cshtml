@model FactoryX.Application.DTOs.CreateWarehouseLocationRequest

@{
    ViewData["Title"] = "إضافة موقع تخزين جديد";
    var warehouses = ViewBag.Warehouses as IEnumerable<FactoryX.Application.DTOs.WarehouseDto> ?? new List<FactoryX.Application.DTOs.WarehouseDto>();
    int? selectedWarehouseId = ViewBag.SelectedWarehouseId;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" asp-route-warehouseId="@selectedWarehouseId" class="btn btn-light rounded-circle ms-3"><i class="bi bi-arrow-right"></i></a>
            <div>
                <h2 class="fw-bold mb-0">إضافة مكان تخزين / رف</h2>
                <small class="text-muted">تعريف رف، ممر، أو قطاع تخزين محدد داخل المستودع.</small>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="WarehouseId" class="form-label fw-semibold">المستودع التابع له</label>
                        <select asp-for="WarehouseId" class="form-select" required>
                            <option value="">-- اختر المستودع --</option>
                            @foreach (var wh in warehouses)
                            {
                                <option value="@wh.Id" selected="@(wh.Id == selectedWarehouseId)">@wh.Name (@wh.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-semibold">كود الموقع / الرف</label>
                            <input asp-for="Code" class="form-control" placeholder="مثال: A-01-R2" required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Section" class="form-label fw-semibold">المنطقة / القطاع</label>
                            <input asp-for="Section" class="form-control" placeholder="مثال: قطاع السكر / ممر 1" />
                            <span asp-validation-for="Section" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">اسم مكان التخزين</label>
                        <input asp-for="Name" class="form-control" placeholder="مثال: رف المكسرات والسمسم 2" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">الوصف والملاحظات</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="ملاحظات حول سعة الرف أو درجة الحرارة..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" asp-route-warehouseId="@selectedWarehouseId" class="btn btn-light px-4">إلغاء</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-save me-1"></i>حفظ المكان</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
