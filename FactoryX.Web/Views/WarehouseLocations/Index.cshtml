@model IEnumerable<FactoryX.Application.DTOs.WarehouseLocationDto>

@{
    ViewData["Title"] = "أماكن التخزين والرفوف";
    var warehouses = ViewBag.Warehouses as IEnumerable<FactoryX.Application.DTOs.WarehouseDto> ?? new List<FactoryX.Application.DTOs.WarehouseDto>();
    int? selectedWarehouseId = ViewBag.SelectedWarehouseId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-geo-alt text-info me-2"></i>أماكن التخزين والرفوف</h2>
        <p class="text-muted mb-0">إدارة الممرات، الأرفف، والقطاعات داخل المستودعات.</p>
    </div>
    <a asp-action="Create" asp-route-warehouseId="@selectedWarehouseId" class="btn btn-primary shadow-sm px-3"><i class="bi bi-plus-lg me-1"></i>إضافة موقع جديد</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-6 col-lg-4">
                <label class="form-label small text-muted fw-semibold mb-1">اختر المستودع</label>
                <select name="warehouseId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- اختر المستودع لعرض رفوفه --</option>
                    @foreach (var wh in warehouses)
                    {
                        <option value="@wh.Id" selected="@(wh.Id == selectedWarehouseId)">@wh.Name (@wh.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-6 col-lg-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary px-4 ms-2"><i class="bi bi-filter me-1"></i>تصفية</button>
                <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">كود الموقع</th>
                        <th>اسم الموقع / الرف</th>
                        <th>المستودع</th>
                        <th>المنطقة / القطاع</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                @(selectedWarehouseId.HasValue ? "لا توجد أماكن تخزين مسجلة في هذا المستودع." : "يرجى اختيار مستودع من القائمة أعلاه لعرض أماكن التخزين الخاصة به.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-info">@item.Code</td>
                                <td>
                                    <div class="fw-bold">@item.Name</div>
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.WarehouseName</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@item.Section</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">معطل</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light ms-1" title="تعديل"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-warehouseId="@item.WarehouseId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="تغيير الحالة">
                                            <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
