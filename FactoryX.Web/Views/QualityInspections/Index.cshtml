@model IEnumerable<FactoryX.Application.DTOs.QualityInspectionDto>
@using FactoryX.Domain.Entities

@{
    ViewData["Title"] = "سجل فحوصات الجودة ومطابقة الدفعات";
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.QualityInspectionSummaryDto;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-shield-check me-2"></i> رقابة الجودة والإفراج عن دفعات الإنتاج (QC Release Gate)
            </h2>
            <p class="text-muted mb-0">تقييم مطابقة دفعات الإنتاج التام وفق المواصفات القياسية واعتماد الإفراج أو الرفض أو الاحتجاز</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="QualityTemplates" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-card-checklist me-1"></i> قوالب ومعايير الفحص
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> فتح فحص جودة لدفعة إنتاج
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Summary Cards -->
    @if (summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 bg-success text-white p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small">دفعات معتمدة ومطابقة للإفراج</div>
                            <div class="fs-3 fw-bold">@summary.ApprovedCount <small class="fs-6">دفعة</small></div>
                            <small class="text-white-50">مؤهلة للإفراج النهائي</small>
                        </div>
                        <div class="bg-white bg-opacity-25 p-3 rounded-circle">
                            <i class="bi bi-patch-check-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">قيد الفحص والتقييم</div>
                            <div class="fs-3 fw-bold text-primary">@summary.InProgressCount</div>
                            <small class="text-muted">تسجيل القياسات الفعلية</small>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">دفعات محتجزة (Hold)</div>
                            <div class="fs-3 fw-bold text-warning">@summary.HoldCount</div>
                            <small class="text-muted">تتطلب فحص إضافي / تحقيق</small>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                            <i class="bi bi-pause-circle fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">دفعات مرفوضة (Rejected)</div>
                            <div class="fs-3 fw-bold text-danger">@summary.RejectedCount</div>
                            <small class="text-muted">غير مطابقة ومحظورة من الإفراج</small>
                        </div>
                        <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                            <i class="bi bi-x-octagon-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="بحث برقم الفحص أو الدفعة أو المنتج..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- كل الحالات --</option>
                        <option value="InProgress" selected="@(ViewBag.SelectedStatus?.ToString() == "InProgress")">قيد التنفيذ (In Progress)</option>
                        <option value="Pending" selected="@(ViewBag.SelectedStatus?.ToString() == "Pending")">معلق للاعتماد (Pending)</option>
                        <option value="Approved" selected="@(ViewBag.SelectedStatus?.ToString() == "Approved")">معتمد (Approved)</option>
                        <option value="Rejected" selected="@(ViewBag.SelectedStatus?.ToString() == "Rejected")">مرفوض (Rejected)</option>
                        <option value="Hold" selected="@(ViewBag.SelectedStatus?.ToString() == "Hold")">محجوز (Hold)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="decision" class="form-select form-select-sm">
                        <option value="">-- كل القرارات --</option>
                        <option value="Approved" selected="@(ViewBag.SelectedDecision?.ToString() == "Approved")">مطابق (Approved)</option>
                        <option value="Rejected" selected="@(ViewBag.SelectedDecision?.ToString() == "Rejected")">غير مطابق (Rejected)</option>
                        <option value="Hold" selected="@(ViewBag.SelectedDecision?.ToString() == "Hold")">معلق (Hold)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" title="من تاريخ" />
                </div>
                <div class="col-md-2">
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" title="إلى تاريخ" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
                    <a asp-action="Index" class="btn btn-light btn-sm" title="إعادة تعيين"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">رقم الفحص</th>
                        <th>دفعة الإنتاج</th>
                        <th>المنتج التام</th>
                        <th>المواصفة القياسية</th>
                        <th>تاريخ الفحص</th>
                        <th>التوصية الآلية</th>
                        <th class="text-center">القرار النهائي</th>
                        <th class="text-center">بوابة الإفراج</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                                لا توجد سجلات فحص جودة مسجلة حالياً
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold font-monospace text-primary text-decoration-none">
                                        @item.InspectionNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="fw-bold font-monospace text-dark">
                                        <i class="bi bi-layers me-1 text-primary"></i> @(item.ProductionBatchNumber ?? "-")
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.ProductName ?? "-")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.QualityTemplateCode ?? "-")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.InspectionDate.ToString("yyyy-MM-dd")
                                </td>
                                <td>
                                    @if (item.RecommendedDecision == QualityDecision.Approved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> توصية: مطابق
                                        </span>
                                    }
                                    else if (item.RecommendedDecision == QualityDecision.Rejected)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i> توصية: راسب
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                            قيد التقييم
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.FinalDecision == QualityDecision.Approved)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> معتمد (Approved)
                                        </span>
                                    }
                                    else if (item.FinalDecision == QualityDecision.Rejected)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-x-octagon-fill me-1"></i> مرفوض (Rejected)
                                        </span>
                                    }
                                    else if (item.FinalDecision == QualityDecision.Hold)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                                            <i class="bi bi-pause-circle-fill me-1"></i> محجوز (Hold)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> معلق
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.FinalDecision == QualityDecision.Approved && item.Status == QualityInspectionStatus.Approved)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1" title="مسموح بالإفراج للمنتجات التامة">
                                            <i class="bi bi-unlock-fill me-1"></i> RELEASED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1" title="محظور من الإفراج">
                                            <i class="bi bi-lock-fill me-1"></i> BLOCKED
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="عرض التقرير">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (item.Status != QualityInspectionStatus.Approved && item.Status != QualityInspectionStatus.Cancelled)
                                        {
                                            <a asp-action="Inspect" asp-route-id="@item.Id" class="btn btn-primary" title="تسجيل وفحص القياسات">
                                                <i class="bi bi-clipboard2-check me-1"></i> فحص
                                            </a>
                                        }

                                        @if (item.FinalDecision == QualityDecision.Rejected || item.FinalDecision == QualityDecision.Hold)
                                        {
                                            <a asp-action="Reinspect" asp-route-id="@item.Id" class="btn btn-outline-warning" title="إعادة فحص الدفعة">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
