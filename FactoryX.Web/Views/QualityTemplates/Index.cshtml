@model IEnumerable<FactoryX.Application.DTOs.QualityTemplateDto>

@{
    ViewData["Title"] = "قوالب ومواصفات فحص الجودة (QC Templates)";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-card-checklist me-2"></i> قوالب ومعايير فحص الجودة (QC Specifications)
            </h2>
            <p class="text-muted mb-0">إدارة المواصفات القياسية ومعايير القبول والرفض لحلويات المولد النبوي الشريف</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="QualityInspections" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> سجل فحوصات الجودة
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> إضافة مواصفة قياسية جديدة
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2 align-items-center">
                    <a asp-action="Index" asp-route-onlyActive="false" class="btn btn-sm @(ViewBag.OnlyActive == false ? "btn-primary" : "btn-outline-secondary")">
                        الكل (@Model.Count())
                    </a>
                    <a asp-action="Index" asp-route-onlyActive="true" class="btn btn-sm @(ViewBag.OnlyActive == true ? "btn-primary" : "btn-outline-secondary")">
                        النشطة فقط (@Model.Count(t => t.IsActive))
                    </a>
                </div>
                <div class="text-muted small">
                    إجمالي القوالب المسجلة: <strong class="text-dark">@Model.Count()</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">كود القالب</th>
                        <th>اسم المواصفة القياسية</th>
                        <th>المنتج / التصنيف المرتبط</th>
                        <th class="text-center">عدد المعايير</th>
                        <th class="text-center">الحالة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                                لا توجد قوالب فحص جودة مسجلة حالياً
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-primary border fw-bold font-monospace fs-6">
                                        @item.Code
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none text-dark d-block">
                                        @item.Name
                                    </a>
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ProductName))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-box me-1"></i> منتج: @item.ProductName
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(item.ProductCategoryName))
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            <i class="bi bi-tags me-1"></i> تصنيف: @item.ProductCategoryName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            عام لكافة المنتجات
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                        @item.ItemsCount معيار
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i> نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i> معطل
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="عرض التفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="تعديل">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" 
                                                    title="@(item.IsActive ? "تعطيل" : "تفعيل")"
                                                    onclick="return confirm('هل أنت متأكد من تغيير حالة تفعيل هذا القالب؟');">
                                                <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
