@model FactoryX.Application.DTOs.SupplierLedgerDto
@{
    ViewData["Title"] = "كشف حساب مورد محاسبي (Supplier Subledger)";
    var suppliers = ViewBag.Suppliers as IEnumerable<FactoryX.Application.DTOs.SupplierDto> ?? new List<FactoryX.Application.DTOs.SupplierDto>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-truck-flatbed text-primary me-2"></i>كشف حساب الأستاذ المساعد للموردين</h2>
        <p class="text-muted mb-0">كشف مالي تفصيلي لمشتريات وسندات صرف وسداد الموردين من واقع القيود المحاسبية</p>
    </div>
</div>

<!-- Filter Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold mb-1">اختر المورد</label>
                <select name="supplierId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id" selected="@(s.Id == (int?)ViewBag.SelectedSupplierId)">@s.Code - @s.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">من تاريخ</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
            </div>

            <div class="col-md-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter"></i> عرض</button>
            </div>
        </form>
    </div>
</div>

@if (Model == null)
{
    <div class="card shadow-sm border-0 py-5 text-center text-muted">
        <i class="bi bi-truck fs-1 d-block mb-2"></i>
        <h5>يرجى اختيار مورد لعرض كشف الحساب</h5>
    </div>
}
else
{
    <!-- Summary Header Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light p-3">
                <small class="text-muted">الرصيد الافتتاحي المستحق للمورد</small>
                <h4 class="fw-bold mb-0 font-monospace @(Model.OpeningBalance >= 0 ? "text-dark" : "text-danger")">
                    @Model.OpeningBalance.ToString("N2") EGP
                </h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light p-3">
                <small class="text-muted">إجمالي المشتريات والاستحقاقات (دائن)</small>
                <h4 class="fw-bold mb-0 text-danger font-monospace">@Model.TotalPurchaseCredit.ToString("N2") EGP</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-light p-3">
                <small class="text-muted">إجمالي السدادات والصرف للمورد (مدين)</small>
                <h4 class="fw-bold mb-0 text-success font-monospace">@Model.TotalPaymentDebit.ToString("N2") EGP</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark p-3">
                <small class="text-dark-50">صافي المستحق للمورد حالياً</small>
                <h4 class="fw-bold mb-0 font-monospace">@Model.OutstandingPayable.ToString("N2") EGP</h4>
            </div>
        </div>
    </div>

    <!-- Details Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i>كشف حركات المورد: @Model.SupplierCode - @Model.SupplierName</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">التاريخ</th>
                            <th>رقم القيد</th>
                            <th>نوع الحركة</th>
                            <th>رقم المستند</th>
                            <th>البيان والشرح</th>
                            <th class="text-end">مدين (سداد وصرف)</th>
                            <th class="text-end">دائن (استلام مشتريات)</th>
                            <th class="text-end pe-3">الرصيد التراكمي (EGP)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="table-secondary">
                            <td colspan="7" class="ps-3 fw-bold">الرصيد الافتتاحي:</td>
                            <td class="text-end pe-3 font-monospace fw-bold">@Model.OpeningBalance.ToString("N2")</td>
                        </tr>

                        @if (!Model.Rows.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-3 text-muted">لا توجد حركات مسجلة للمورد خلال هذه الفترة</td>
                            </tr>
                        }
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3">@row.Date.ToString("yyyy-MM-dd")</td>
                                <td class="font-monospace fw-bold">
                                    <a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@row.JournalEntryId" class="text-decoration-none">
                                        @row.JournalNumber
                                    </a>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-dark border">@row.DocumentType</span></td>
                                <td class="font-monospace">@(row.DocumentNumber ?? "-")</td>
                                <td>@row.Description</td>
                                <td class="text-end font-monospace fw-bold @(row.Debit > 0 ? "text-success" : "text-muted")">
                                    @(row.Debit > 0 ? row.Debit.ToString("N2") : "-")
                                </td>
                                <td class="text-end font-monospace fw-bold @(row.Credit > 0 ? "text-danger" : "text-muted")">
                                    @(row.Credit > 0 ? row.Credit.ToString("N2") : "-")
                                </td>
                                <td class="text-end font-monospace fw-bold pe-3 @(row.RunningBalance >= 0 ? "text-dark" : "text-danger")">
                                    @row.RunningBalance.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold font-monospace">
                        <tr>
                            <td colspan="5" class="text-end ps-3">صافي المستحق الختامي للمورد:</td>
                            <td class="text-end text-success">@Model.TotalPaymentDebit.ToString("N2")</td>
                            <td class="text-end text-danger">@Model.TotalPurchaseCredit.ToString("N2")</td>
                            <td class="text-end pe-3 fs-6 text-dark">@Model.OutstandingPayable.ToString("N2") EGP</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
