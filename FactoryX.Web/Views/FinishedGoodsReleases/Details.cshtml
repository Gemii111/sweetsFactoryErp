@model FactoryX.Application.DTOs.FinishedGoodsReleaseDto
@{
    ViewData["Title"] = $"سند إفراج منتج تام — {Model.ReleaseNumber}";
}

<div class="container py-3" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-file-invoice text-success me-2"></i>سند إفراج منتج تام (FG Release Note)</h2>
            <p class="text-muted mb-0">سند استلام وتخزين رسمي معتمد لمنتج تام بعد اجتياز الفحص والجودة</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="fas fa-arrow-left me-1"></i> العودة للسندات
            </a>
            <a asp-controller="FinishedGoods" asp-action="Index" class="btn btn-outline-primary shadow-sm">
                <i class="fas fa-boxes-packing me-1"></i> أرصدة المخزون
            </a>
            <button onclick="window.print()" class="btn btn-dark shadow-sm">
                <i class="fas fa-print me-1"></i> طباعة السند
            </button>
        </div>
    </div>

    <!-- Printable Release Certificate Card -->
    <div class="card shadow-sm border-0 border-top border-4 border-success">
        <div class="card-body p-4 p-md-5">
            <!-- Header Section -->
            <div class="row align-items-center mb-4 pb-3 border-bottom">
                <div class="col-sm-6">
                    <h3 class="fw-bold text-success mb-1">سند إفراج وتخزين منتج تام</h3>
                    <span class="text-muted small">نظام إدارة مصنع حلويات المولد النبوي الشريف</span>
                </div>
                <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                    <span class="text-muted small d-block">رقم السند المرجعي:</span>
                    <h4 class="fw-bold text-dark font-monospace mb-0">@Model.ReleaseNumber</h4>
                    <small class="text-muted">تاريخ الإصدار: @Model.ReleasedAt.ToString("yyyy-MM-dd HH:mm")</small>
                </div>
            </div>

            <!-- Product and Batch Identification -->
            <div class="bg-light p-4 rounded border mb-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <span class="text-muted small d-block">المنتج التام:</span>
                        <h4 class="fw-bold text-primary mb-1">@Model.ProductName</h4>
                        <span class="badge bg-light text-dark border font-monospace me-1">@Model.ProductCode</span>
                        <span class="badge bg-light text-secondary border font-monospace">SKU: @Model.ProductSKU</span>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <span class="text-muted small d-block">رقم تشغيلة الإنتاج (Batch #):</span>
                        <h4 class="fw-bold text-dark font-monospace mb-1">@Model.BatchNumber</h4>
                        <small class="text-muted">أمر الإنتاج: @(Model.WorkOrderNumber ?? "إنتاج مباشر")</small>
                    </div>
                </div>
            </div>

            <!-- Release Details Table -->
            <table class="table table-bordered mb-4">
                <thead class="table-light">
                    <tr>
                        <th>البيان والمواصفة</th>
                        <th>التفاصيل المسجلة</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold bg-light" style="width: 35%;">الكمية المفرجة المعتمدة:</td>
                        <td>
                            <span class="fw-bold text-success fs-5">@Model.Quantity.ToString("N0")</span> @Model.Unit
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">مستودع الاستلام النهائي:</td>
                        <td>
                            <strong class="text-dark">@Model.WarehouseName</strong> (@Model.WarehouseCode)
                            @if (!string.IsNullOrEmpty(Model.LocationName))
                            {
                                <span class="badge bg-light text-dark border ms-2">الموقع: @Model.LocationName</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">فحص الجودة وبوابة الإفراج (QC Gate):</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.QCInspectionNumber))
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>مطابق ومعتمد — تقرير: @Model.QCInspectionNumber</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>معتمد ومطابق للمواصفة القياسية</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">أمر التعبئة والتغليف (Packaging):</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.PackagingOrderNumber))
                            {
                                <span>أمر مكتمل: <strong>@Model.PackagingOrderNumber</strong> (@(Model.ActualPackagedQuantity?.ToString("N0") ?? "-") عبوة) — @(Model.PackagingBOMName ?? "")</span>
                            }
                            else
                            {
                                <span class="text-muted">تعبئة مباشرة / منتج خام</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">تكلفة الوحدة المحتسبة:</td>
                        <td>
                            <span>@Model.UnitCost.ToString("C2") / @Model.Unit</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">إجمالي القيمة المخزنية:</td>
                        <td>
                            <strong class="text-primary fs-6">@Model.TotalCost.ToString("C2")</strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">تاريخ الإنتاج والصلاحية:</td>
                        <td>
                            <span>إنتاج: <strong>@Model.ProductionDate.ToString("yyyy-MM-dd")</strong> | انتهاء: <strong>@Model.ExpiryDate.ToString("yyyy-MM-dd")</strong></span>
                        </td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <tr>
                            <td class="fw-bold bg-light">ملاحظات:</td>
                            <td>@Model.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Signatures Section -->
            <div class="row pt-4 mt-4 border-top text-center">
                <div class="col-4">
                    <span class="text-muted small d-block mb-4">مسؤول الإفراج والتسجيل:</span>
                    <strong class="text-dark">@Model.ReleasedByUserName</strong>
                    <div class="border-bottom mx-auto mt-2" style="width: 80%;"></div>
                </div>
                <div class="col-4">
                    <span class="text-muted small d-block mb-4">مسؤول رقابة الجودة (QC):</span>
                    <strong class="text-dark">إدارة الجودة والمطابقة</strong>
                    <div class="border-bottom mx-auto mt-2" style="width: 80%;"></div>
                </div>
                <div class="col-4">
                    <span class="text-muted small d-block mb-4">أمين مستودع المنتجات التامة:</span>
                    <strong class="text-dark">أمين مستودع @Model.WarehouseName</strong>
                    <div class="border-bottom mx-auto mt-2" style="width: 80%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
