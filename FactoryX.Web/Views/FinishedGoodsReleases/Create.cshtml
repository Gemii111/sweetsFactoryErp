@model FactoryX.Application.DTOs.CreateFinishedGoodsReleaseRequest
@{
    ViewData["Title"] = "إفراج منتج تام جديد (Release Finished Goods)";
}

<div class="container py-3" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-file-circle-check text-primary me-2"></i>منصة إفراج المنتج التام (Finished Goods Release Cockpit)</h2>
            <p class="text-muted mb-0">التحقق من بوابات الجودة والتعبئة واحتساب الكمية المتاحة للإفراج والتخزين</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> العودة للقائمة
        </a>
    </div>

    <form asp-action="Create" method="post" id="releaseForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

        <!-- 1. Batch Selection Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-barcode me-2"></i>1. تحديد دفعة الإنتاج المستهدفة للإفراج
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="ProductionBatchId" class="form-label fw-bold">اختر تشغيلة / دفعة الإنتاج <span class="text-danger">*</span></label>
                        <select asp-for="ProductionBatchId" asp-items="ViewBag.Batches" class="form-select form-select-lg" id="batchSelect" required>
                            <option value="">-- اختر دفعة الإنتاج المكتملة --</option>
                        </select>
                        <span asp-validation-for="ProductionBatchId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Interactive Gate & Releasable Status Card -->
        <div class="card shadow-sm border-0 mb-4 d-none" id="gateCard">
            <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fas fa-shield-halved me-2"></i>2. بوابات الاعتماد واحتساب الكمية المتاحة</span>
                <span class="badge bg-light text-dark font-monospace" id="productBadge"></span>
            </div>
            <div class="card-body">
                <!-- Gate Alert Status -->
                <div id="gateAlert" class="alert mb-3"></div>

                <!-- Gate Status Row -->
                <div class="row g-3 mb-3">
                    <!-- QC Gate Column -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light h-100">
                            <h6 class="fw-bold mb-2"><i class="fas fa-microscope text-info me-1"></i>بوابة الجودة (QC Release Gate)</h6>
                            <div id="qcGateContent">
                                <span class="text-muted small">جاري التحقق...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Packaging Gate Column -->
                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light h-100">
                            <h6 class="fw-bold mb-2"><i class="fas fa-boxes-packing text-warning me-1"></i>بوابة التعبئة والتغليف (Packaging Gate)</h6>
                            <div id="pkgGateContent">
                                <span class="text-muted small">جاري التحقق...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quantities & Cost Matrix -->
                <div class="bg-light p-3 rounded border">
                    <h6 class="fw-bold text-dark mb-3"><i class="fas fa-calculator me-1"></i>مصفوفة احتساب الكمية المتاحة للإفراج:</h6>
                    <div class="row g-3 text-center">
                        <div class="col-md-3 border-end">
                            <span class="text-muted small d-block">إجمالي الإنتاج الفعلي:</span>
                            <h5 class="fw-bold mb-0 text-dark" id="actualQtyVal">-</h5>
                        </div>
                        <div class="col-md-3 border-end">
                            <span class="text-muted small d-block">المرفوضات المستبعدة:</span>
                            <h5 class="fw-bold mb-0 text-danger" id="rejectedQtyVal">-</h5>
                        </div>
                        <div class="col-md-3 border-end">
                            <span class="text-muted small d-block">المفرَج عنه سابقاً:</span>
                            <h5 class="fw-bold mb-0 text-secondary" id="releasedQtyVal">-</h5>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">الكمية المتبقية المتاحة:</span>
                            <h4 class="fw-bold mb-0 text-success" id="remainingQtyVal">-</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Release Execution Details Card -->
        <div class="card shadow-sm border-0 mb-4" id="detailsCard">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-warehouse me-2"></i>3. بيانات سند الإفراج ومستودع المنتجات التامة
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="WarehouseId" class="form-label fw-bold">مستودع المنتجات التامة <span class="text-danger">*</span></label>
                        <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select" id="warehouseSelect" required>
                            <option value="">-- اختر مستودع المنتجات التامة --</option>
                        </select>
                        <small class="text-muted d-block mt-1"><i class="fas fa-shield me-1"></i>يُقبل فقط المستودعات المصنفة (Finished Goods Warehouse).</small>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LocationId" class="form-label fw-bold">موقع التخزين بالمستودع (اختياري)</label>
                        <select asp-for="LocationId" class="form-select" id="locationSelect">
                            <option value="">-- المنطقة العامة بالمستودع --</option>
                        </select>
                        <span asp-validation-for="LocationId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label fw-bold">كمية الإفراج المراد تخزينها <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Quantity" class="form-control form-control-lg fw-bold text-success" type="number" step="any" min="0.0001" id="releaseQtyInput" required />
                            <span class="input-group-text fw-bold" id="unitLabel">وحدة</span>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-primary" id="fillMaxBtn">
                            <i class="fas fa-angles-left me-1"></i> إفراج عن كامل الكمية المتاحة
                        </button>
                        <span asp-validation-for="Quantity" class="text-danger small d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">التكلفة التقديرية للكمية المفرجة</label>
                        <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                            <span class="text-muted small">تكلفة الوحدة: <strong id="unitCostVal">-</strong></span>
                            <span class="fw-bold text-primary fs-5" id="totalCostVal">-</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات الإفراج</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="ملاحظات توثيقية إضافية لسند إفراج المنتج التام"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-2">
            <a asp-action="Index" class="btn btn-light px-4">إلغاء</a>
            <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm" id="submitBtn" disabled>
                <i class="fas fa-check-circle me-1"></i> اعتماد وإصدار سند الإفراج
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentData = null;

            function loadLocations(warehouseId, selectedLocationId) {
                if (!warehouseId) {
                    $('#locationSelect').html('<option value="">-- المنطقة العامة بالمستودع --</option>');
                    return;
                }
                $.get('/FinishedGoods/GetLocationsByWarehouse?warehouseId=' + warehouseId, function (data) {
                    var options = '<option value="">-- المنطقة العامة بالمستودع --</option>';
                    $.each(data, function (i, item) {
                        var isSel = (selectedLocationId && selectedLocationId == item.id) ? 'selected' : '';
                        options += '<option value="' + item.id + '" ' + isSel + '>' + item.name + ' (' + item.code + ')</option>';
                    });
                    $('#locationSelect').html(options);
                });
            }

            $('#warehouseSelect').change(function () {
                loadLocations($(this).val());
            });

            var initialWh = $('#warehouseSelect').val();
            if (initialWh) {
                loadLocations(initialWh);
            }

            function fetchBatchInfo(batchId) {
                if (!batchId) {
                    $('#gateCard').addClass('d-none');
                    $('#submitBtn').prop('disabled', true);
                    return;
                }

                $.get('/FinishedGoodsReleases/GetBatchReleaseInfo?batchId=' + batchId, function (resp) {
                    if (!resp.success) {
                        alert(resp.message);
                        return;
                    }

                    currentData = resp.data;
                    $('#gateCard').removeClass('d-none');
                    $('#productBadge').text(currentData.productName + ' (' + currentData.productCode + ')');
                    $('#unitLabel').text(currentData.outputUnit);

                    // 1. QC Gate UI
                    var qcHtml = '';
                    if (currentData.qcGate.isAllowed) {
                        qcHtml = '<div class="text-success"><i class="fas fa-check-circle me-1"></i><strong>معتمد (QC APPROVED)</strong></div>' +
                                 '<small class="text-muted d-block">فحص: ' + (currentData.qcGate.inspectionNumber || 'فحص مطابق') + '</small>';
                    } else {
                        qcHtml = '<div class="text-danger"><i class="fas fa-circle-xmark me-1"></i><strong>' + currentData.qcGate.status + '</strong></div>' +
                                 '<small class="text-danger d-block">' + currentData.qcGate.reason + '</small>';
                    }
                    $('#qcGateContent').html(qcHtml);

                    // 2. Packaging Gate UI
                    var pkgHtml = '';
                    if (!currentData.packagingRequired) {
                        pkgHtml = '<div class="text-success"><i class="fas fa-check me-1"></i><strong>غير مطلوب تعبئة إضافية</strong></div>' +
                                  '<small class="text-muted d-block">منتج خام / تعبئة سائلة مباشرة</small>';
                    } else if (currentData.packagingCompleted) {
                        pkgHtml = '<div class="text-success"><i class="fas fa-check-circle me-1"></i><strong>مكتمل بنجاح</strong></div>' +
                                  '<small class="text-muted d-block">أمر تعبئة: ' + currentData.packagingOrderNumber + ' (' + currentData.actualPackagedQuantity + ' عبوة)</small>';
                    } else {
                        pkgHtml = '<div class="text-danger"><i class="fas fa-clock me-1"></i><strong>غير مكتمل</strong></div>' +
                                  '<small class="text-danger d-block">' + currentData.packagingGateReason + '</small>';
                    }
                    $('#pkgGateContent').html(pkgHtml);

                    // 3. Quantities
                    $('#actualQtyVal').text(currentData.actualOutputQuantity + ' ' + currentData.outputUnit);
                    $('#rejectedQtyVal').text(currentData.rejectedOutputQuantity + ' ' + currentData.outputUnit);
                    $('#releasedQtyVal').text(currentData.alreadyReleasedQuantity + ' ' + currentData.outputUnit);
                    $('#remainingQtyVal').text(currentData.remainingReleaseableQuantity + ' ' + currentData.outputUnit);

                    // 4. Overall Alert & Button State
                    if (currentData.canRelease) {
                        $('#gateAlert')
                            .removeClass('alert-danger')
                            .addClass('alert-success')
                            .html('<i class="fas fa-check-circle me-2"></i><strong>جاهز للإفراج والتخزين:</strong> اجتازت الدفعة كافة اختبارات الجودة والتعبئة وبها كمية متاحة للإفراج.');
                        $('#submitBtn').prop('disabled', false);

                        if (!$('#releaseQtyInput').val() || parseFloat($('#releaseQtyInput').val()) === 0) {
                            $('#releaseQtyInput').val(currentData.remainingReleaseableQuantity);
                        }
                    } else {
                        $('#gateAlert')
                            .removeClass('alert-success')
                            .addClass('alert-danger')
                            .html('<i class="fas fa-ban me-2"></i><strong>محظور من الإفراج:</strong> ' + (currentData.blockingReason || 'لا يمكن الإفراج عن هذه الدفعة.'));
                        $('#submitBtn').prop('disabled', true);
                    }

                    updateCosts();
                });
            }

            function updateCosts() {
                if (!currentData) return;
                var qty = parseFloat($('#releaseQtyInput').val()) || 0;
                var unitCost = currentData.totalUnitCost || 0;
                var totalCost = qty * unitCost;

                $('#unitCostVal').text(unitCost.toFixed(2) + ' ر.س');
                $('#totalCostVal').text(totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ر.س');
            }

            $('#batchSelect').change(function () {
                fetchBatchInfo($(this).val());
            });

            $('#releaseQtyInput').on('input', function () {
                updateCosts();
            });

            $('#fillMaxBtn').click(function () {
                if (currentData && currentData.remainingReleaseableQuantity > 0) {
                    $('#releaseQtyInput').val(currentData.remainingReleaseableQuantity);
                    updateCosts();
                }
            });

            var initialBatch = $('#batchSelect').val();
            if (initialBatch) {
                fetchBatchInfo(initialBatch);
            }
        });
    </script>
}
