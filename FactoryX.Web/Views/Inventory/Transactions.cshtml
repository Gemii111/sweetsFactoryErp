@model IEnumerable<FactoryX.Application.DTOs.InventoryTransactionDto>

@{
    ViewData["Title"] = "حركة المخزون وسجل التدقيق";
    var warehouses = ViewBag.Warehouses as IEnumerable<FactoryX.Application.DTOs.WarehouseDto> ?? new List<FactoryX.Application.DTOs.WarehouseDto>();
    int? selectedWarehouseId = ViewBag.SelectedWarehouseId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-info me-2"></i>حركة المخزون وسجل التدقيق</h2>
        <p class="text-muted mb-0">سجل غير قابل للتعديل يوثق جميع الحركات المخزنية (استلام، صرف، تحويل، تسوية).</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold mb-1">المستودع</label>
                <select name="warehouseId" class="form-select">
                    <option value="">جميع المستودعات</option>
                    @foreach (var wh in warehouses)
                    {
                        <option value="@wh.Id" selected="@(wh.Id == selectedWarehouseId)">@wh.Name (@wh.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold mb-1">نوع الحركة المخزنية</label>
                <select name="transactionType" class="form-select">
                    <option value="">جميع أنواع الحركات</option>
                    <option value="0">استلام مشتريات (PurchaseReceive)</option>
                    <option value="1">صرف للإنتاج (ProductionIssue)</option>
                    <option value="2">استلام إنتاج تام (ProductionReceipt)</option>
                    <option value="3">تحويل بين مستودعات (StockTransfer)</option>
                    <option value="4">تسوية وجرد (StockAdjustment)</option>
                    <option value="5">هالك وتالف (Waste)</option>
                    <option value="6">تسليم مبيعات (SalesShipment)</option>
                    <option value="7">مرتجع مبيعات (SalesReturn)</option>
                    <option value="8">مرتجع مشتريات (PurchaseReturn)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary px-4 ms-2"><i class="bi bi-filter me-1"></i>تصفية السجل</button>
                <a asp-action="Transactions" class="btn btn-light"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">التاريخ والوقت</th>
                        <th>رقم المرجع / الإذن</th>
                        <th>نوع الحركة</th>
                        <th>اسم الصنف</th>
                        <th>المستودع</th>
                        <th>رقم التشغيلة</th>
                        <th>الكمية</th>
                        <th class="pe-4">المستخدم والملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                لا توجد حركات مخزنية مسجلة حتى الآن.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-nowrap"><small class="text-muted">@item.TransactionDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                <td><code class="fw-bold text-primary">@item.ReferenceDocumentNumber</code></td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-1">
                                        <i class="bi bi-activity me-1"></i>@item.TransactionTypeName
                                    </span>
                                </td>
                                <td class="fw-bold">@item.ItemName</td>
                                <td><span class="badge bg-light text-dark border">@item.WarehouseName</span></td>
                                <td><code>@(string.IsNullOrEmpty(item.BatchNumber) ? "بدون" : item.BatchNumber)</code></td>
                                <td class="fw-bold fs-6 @(item.Quantity >= 0 ? "text-success" : "text-danger")">
                                    @(item.Quantity >= 0 ? "+" : "")@item.Quantity.ToString("N2") <small class="text-muted">@item.Unit</small>
                                </td>
                                <td class="pe-4">
                                    <div class="small fw-semibold">@item.UserName</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Notes</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
