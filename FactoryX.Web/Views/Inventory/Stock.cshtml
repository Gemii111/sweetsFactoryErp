@model IEnumerable<FactoryX.Application.DTOs.StockBalanceDto>

@{
    ViewData["Title"] = "أرصدة المخزون اللحظية";
    var warehouses = ViewBag.Warehouses as IEnumerable<FactoryX.Application.DTOs.WarehouseDto> ?? new List<FactoryX.Application.DTOs.WarehouseDto>();
    var locations = ViewBag.Locations as IEnumerable<FactoryX.Application.DTOs.WarehouseLocationDto> ?? new List<FactoryX.Application.DTOs.WarehouseLocationDto>();
    int? selectedWarehouseId = ViewBag.SelectedWarehouseId;
    int? selectedLocationId = ViewBag.SelectedLocationId;
    string? batchNumber = ViewBag.BatchNumber;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>أرصدة المخزون اللحظية</h2>
        <p class="text-muted mb-0">عرض الكميات الحالية لكل صنف حسب المستودع، الرف، رقم التشغيلة، وتاريخ الصلاحية.</p>
    </div>
    <div class="gap-2">
        <a asp-action="Transfer" class="btn btn-outline-primary shadow-sm ms-2"><i class="bi bi-arrow-left-right me-1"></i>تحويل مخزني</a>
        <a asp-action="Adjust" class="btn btn-primary shadow-sm"><i class="bi bi-sliders me-1"></i>تسوية وجرد مخزني</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold mb-1">المستودع</label>
                <select name="warehouseId" class="form-select">
                    <option value="">جميع المستودعات</option>
                    @foreach (var wh in warehouses)
                    {
                        <option value="@wh.Id" selected="@(wh.Id == selectedWarehouseId)">@wh.Name (@wh.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted fw-semibold mb-1">رقم التشغيلة / الباتش (Batch)</label>
                <input type="text" name="batchNumber" value="@batchNumber" class="form-control" placeholder="بحث برقم التشغيلة..." />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary px-4 ms-2"><i class="bi bi-search me-1"></i>بحث في الأرصدة</button>
                <a asp-action="Stock" class="btn btn-light"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">كود الصنف</th>
                        <th>اسم الصنف / المادة</th>
                        <th>المستودع</th>
                        <th>مكان التخزين / الرف</th>
                        <th>رقم التشغيلة (Batch)</th>
                        <th>الكمية المتاحة</th>
                        <th>تاريخ الصلاحية</th>
                        <th class="text-end pe-4">حالة الصلاحية</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                لا توجد أرصدة مخزنية مطابقة لمعايير البحث الحالية.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var isExpiring = item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.UtcNow.AddDays(30);
                            var isExpired = item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.UtcNow;

                            <tr>
                                <td class="ps-4 fw-semibold text-primary">@item.ItemCode</td>
                                <td class="fw-bold">@item.ItemName</td>
                                <td><span class="badge bg-light text-dark border"><i class="bi bi-buildings me-1"></i>@item.WarehouseName</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(item.LocationName) ? "افتراضي" : item.LocationName)</span></td>
                                <td><code class="fw-bold text-dark">@(string.IsNullOrEmpty(item.BatchNumber) ? "بدون" : item.BatchNumber)</code></td>
                                <td class="fw-bold text-success fs-6">@item.Quantity.ToString("N2") <small class="text-muted">@item.Unit</small></td>
                                <td>
                                    @if (item.ExpiryDate.HasValue)
                                    {
                                        <span class="@(isExpired ? "text-danger fw-bold" : isExpiring ? "text-warning fw-bold" : "")">
                                            @item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1">منتهي الصلاحية</span>
                                    }
                                    else if (isExpiring)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1">أوشك على الانتهاء</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">صالح وجيد</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
