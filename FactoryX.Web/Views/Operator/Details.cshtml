@model FactoryX.Application.DTOs.Responses.OperatorResponses.GetOperatorResponse
@{
    ViewData["Title"] = "تفاصيل المشغل";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-center text-info"><i class="bi bi-person-badge me-2"></i>تفاصيل بيانات المشغل</h3>
                    <dl class="row mb-4">
                        <dt class="col-5 text-muted">الاسم الكامل</dt>
                        <dd class="col-7 fw-bold">@Model.Name</dd>
                        <dt class="col-5 text-muted">الرقم الوظيفي</dt>
                        <dd class="col-7"><span class="badge bg-light text-dark border px-3 py-1">@Model.EmployeeNumber</span></dd>
                    </dl>
                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill"><i class="bi bi-arrow-right"></i> عودة للقائمة</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 rounded-pill shadow-sm"><i class="bi bi-pencil"></i> تعديل</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>