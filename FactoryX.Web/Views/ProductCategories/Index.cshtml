@model IEnumerable<FactoryX.Application.DTOs.ProductCategoryDto>
@{
    ViewData["Title"] = "تصنيفات المنتجات التامة";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
}

<div class="container-fluid py-4" dir="rtl">
    @await Html.PartialAsync("_Alert")

    <!-- رأس الصفحة -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-tags-fill text-primary me-2"></i>تصنيفات المنتجات التامة
            </h2>
            <p class="text-muted mb-0">إدارة عائلات وتصنيفات منتجات حلويات المولد (السمسمية، الفولية، الحمصية، الملبن، النوجا، العلب المشكلة...).</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                <i class="bi bi-box-seam me-1"></i> قائمة المنتجات
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد
            </a>
        </div>
    </div>

    <!-- كروت الإحصائيات -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">إجمالي التصنيفات</span>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.Count()</h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle p-3 text-primary">
                        <i class="bi bi-grid-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">التصنيفات النشطة</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@Model.Count(c => c.IsActive)</h3>
                    </div>
                    <div class="rounded-circle bg-success-subtle p-3 text-success">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 border-start border-info border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">إجمالي الأصناف المرتبطة</span>
                        <h3 class="fw-bold text-info mb-0 mt-1">@Model.Sum(c => c.ProductCount)</h3>
                    </div>
                    <div class="rounded-circle bg-info-subtle p-3 text-info">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- شريط البحث والفلترة -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-0" placeholder="بحث بالاسم أو الكود أو الوصف..." value="@search" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="isActive" class="form-select bg-light border-0">
                        <option value="">جميع الحالات</option>
                        <option value="true" selected="@(isActive == true ? "selected" : null)">نشط فقط</option>
                        <option value="false" selected="@(isActive == false ? "selected" : null)">معطل فقط</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark rounded-pill w-100"><i class="bi bi-funnel me-1"></i> تصفية</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- جدول البيانات -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-secondary">الكود</th>
                        <th class="py-3 px-4 text-secondary">اسم التصنيف</th>
                        <th class="py-3 px-4 text-secondary">الاسم العربي</th>
                        <th class="py-3 px-4 text-secondary">الوصف</th>
                        <th class="py-3 px-4 text-secondary text-center">عدد المنتجات</th>
                        <th class="py-3 px-4 text-secondary text-center">الحالة</th>
                        <th class="py-3 px-4 text-secondary text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                لا توجد تصنيفات مطابقة لمعايير البحث.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-primary font-monospace">@item.Code</td>
                                <td class="px-4 fw-semibold text-dark">@item.Name</td>
                                <td class="px-4 text-muted">@(string.IsNullOrEmpty(item.ArabicName) ? "-" : item.ArabicName)</td>
                                <td class="px-4 text-muted small">@(string.IsNullOrEmpty(item.Description) ? "بدون وصف" : item.Description)</td>
                                <td class="px-4 text-center">
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">
                                        @item.ProductCount منتج
                                    </span>
                                </td>
                                <td class="px-4 text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i> نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i> معطل
                                        </span>
                                    }
                                </td>
                                <td class="px-4 text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-circle shadow-none" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Details" asp-route-id="@item.Id">
                                                    <i class="bi bi-eye text-primary me-2"></i> عرض التفاصيل
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id">
                                                    <i class="bi bi-pencil text-warning me-2"></i> تعديل
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item py-2">
                                                        @if (item.IsActive)
                                                        {
                                                            <span><i class="bi bi-slash-circle text-secondary me-2"></i> تعطيل</span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-check2-circle text-success me-2"></i> تنشيط</span>
                                                        }
                                                    </button>
                                                </form>
                                            </li>
                                            @if (item.ProductCount == 0)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذا التصنيف نهائياً؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                                            <i class="bi bi-trash me-2"></i> حذف التصنيف
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
