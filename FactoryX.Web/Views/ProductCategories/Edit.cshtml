@model FactoryX.Application.DTOs.UpdateProductCategoryRequest
@{
    ViewData["Title"] = "تعديل تصنيف المنتجات";
}

<div class="container py-4" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold text-dark mb-1">
                                <i class="bi bi-pencil-square text-warning me-2"></i>تعديل تصنيف المنتج
                            </h4>
                            <p class="text-muted small mb-0">تحديث بيانات التصنيف والحالة التشغيلية.</p>
                        </div>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-3">
                            <i class="bi bi-arrow-right me-1"></i> عودة للتصنيفات
                        </a>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Code" class="form-label fw-semibold text-secondary">كود التصنيف <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-1"><i class="bi bi-qr-code text-muted"></i></span>
                                    <input asp-for="Code" class="form-control font-monospace" required />
                                </div>
                                <span asp-validation-for="Code" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold text-secondary">اسم التصنيف (English / الأساسي) <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="ArabicName" class="form-label fw-semibold text-secondary">الاسم العربي للتصنيف</label>
                                <input asp-for="ArabicName" class="form-control" />
                                <span asp-validation-for="ArabicName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold text-secondary">الوصف</label>
                                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                                    <label class="form-check-label fw-semibold text-secondary" for="IsActive">حالة التنشيط:</label>
                                    <input class="form-check-input ms-0" type="checkbox" role="switch" asp-for="IsActive" id="IsActive" style="width: 2.5em; height: 1.3em;">
                                    <span class="text-muted small">تفعيل أو إيقاف التصنيف لمنتجات جديدة</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-5 shadow-sm text-dark fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
