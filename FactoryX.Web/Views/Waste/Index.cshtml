@model IEnumerable<FactoryX.Application.DTOs.WasteDto>
@using FactoryX.Domain.Entities

@{
    ViewData["Title"] = "سجل الهوالك والمرفوضات";
    var summary = ViewBag.Summary as FactoryX.Application.DTOs.WasteSummaryDto;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-primary">
                <i class="bi bi-trash3-fill me-2"></i> سجل الهوالك ومرفوضات الإنتاج
            </h2>
            <p class="text-muted mb-0">إدارة وتتبع هالك الخامات، فاقد مراحل التشغيل، ومرفوضات دفعات الإنتاج التام وحساب التكاليف</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="WasteReasons" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-tags me-1"></i> دليل أسباب الهالك
            </a>
            <div class="dropdown">
                <button class="btn btn-primary shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-plus-circle me-1"></i> تسجيل هالك جديد
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li>
                        <a class="dropdown-item py-2" asp-action="Create" asp-route-type="RawMaterialWaste">
                            <i class="bi bi-box-seam me-2 text-warning"></i> هالك مواد خام (مستودع / تشغيل)
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" asp-action="Create" asp-route-type="ProductionProcessWaste">
                            <i class="bi bi-fire me-2 text-danger"></i> هالك مراحل التشغيل والقدور
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" asp-action="Create" asp-route-type="OutputRejection">
                            <i class="bi bi-x-octagon me-2 text-primary"></i> مرفوضات الإنتاج التام
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Summary Cards -->
    @if (summary != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 bg-primary text-white p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small">إجمالي قيمة الهالك المعتمد</div>
                            <div class="fs-3 fw-bold">@summary.TotalWasteCost.ToString("N2") <small class="fs-6">ج.م</small></div>
                            <small class="text-white-50">@summary.ApprovedCount سجل معتمد</small>
                        </div>
                        <div class="bg-white bg-opacity-25 p-3 rounded-circle">
                            <i class="bi bi-currency-dollar fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">قيد المراجعة والاعتماد</div>
                            <div class="fs-3 fw-bold text-warning">@summary.PendingApprovalsCount</div>
                            <small class="text-muted">سجلات تتطلب مراجعة واعتماد</small>
                        </div>
                        <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                            <i class="bi bi-hourglass-split fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">هالك المواد الخام</div>
                            <div class="fs-3 fw-bold text-danger">@summary.RawMaterialWasteCost.ToString("N2") <small class="fs-6">ج.م</small></div>
                            <small class="text-muted">تكلفة خامات مسقطة من المخزون</small>
                        </div>
                        <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                            <i class="bi bi-box-seam fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">مرفوضات الإنتاج التام</div>
                            <div class="fs-3 fw-bold text-info">@summary.OutputRejectionCost.ToString("N2") <small class="fs-6">ج.م</small></div>
                            <small class="text-muted">قيمة مخرجات تصنيع غير مطابقة</small>
                        </div>
                        <div class="bg-info-subtle text-info p-3 rounded-circle">
                            <i class="bi bi-x-octagon fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="بحث بالرقم أو الخامة أو المنتج أو الدفعة..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="col-md-2">
                    <select name="wasteType" class="form-select form-select-sm">
                        <option value="">-- كل أنواع الهالك --</option>
                        <option value="RawMaterialWaste" selected="@(ViewBag.SelectedType?.ToString() == "RawMaterialWaste")">هالك مواد خام</option>
                        <option value="ProductionProcessWaste" selected="@(ViewBag.SelectedType?.ToString() == "ProductionProcessWaste")">هالك مراحل التشغيل</option>
                        <option value="OutputRejection" selected="@(ViewBag.SelectedType?.ToString() == "OutputRejection")">مرفوضات الإنتاج التام</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- كل الحالات --</option>
                        <option value="Draft" selected="@(ViewBag.SelectedStatus?.ToString() == "Draft")">مسودة (Draft)</option>
                        <option value="PendingApproval" selected="@(ViewBag.SelectedStatus?.ToString() == "PendingApproval")">معلق للاعتماد (Pending)</option>
                        <option value="Approved" selected="@(ViewBag.SelectedStatus?.ToString() == "Approved")">معتمد (Approved)</option>
                        <option value="Rejected" selected="@(ViewBag.SelectedStatus?.ToString() == "Rejected")">مرفوض (Rejected)</option>
                        <option value="Cancelled" selected="@(ViewBag.SelectedStatus?.ToString() == "Cancelled")">ملغى (Cancelled)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" title="من تاريخ" />
                </div>
                <div class="col-md-2">
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" title="إلى تاريخ" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
                    <a asp-action="Index" class="btn btn-light btn-sm" title="إعادة تعيين"><i class="bi bi-arrow-clockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">رقم الهالك</th>
                        <th>النوع</th>
                        <th>البيان (الخامة / المنتج / الدفعة)</th>
                        <th>السبب</th>
                        <th>الكمية</th>
                        <th>إجمالي التكلفة</th>
                        <th>تاريخ الهالك</th>
                        <th class="text-center">الحالة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                                لا توجد سجلات هالك مطابقة لمعايير البحث
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold font-monospace text-primary text-decoration-none">
                                        @item.WasteNumber
                                    </a>
                                </td>
                                <td>
                                    @if (item.WasteType == WasteType.RawMaterialWaste)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-box-seam me-1"></i> خامات
                                        </span>
                                    }
                                    else if (item.WasteType == WasteType.ProductionProcessWaste)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-fire me-1"></i> تشغيل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="bi bi-x-octagon me-1"></i> مرفوضات إنتاج
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.WasteType == WasteType.RawMaterialWaste)
                                    {
                                        <div class="fw-bold text-dark">@(item.MaterialName ?? "خامة غير محددة")</div>
                                        @if (!string.IsNullOrEmpty(item.RawMaterialBatchNumber))
                                        {
                                            <small class="text-muted font-monospace"><i class="bi bi-upc me-1"></i>Lot: @item.RawMaterialBatchNumber</small>
                                        }
                                    }
                                    else if (item.WasteType == WasteType.ProductionProcessWaste)
                                    {
                                        <div class="fw-bold text-dark">@(item.MaterialName ?? item.ProductName ?? "فاقد تشغيل")</div>
                                        @if (!string.IsNullOrEmpty(item.ProductionBatchNumber))
                                        {
                                            <small class="text-primary font-monospace"><i class="bi bi-layers me-1"></i>دفعة: @item.ProductionBatchNumber</small>
                                        }
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark">@(item.ProductName ?? "منتج تام")</div>
                                        @if (!string.IsNullOrEmpty(item.ProductionBatchNumber))
                                        {
                                            <small class="text-primary font-monospace"><i class="bi bi-layers me-1"></i>دفعة: @item.ProductionBatchNumber</small>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.WasteReasonName ?? item.ReasonDescription)
                                    </span>
                                </td>
                                <td class="fw-bold">
                                    @item.Quantity.ToString("N2") <small class="text-muted">@item.Unit</small>
                                </td>
                                <td class="fw-bold text-danger">
                                    @item.TotalCost.ToString("N2") <small class="text-muted">ج.م</small>
                                </td>
                                <td class="text-muted small">
                                    @item.WasteDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-center">
                                    @if (item.Status == WasteStatus.Draft)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">
                                            <i class="bi bi-pencil me-1"></i> مسودة
                                        </span>
                                    }
                                    else if (item.Status == WasteStatus.PendingApproval)
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i> معلق للاعتماد
                                        </span>
                                    }
                                    else if (item.Status == WasteStatus.Approved)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i> معتمد
                                        </span>
                                    }
                                    else if (item.Status == WasteStatus.Rejected)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i> مرفوض
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark-subtle text-dark rounded-pill px-3 py-1">
                                            <i class="bi bi-slash-circle me-1"></i> ملغى
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="عرض التفاصيل">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (item.Status == WasteStatus.Draft)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="تعديل">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Submit" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="تقديم للاعتماد" onclick="return confirm('هل تريد تقديم هذا السجل للاعتماد؟');">
                                                    <i class="bi bi-send"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (item.Status == WasteStatus.PendingApproval)
                                        {
                                            <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-warning" title="مراجعة واعتماد">
                                                <i class="bi bi-shield-check"></i> اعتماد
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
