@model IEnumerable<FactoryX.Application.DTOs.GeneralLedgerAccountDto>
@{
    ViewData["Title"] = "دفتر الأستاذ العام (General Ledger)";
    var accounts = ViewBag.Accounts as IEnumerable<FactoryX.Application.DTOs.AccountDto> ?? new List<FactoryX.Application.DTOs.AccountDto>();
    var query = ViewBag.Query as FactoryX.Application.DTOs.GeneralLedgerQueryDto ?? new FactoryX.Application.DTOs.GeneralLedgerQueryDto();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>دفتر الأستاذ العام (General Ledger)</h2>
        <p class="text-muted mb-0">كشف حركات الحسابات المالية، الأرصدة الافتتاحية، والرصيد التراكمي المتحرك</p>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold mb-1">الحساب المالي</label>
                <select name="AccountId" class="form-select form-select-sm">
                    <option value="">-- جميع الحسابات ذات الحركة --</option>
                    @foreach (var acc in accounts.Where(a => !a.IsControlAccount))
                    {
                        <option value="@acc.Id" selected="@(acc.Id == query.AccountId)">@acc.AccountCode - @acc.AccountNameAr (@acc.AccountTypeName)</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">نوع الحساب</label>
                <select name="AccountType" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<FactoryX.Domain.Entities.AccountType>()">
                    <option value="">-- كافة الأنواع --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">من تاريخ</label>
                <input type="date" name="FromDate" value="@query.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">إلى تاريخ</label>
                <input type="date" name="ToDate" value="@query.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter"></i> عرض كشف الحساب</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 py-5 text-center text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        <h5>لا توجد حركات أو قيود مسجلة للحساب المحدد في هذه الفترة</h5>
    </div>
}
else
{
    @foreach (var acc in Model)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light py-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary font-monospace fs-6 me-2">@acc.AccountCode</span>
                        <span class="fw-bold fs-5 text-dark">@acc.AccountNameAr</span>
                        <span class="text-muted ms-2">(@acc.AccountName)</span>
                        <span class="badge bg-secondary-subtle text-dark border ms-2">@acc.AccountType</span>
                    </div>
                    <div>
                        <span class="text-muted me-2">الرصيد الافتتاحي:</span>
                        <span class="font-monospace fw-bold @(acc.OpeningBalance >= 0 ? "text-dark" : "text-danger")">
                            @acc.OpeningBalance.ToString("N2") EGP
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">التاريخ</th>
                                <th>رقم القيد</th>
                                <th>البيان والشرح</th>
                                <th>المستند المرجعي</th>
                                <th>الطرف الفرعي</th>
                                <th class="text-end">مدين (Debit)</th>
                                <th class="text-end">دائن (Credit)</th>
                                <th class="text-end pe-3">الرصيد التراكمي (Balance)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Opening Balance Row -->
                            <tr class="table-secondary">
                                <td colspan="7" class="ps-3 fw-bold">الرصيد الافتتاحي ما قبل الفترة المحددة:</td>
                                <td class="text-end pe-3 font-monospace fw-bold">@acc.OpeningBalance.ToString("N2")</td>
                            </tr>

                            @foreach (var row in acc.Rows)
                            {
                                <tr>
                                    <td class="ps-3">@row.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="font-monospace fw-bold">
                                        <a asp-controller="JournalEntries" asp-action="Details" asp-route-id="@row.JournalEntryId" class="text-decoration-none">
                                            @row.JournalNumber
                                        </a>
                                    </td>
                                    <td>@row.Description</td>
                                    <td>@(row.ReferenceDocumentNumber ?? "-")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(row.CustomerName)) { <span class="badge bg-primary-subtle text-primary">@row.CustomerName</span> }
                                        @if (!string.IsNullOrEmpty(row.SupplierName)) { <span class="badge bg-warning-subtle text-dark">@row.SupplierName</span> }
                                    </td>
                                    <td class="text-end font-monospace fw-bold @(row.Debit > 0 ? "text-success" : "text-muted")">
                                        @(row.Debit > 0 ? row.Debit.ToString("N2") : "-")
                                    </td>
                                    <td class="text-end font-monospace fw-bold @(row.Credit > 0 ? "text-danger" : "text-muted")">
                                        @(row.Credit > 0 ? row.Credit.ToString("N2") : "-")
                                    </td>
                                    <td class="text-end font-monospace fw-bold pe-3 @(row.RunningBalance >= 0 ? "text-dark" : "text-danger")">
                                        @row.RunningBalance.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold font-monospace">
                            <tr>
                                <td colspan="5" class="text-end ps-3">إجمالي حركات الفترة والرصيد الختامي:</td>
                                <td class="text-end text-success">@acc.TotalDebit.ToString("N2")</td>
                                <td class="text-end text-danger">@acc.TotalCredit.ToString("N2")</td>
                                <td class="text-end pe-3 fs-6 @(acc.ClosingBalance >= 0 ? "text-primary" : "text-danger")">
                                    @acc.ClosingBalance.ToString("N2") EGP
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
}
